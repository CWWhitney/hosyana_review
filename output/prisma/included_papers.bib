@Phdthesis{patil_stochastic_2019,
  AUTHOR = {Patil, Kishor},
  NOTE = {ISBN: 9789463552806},
  SCHOOL = {Ghent University},
  TITLE = {Stochastic modelling of wireless sensor networks},
  TYPE = {dissertation},
  YEAR = {2019},
  FILE = {Full Text PDF:/Users/corywhitney/Zotero/storage/NMKHP8FX/Patil - 2019 - Stochastic modelling of wireless sensor networks.pdf:application/pdf},
  LANGUAGE = {eng},
  ABSTRACT = {Draadloze sensornetwerken (Eng.: Wireless sensor networks, WSNs) opereren veelal in een dynamische omgeving waar fysieke processen zeer complex en onvoorspelbaar zijn. De willekeurige aard van deze processen heeft een aanzienlijke invloed op de prestaties van het netwerk en daarom is het belangrijk om ze nauwkeurig te modelleren. In dit proefschrift onderzoeken we de prestatie van een draadloos sensornetwerk via verschillende stochastische modellen. Deze evaluatie speelt een cruciale rol in het ontwerp van om een succesvolle implementatie en werking te garanderen. In het bijzonder is het nuttig om het stationair gedrag van het netwerk te analyseren en ook om de effecten van verschillende netwerkparameters op de prestaties van het systeem te onderzoeken. We onderscheiden drie hoofddoelstellingen. Het eerste doel behandelt de stochastische modellen voor een afzonderlijke sensorknoop dat de interactie tussen gegevensverzameling, energieoogst en energieverbruik bestudeert. Het tweede doel omvat het modelleren van het netwerk waarbij een groot aantal knopen met elkaar communiceren om de informatie door te geven aan een speciale eindknoop in meerdere hops. Ten slotte onderzoeken we ook de prestaties van een populair routeringsprotocol in onderwater draadloos sensornetwerk door een numeriek oplosbaar stochastisch model te ontwikkelen.},
