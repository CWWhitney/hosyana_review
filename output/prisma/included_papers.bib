@Misc{love-koh_economic_2019,
  AUTHOR = {Love-Koh, James and Walker, Simon Mark and Kataika, Edward and Sibandze, Sibusiso and Arnold, Matthias and Ochalek, Jessica Marie and Griffin, Susan and Revill, Paul and Sculpher, Mark John},
