@Article{goddardBuildingEvidenceBase2012,
  ANNOTE = {Export Date: 05 May 2024; Cited By: 30},
  AUTHOR = {Goddard, Katrina A. B. and Knaus, William A. and Whitlock, Evelyn and Lyman, Gary H. and Feigelson, Heather Spencer and Schully, Sheri D. and Ramsey, Scott and Tunis, Sean and Freedman, Andrew N. and Khoury, Muin J. and Veenstra, David L.},
  JOURNAL = {Genetics in Medicine},
  MONTH = {},
