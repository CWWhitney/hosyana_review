  MANUAL_CLASSIFICATION = {unclassified},
  MANUAL_REASON = {not_reviewed},
  TITLE_CLEAN = {a costeffectiveness analysis of a preventive exercise program for patients with advanced head and neck cancer treated with concomitant chemoradiotherapy},
  IS_DUPLICATE = {FALSE},
