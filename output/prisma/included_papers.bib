@Article{powell_dealing_nodate,
  AUTHOR = {Powell, Thomas and Oggero, Serena and Westerveld, Joris and Schook, Emma},
  TITLE = {Dealing with {Uncertainty} in {Hybrid} {Conflict}: {A} {Novel} {Approach} and {Model} for {Uncertainty} {Quantification} in {Intelligence} {Analysis}},
  FILE = {Powell et al. - Dealing with Uncertainty in Hybrid Conflict A Nov.pdf:/Users/corywhitney/Zotero/storage/FM9ABWAR/Powell et al. - Dealing with Uncertainty in Hybrid Conflict A Nov.pdf:application/pdf},
  LANGUAGE = {en},
  ABSTRACT = {Uncertainty is a central concept in hybrid conflict. Much of hybrid conflict is covert, deniable in nature, and conducted in the grey zone between normal state-to-state relations and armed conflict. Moreover, signals of hybrid conflict can arise from a vast multiplicity of open and covert sources collected over an extended period of time, and possessing different levels of reliability. Together, these factors pose a major challenge for decision-making in hybrid conflict: Dealing with elevated levels of uncertainty demands innovative solutions in intelligence analysis and assessment. A promising approach in this regard is the explicit estimation of uncertainty. In this research, we drew on knowledge of statistics, intelligence analysis and AI to propose a novel approach and develop a statistical model for the quantification and systematic estimation of uncertainty. The model accounted for several important elements of uncertainty in intelligence analysis: source reliability, information credibility, probability language, and timeliness. We tested our approach using labelled and simulated data and discussed the opportunities and challenges for automating this process using AI and data science. By doing so, this research takes a step towards intelligent analytical tooling that mitigates the challenges of uncertainty in decision-making for hybrid conflict.},
  HAS_ANNOTATION = {FALSE},
