@Article{maitri_thakur_report_2020,
  ANNOTE = {},
  AUTHOR = {{Maitri Thakur} and Johansen, Ulf and Jafarzadeh, Sepideh and {Lukas Cechura,} and Rumankova, Lenka and Kroupova, Zdenka Zakova and {Tinoush Jamali Jaghdani} and Loveluck, William and Mehta, Shraddha and Aditjandra, Paulus and Gresham, Jennifer and {Antonella Samoggia,} and Olafsdottir, Gudrun and Gudbrandsdottir, Ingunn and Schan, Christian Schiahorng and Sjoberg, Ivan and Richardsen, Roger and Haug, Kaja},
  MONTH = {},
