@Article{glinska-newes_managing_2020,
  AUTHOR = {Glińska-Neweś, Aldona and Escher, Iwona and Józefowicz, Barbara and Łuka, Alicja},
  JOURNAL = {Journal of Organizational Change Management},
  MONTH = {},
  NOTE = {Publisher: Emerald Publishing Limited},
