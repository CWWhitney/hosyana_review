@Article{kivijarvi_supporting_2012,
  ANNOTE = {Export Date: 05 May 2024; Cited By: 11},
  AUTHOR = {Kivijärvi, Hannu and Hallikainen, Petri and Penttinen, Esko},
  JOURNAL = {International Journal of Information Technology \& Decision Making},
  MONTH = {},
  NUMBER = {03},
  PAGES = {525--550},
  TITLE = {{SUPPORTING} {IT} {IMPLEMENTATION} {DECISIONS} {WITH} {ANP} — {SUPPLIER} {SCHEDULING} {FOR} e-{INVOICING}},
  VOLUME = {11},
  YEAR = {2012},
  FILE = {Kivijärvi et al. - 2012 - SUPPORTING IT IMPLEMENTATION DECISIONS WITH ANP — .pdf:/Users/corywhitney/Zotero/storage/CP27AFQV/Kivijärvi et al. - 2012 - SUPPORTING IT IMPLEMENTATION DECISIONS WITH ANP — .pdf:application/pdf},
  LANGUAGE = {en},
  ABSTRACT = {Companies aim to make their supply chains more efficient by using modern information technology (IT). Owing to limited resources there is a need to prioritize IT projects and those generating the highest business value should be implemented first. In this paper, we first develop the theoretical foundations for the prioritization decision and then implement the theoretical principles by applying the ANP (analytic network process) approach. A model is developed to aid a buyer company in selecting prioritized suppliers for adopting electronic invoicing. The case company is a leading Finnish textile and clothing design company. The ANP approach is considered suitable for this type of decision problem with many interconnected decision-making criteria. As the result of the analysis, the prioritized suppliers, representing different supplier types in the case company, are determined. The results can be applied to schedule e-invoicing implementation projects among the supplier companies. Based on the case study it can be concluded that the theoretical principles and the ANP approach can also be applied to other IT implementation decisions concerning supply chain efficiency.},
  URL = {https://www.worldscientific.com/doi/abs/10.1142/S0219622012500101},
  URLDATE = {2023-10-16},
  ISSN = {0219-6220, 1793-6845},
  DOI = {10.1142/S0219622012500101},
  HAS_ANNOTATION = {TRUE},
  ANNOTATION_TEXT = {Export Date: 05 May 2024; Cited By: 11},
  FULL_TEXT = {{SUPPORTING} {IT} {IMPLEMENTATION} {DECISIONS} {WITH} {ANP} — {SUPPLIER} {SCHEDULING} {FOR} e-{INVOICING} Export Date: 05 May 2024; Cited By: 11},
