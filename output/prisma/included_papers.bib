  TITLE_CLEAN = {information sharing in supply chains a review of risks and opportunities using the systematic literature network analysis slna},
  IS_DUPLICATE = {FALSE},
  IS_DOI_DUPLICATE = {FALSE},
  DUPLICATE_STATUS = {unique},
  MANUAL_DECISION = {unreviewed},
  EXCLUDE_DOC_TYPE = {FALSE},
  EXCLUDE_CONTENT = {FALSE},
