  VOLUME = {137},
  YEAR = {2017},
  FILE = {Full Text:/Users/corywhitney/Zotero/storage/97TYR6CT/S0921800916310734.html:text/html;Full Text:/Users/corywhitney/Zotero/storage/Z85HI6JJ/Johnson et al. - 2017 - Expert Elicitation, Uncertainty, and the Value of .pdf:application/pdf;Johnson et al. - 2017 - Expert Elicitation, Uncertainty, and the Value of:/Users/corywhitney/Zotero/storage/VN6V8JU5/Johnson et al. - 2017 - Expert Elicitation, Uncertainty, and the Value of .pdf:application/pdf;S0921800916310734:/Users/corywhitney/Zotero/storage/4ER2NQ9V/S0921800916310734.html:text/html},
  ANNOTE.1 = {Publisher: Elsevier},
  KEYWORDS = {Value of information, Stochastic dominance},
  LANGUAGE = {english},
  ABSTRACT = {We illustrate the utility of expert elicitation, explicit recognition of uncertainty, and the value of information for directing management and research efforts for invasive species, using tegu lizards (Salvator merianae) in southern Florida as a case study. We posited a post-birth pulse, matrix model in which four age classes of tegus are recognized: hatchlings, 1year-old, 2year-olds, and 3+year-olds. This matrix model was parameterized using a 3-point process to elicit estimates of tegu demographic rates in southern Florida from 10 herpetology experts. We fit statistical distributions for each parameter and for each expert, then drew and pooled a large number of replicate samples from these to form a distribution for each demographic parameter. Using these distributions, as well as the observed correlations among elicited values, we generated a large sample of matrix population models to infer how the tegu population would respond to control efforts. We used the concepts of Pareto efficiency and stochastic dominance to conclude that targeting older age classes at relatively high rates appears to have the best chance of minimizing tegu abundance and control costs. We conclude that expert opinion combined with an explicit consideration of uncertainty can be valuable in conducting an initial assessment of what control strategy, effort, and monetary resources are needed to reduce and eventually eliminate the invader. Scientists, in turn, can use the value of information to focus research in a way that not only increases the efficacy of control, but minimizes costs as well.},
  URL = {https://www.sciencedirect.com/science/article/pii/S0921800916310734},
  URLDATE = {2022-12-09},
