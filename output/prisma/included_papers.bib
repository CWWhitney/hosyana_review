  AUTHOR = {Li, Lu and Peter, Richard},
  MONTH = {},
  TITLE = {Should {We} {Do} {More} {When} {We} {Know} {Less}?: {Optimal} {Risk} {Mitigation} {Under} {Technological} {Uncertainty}},
  TYPE = {{SSRN} {Scholarly} {Paper}},
