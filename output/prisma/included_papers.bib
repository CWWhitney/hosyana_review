@Article{miller_carbon_2014,
  AUTHOR = {Miller, David C. and Syamlal, Madhava and Mebane, David S. and Storlie, Curt and Bhattacharyya, Debangsu and Sahinidis, Nikolaos V. and Agarwal, Deb and Tong, Charles and Zitney, Stephen E. and Sarkar, Avik and Sun, Xin and Sundaresan, Sankaran and Ryan, Emily and Engel, Dave and Dale, Crystal},
  JOURNAL = {Annual Review of Chemical and Biomolecular Engineering},
