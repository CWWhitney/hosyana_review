@Article{chan_psychological_2017,
  AUTHOR = {Chan, S.t. and Khong, P.c.b. and Wang, W.},
  JOURNAL = {International Nursing Review},
  NOTE = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/inr.12317},
