@Article{stevensonMethodsHandlingUncertainty2014b,
  ANNOTE = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1080/00207721.2012.723056},
  AUTHOR = {Stevenson, Matt and Tappenden, Paul and Squires, Hazel},
  JOURNAL = {International Journal of Systems Science},
  MONTH = {},
  NOTE = {Publisher: Taylor \& Francis},
  NUMBER = {1},
  PAGES = {60--68},
  TITLE = {Methods for handling uncertainty within pharmaceutical funding decisions},
  VOLUME = {45},
  YEAR = {2014},
  FILE = {Stevenson et al. - 2014 - Methods for handling uncertainty within pharmaceut:/Users/corywhitney/Zotero/storage/7F739YIV/Stevenson et al. - 2014 - Methods for handling uncertainty within pharmaceut.pdf:application/pdf},
  KEYWORDS = {mathematical modelling, uncertain data},
  ABSTRACT = {This article provides a position statement regarding decision making under uncertainty within the economic evaluation of pharmaceuticals, with a particular focus upon the National Institute for Health and Clinical Excellence context within England and Wales. This area is of importance as funding agencies have a finite budget from which to purchase a selection of competing health care interventions. The objective function generally used is that of maximising societal health with an explicit acknowledgement that there will be opportunity costs associated with purchasing a particular intervention. Three components of uncertainty are discussed within a pharmaceutical funding perspective: methodological uncertainty, parameter uncertainty and structural uncertainty, alongside a discussion of challenges that are particularly pertinent to health economic evaluation. The discipline has focused primarily on handling methodological and parameter uncertainty and a clear reference case has been developed for consistency across evaluations. However, uncertainties still remain. Less attention has been given to methods for handling structural uncertainty. The lack of adequate methods to explicitly incorporate this aspect of model development may result in the true uncertainty surrounding health care investment decisions being underestimated. Research in this area is ongoing as we review.},
  URL = {https://doi.org/10.1080/00207721.2012.723056},
  URLDATE = {2023-05-25},
  ISSN = {0020-7721},
  DOI = {10.1080/00207721.2012.723056},
