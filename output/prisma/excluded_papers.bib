@Article{chambers_operationalizing_2019,
  AUTHOR = {Chambers, Jeanne C. and Allen, Craig R. and Cushman, Samuel A.},
  JOURNAL = {Frontiers in Ecology and Evolution},
  TITLE = {Operationalizing {Ecological} {Resilience} {Concepts} for {Managing} {Species} and {Ecosystems} at {Risk}},
