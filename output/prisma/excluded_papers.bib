@Article{carvallo_exploring_2019,
  AUTHOR = {Carvallo, Juan Pablo and Sanstad, Alan H. and Larsen, Peter H.},
  JOURNAL = {Energy},
  MONTH = {},
  PAGES = {NaN--NaN},
  TITLE = {Exploring the relationship between planning and procurement in western {U}.{S}. electric utilities},
  VOLUME = {183},
  YEAR = {2019},
  LANGUAGE = {en},
  FILE = {Accepted Version:/Users/corywhitney/Zotero/storage/JKMKY3I7/Carvallo et al. - 2019 - Exploring the relationship between planning and pr.pdf:application/pdf;Carvallo et al. - 2019 - Exploring the relationship between planning and pr.pdf:/Users/corywhitney/Zotero/storage/SUTJ699X/Carvallo et al. - 2019 - Exploring the relationship between planning and pr.pdf:application/pdf;ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/NPSXUMG8/S036054421931254X.html:text/html},
  DOI = {10.1016/j.energy.2019.06.122},
  KEYWORDS = {Procurement, Regulation, Resource planning},
  ABSTRACT = {Integrated resource planning is an important regulatory process used in many U.S. states to formulate and evaluate least-cost and risk-assessed portfolios to meet future load requirements for electric utilities. In principle, effective implementation of integrated resource planning seeks to assure regulators and the public that utility investment decisions, given uncertainty, are as cost-effective as possible. However, there is no empirical assessment on the effectiveness of integrated resource planning and its implementation. This paper compares planning outcomes and actual decisions for twelve utilities across the Western U. S. from 2003 to 2014. The authors find that subsequent plans differ significantly due to changes in the planning environment, which limited amount of information produced during planning is ultimately used during the procurement process, and that the latter process relies extensively on the most recent information available for decision making. These findings suggest that states' integrated resource planning rules and regulations mandating long-term planning horizons with the same analytical complexity throughout the planning period may not create useful information for the procurement process. The social value of a long-term planning process that departs from procurement and the balance between transparency and complexity of the planning and procurement processes is an open question.},
  URL = {https://www.sciencedirect.com/science/article/pii/S036054421931254X},
