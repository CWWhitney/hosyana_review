@Phdthesis{zhang_benefits_2012,
  AUTHOR = {Zhang, Fan},
  SCHOOL = {UNSW Sydney},
  TITLE = {Benefits of {Regional} {Ocean} and {Weather} {Forecast} {Systems} : {Evidence} from the {Australian} {East} {Coast}},
  TYPE = {Thesis},
  YEAR = {2012},
  SHORTTITLE = {Benefits of {Regional} {Ocean} and {Weather} {Forecast} {Systems}},
  FILE = {Full Text PDF:/Users/corywhitney/Zotero/storage/3BSBU8TI/Zhang - 2012 - Benefits of Regional Ocean and Weather Forecast Sy.pdf:application/pdf},
  KEYWORDS = {Bayesian},
  LANGUAGE = {English},
  ABSTRACT = {Recent advances in weather and ocean observations and forecasts have provided an unprecedented amount of meteorological and oceanographic information that has had significant impact on a wide range of marine-related industries, as well as on community and individual activities. However, the evaluation of the benefits of a regular ocean forecast, one significant factor influencing users decision-making regarding ocean-related activities, has not received much attention. This thesis examines recent developments in ocean and weather observation and forecasting, and evaluates quantitatively the economic benefits of both weather and ocean information for a range of beneficiaries. The specific economic benefit from the newly established Integrated Marine Observing System (IMOS) in Australia is estimated using the commonly used simplified percentage-increase evaluation method, taking one node, the New South Wales Integrated Marine Observing System (NSW-IMOS), as a case study. The potential benefit from the establishment of the NSW-IMOS is estimated to be \$2.4 million year. A new general method for systematically evaluating economic benefits from ocean weather forecast information, based on Bayesian Theory, is developed in the thesis. This method is then applied to beach users in Australia as a case study. Beach recreation, one of the most popular recreational activities all over the world, is significantly influenced by weather and ocean conditions. However, only the impact of weather conditions on beach recreation has previously been considered. This thesis is one of the first studies to systematically evaluate the benefits of ocean information and the combined effects of weather and ocean information to ocean-related activities. It is also the first to evaluate systematically the benefits of weather and ocean forecasts to any recreational activity. The preferred weather and ocean conditions for beach recreational activities are found using data from beach webcams. The importance of weather and ocean forecasts to beach users, and their satisfaction with these forecasts, are then analysed using data from on-site questionnaire surveys. The characteristics of people who are more likely to check the weather or ocean forecast before their beach visit are determined. The potential economic benefits to beach users in Australia from improved regular weather and ocean forecasts are then estimated quantitatively. These benefits are estimated to be between \$20.5 million and \$409 million per year.},
  URL = {http://hdl.handle.net/1959.4/52425},
  URLDATE = {2023-10-19},
  DOI = {10.26190/unsworks/15962},
  HAS_ANNOTATION = {FALSE},
  ANNOTATION_TEXT = {},
