  JOURNAL = {Journal of Contaminant Hydrology},
  MONTH = {},
  PAGES = {103554},
  TITLE = {An iterative strategy for contaminant source localisation using {GLMA} optimization and {Data} {Worth} on two synthetic {2D} {Aquifers}},
