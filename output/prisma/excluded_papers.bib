@Phdthesis{wang_motivations_2017,
  AUTHOR = {Wang, Lujie},
  MONTH = {},
  TITLE = {The motivations and barriers for {Chinese} enterprises to participate in {Public}-{Private}-{Partnership} ({PPP}) infrastructure projects in {China}: {A} new institutional economics perspective. {Partial} {Fulfilment} of the {Graduation} {Requirement} for the {Degree} of {MRes}},
  YEAR = {2017},
  SHORTTITLE = {The motivations and barriers for {Chinese} enterprises to participate in {Public}-{Private}-{Partnership} ({PPP}) infrastructure projects in {China}},
  FILE = {Full Text PDF:/Users/corywhitney/Zotero/storage/SGAN9DNS/Wang - 2017 - The motivations and barriers for Chinese enterpris.pdf:application/pdf},
  ABSTRACT = {Public-Private-Partnership (PPP) as an efficient arrangement to improve infrastructure delivery through the cooperation of public authorities and private enterprises is employed worldwide. It is favoured by the Chinese government as a catalyst to realize its new and adjusting goal of moderate and harmonious development through a new round of ‘New National Urbanization Plan’ (Ye and Li, 2014). Considering the large amount of PPPs which are undergoing, being planned and the great potential in the future, understanding PPP development experience in China is valuable for China and other economies to enhance the PPP performance (Zhang et al., 2016). By applying New Institutional Economics (NIE), this study aims to analyse the motives and impediments mechanisms of Chinese private enterprises to participate in PPPs in China. The empirical results of 20 in-depth interviews suggest that legislation improvement, national grand strategies stimulation and policy intervention to favour private enterprises in public assets and service provision motivate them to participate in PPPs in China. Besides, obtaining short-term profits that are generated in the construction phases and long-term cash flow, as well as getting first-mover advantages are also motivations for them. Moreover, it is political mandate for state-owned enterprises (SOEs) to get involved. The most prominent barriers are the complicated and dynamic process of PPP projects, lack of trust and an inferior positions of private-owned enterprises (POEs). However, private enterprises which have yet involved in PPP projects, hold significantly different views. In addition, PPP implementation has met with opportunistic behaviours by both the public and private sectors. I believe this study will help present the real views of Chinese private enterprises, and ultimately contribute to narrow the mutual understanding gap between the public and the private sectors that often impedes successful PPPs.},
  DOI = {10.13140/RG.2.2.16112.56329},
  HAS_ANNOTATION = {FALSE},
  ANNOTATION_TEXT = {},
  FULL_TEXT = {The motivations and barriers for {Chinese} enterprises to participate in {Public}-{Private}-{Partnership} ({PPP}) infrastructure projects in {China}: {A} new institutional economics perspective. {Partial} {Fulfilment} of the {Graduation} {Requirement} for the {Degree} of {MRes} NA},
