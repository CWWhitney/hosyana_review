  FILE = {Full Text PDF:/Users/corywhitney/Zotero/storage/Y4KGEUNB/Mogis - 2020 - Transparency, technology and trust Music metrics .pdf:application/pdf;Snapshot:/Users/corywhitney/Zotero/storage/GXJE7TG5/199497.html:text/html},
