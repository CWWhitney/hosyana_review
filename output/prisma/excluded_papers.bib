@Article{dhawale_adaptive_2019,
  ANNOTE = {Export Date: 05 May 2024; Cited By: 48},
  AUTHOR = {Dhawale, Ashesh K. and Miyamoto, Yohsuke R. and Smith, Maurice A. and Ölveczky, Bence P.},
