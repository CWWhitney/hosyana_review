@Incollection{khan_use_2020,
  AUTHOR = {Khan, Hera and Srivastav, Ayush and Mishra, Amit Kumar},
  BOOKTITLE = {Big {Data} {Analytics} and {Intelligence}: {A} {Perspective} for {Health} {Care}},
  EDITOR = {Tanwar, Poonam and Jain, Vishal and Liu, Chuan-Ming and Goyal, Vishal},
  MONTH = {},
