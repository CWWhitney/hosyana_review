  AUTHOR = {Talebi, Mohammad Sadegh and Zou, Zhenhua and Combes, Richard and Proutiere, Alexandre and Johansson, Mikael},
  JOURNAL = {IEEE Transactions on Automatic Control},
  MONTH = {},
