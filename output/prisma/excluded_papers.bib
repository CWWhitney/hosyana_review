@Article{withall_tribulations_2020,
  AUTHOR = {Withall, Janet and Greaves, Colin J and Thompson, Janice L and de Koning, Jolanthe L and Bollen, Jessica C and Moorlock, Sarah J and Fox, Kenneth R and Western, Max J and Snowsill, Tristan and Medina-Lara, Antonieta and Cross, Rosina and Ladlow, Peter and Taylor, Gordon and Zisi, Vasiliki and Clynes, James and Gray, Selena and Agyapong-Badu, Sandra and Guralnik, Jack M and Rejeski, W Jack and Stathi, Afroditi and {for the REACT Study Research Group}},
  JOURNAL = {The Journals of Gerontology: Series A},
  MONTH = {},
