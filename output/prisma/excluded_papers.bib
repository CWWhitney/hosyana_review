@Article{avanzi_information_2020,
  AUTHOR = {Avanzi, Francesco and Maurer, Tessa and Glaser, Steven D. and Bales, Roger C. and Conklin, Martha H.},
  JOURNAL = {Journal of Hydrology},
  MONTH = {},
  PAGES = {124478},
  TITLE = {Information content of spatially distributed ground-based measurements for hydrologic-parameter calibration in mixed rain-snow mountain headwaters},
  VOLUME = {582},
  YEAR = {2020},
  FILE = {ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/R5SK37CY/S0022169419312132.html:text/html;Submitted Version:/Users/corywhitney/Zotero/storage/6LDMID2K/Avanzi et al. - 2020 - Information content of spatially distributed groun.pdf:application/pdf},
  KEYWORDS = {Parameter calibration, PRMS, Snowmelt},
  ABSTRACT = {Parameters in hydrologic models used in mixed rain-snow regions are often uncertain to calibrate and overfitted on streamflow. To contribute addressing these challenges, we used an algorithm that assesses modeling performances through time (Dynamic Identifiability Analysis) to quantify the information content of spatially distributed ground-based measurements for identifying optimal parameter values in the Precipitation Runoff Modeling System (PRMS) model. Including spatially distributed ground-based measurements in Identifiability Analysis allowed us to unambiguously estimate more parameter values than only using streamflow (seven parameters instead of two out of a pool of thirty-three). Peaks in information gain were obtained when using dew-point temperature to identify precipitation phase-partitioning parameters. Multi-attribute identifiability analysis also yielded optimal parameter values that were temporally less variable than those estimated using streamflow alone. Overall, identifying parameter values using ground-based measurements improved the simulation of key drivers of the surface-water budget, such as air temperature and precipitation-phase partitioning. However, parameters simulating surface-to-subsurface mass fluxes like snow accumulation and melt or evapotranspiration were poorly identified by any attribute and so emerged as key sources of predictive uncertainty for this distributed-parameter hydrologic model. This work demonstrates the value of expanded ground-based measurements for identifying parameters in distributed-parameter hydrologic models and so diagnosing their conceptual uncertainty across the water budget.},
  URL = {https://www.sciencedirect.com/science/article/pii/S0022169419312132},
  URLDATE = {2023-10-25},
  ISSN = {0022-1694},
