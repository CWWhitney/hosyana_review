@Article{chen_bridging_2019,
  AUTHOR = {Chen, Ke and Lu, Weisheng},
  JOURNAL = {Engineering, Construction and Architectural Management},
  MONTH = {},
  NOTE = {Publisher: Emerald Publishing Limited},
  NUMBER = {7},
  PAGES = {1518--1532},
  TITLE = {Bridging {BIM} and building ({BBB}) for information management in construction: {The} underlying mechanism and implementation},
