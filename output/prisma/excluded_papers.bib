@Article{ritola_learning_2020,
  AUTHOR = {Ritola, Ilkka and Krikke, Harold and Caniëls, Marjolein},
  JOURNAL = {Logistics},
  MONTH = {},
  NUMBER = {2},
  PAGES = {7},
  TITLE = {Learning from {Returned} {Products} in a {Closed} {Loop} {Supply} {Chain}: {A} {Systematic} {Literature} {Review}},
  VOLUME = {4},
  YEAR = {2020},
  SHORTTITLE = {Learning from {Returned} {Products} in a {Closed} {Loop} {Supply} {Chain}},
  FILE = {Ritola et al. - 2020 - Learning from Returned Products in a Closed Loop S.pdf:/Users/corywhitney/Zotero/storage/BIMVF2R2/Ritola et al. - 2020 - Learning from Returned Products in a Closed Loop S.pdf:application/pdf},
  LANGUAGE = {en},
  ABSTRACT = {Product returns are a source of valuable information that can be used by ﬁrms and supply chains to improve products, services, and decision making. However, ﬁrms are struggling to maximize the value of this information, and the extant scholarly literature is scattered among various research streams. Using a systematic literature review, the state-of-the-art of product returns informational value research and limitations in the current body of work were examined and future directions for research suggested. Three types of informational value were identiﬁed, namely operational information, product related information, and customer-related information, along with four value-creating factors, namely strategic information system (IS) decisions, organizational learning, information sharing, and technological solutions. Implications for practitioners are discussed. Lastly, the limitations are discussed, along with recommendations and directions for future research work.},
