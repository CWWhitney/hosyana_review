  PAGES = {305--311},
  TITLE = {Trial {Size} for {Near}-{Optimal} {Choice} {Between} {Surveillance} and {Aggressive} {Treatment}: {Reconsidering} {MSLT}-{II}},
  VOLUME = {73},
