@Article{dagostinoSewingClimateresilientSeeds2011a,
  AUTHOR = {D'Agostino, Anthony L. and Sovacool, Benjamin K.},
  JOURNAL = {Mitigation and Adaptation Strategies for Global Change},
  MONTH = {},
  NUMBER = {6},
  PAGES = {699--720},
  TITLE = {Sewing climate-resilient seeds: {Implementing} climate change adaptation best practices in rural cambodia},
  VOLUME = {16},
  YEAR = {2011},
