@Article{hagmann_persuasion_nodate,
  AUTHOR = {Hagmann, David and Loewenstein, George},
  PAGES = {0--27},
  TITLE = {Persuasion with motivated beliefs},
  LANGUAGE = {en},
  FILE = {Hagmann and Loewenstein - Persuasion With Motivated Beliefs.pdf:/Users/corywhitney/Zotero/storage/Z45PDMPB/Hagmann and Loewenstein - Persuasion With Motivated Beliefs.pdf:application/pdf},
  KEYWORDS = {bin, read CW},
  ABSTRACT = {Considerable empirical research ﬁnds that people derive utility not only from consumption, but also from their beliefs about themselves and the world. Rather than dispassionately updating their views in response to new information, such belief-based utility implies that people at times avoid information and use other strategies to protect their existing beliefs. We present a two-stage model of persuasion in the presence of belief-protecting strategies and test it in an incentive-compatible task. In the experiment, persuaders seek to shift receivers’ subjective numeric estimates related to emotionally charged topics, such as abortion and racial discrimination. We manipulate whether the persuader ﬁrst acknowledges her own lack of certainty and whether she ﬁrst has an opportunity to build rapport with the receiver. Though these elements of communication ought to be irrelevant or even backﬁre under the standard account, our theory predicts they will enhance persuasiveness.},
