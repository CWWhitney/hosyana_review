@Article{brownson_evaluating_2020,
  ANNOTE = {Export Date: 05 May 2024; Cited By: 15},
  AUTHOR = {Brownson, Katherine and Fowler, Laurie},
  JOURNAL = {Land Use Policy},
  MONTH = {},
