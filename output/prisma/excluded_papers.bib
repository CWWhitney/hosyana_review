@Article{ekhorutomwen_microfinance_nodate,
  AUTHOR = {Ekhorutomwen, ASEMOTA Abel},
  PAGES = {0--11},
  TITLE = {Microfinance institutions and information sharing towards national development: how realistic? (a case of selected microfinance banks in edo state of {Nigeria})},
  SHORTTITLE = {Microfinance institutions and information sharing towards national development},
  LANGUAGE = {en},
  FILE = {Ekhorutomwen - Microfinance institutions and information sharing .pdf:/Users/corywhitney/Zotero/storage/8C5RALN3/Ekhorutomwen - Microfinance institutions and information sharing .pdf:application/pdf},
  KEYWORDS = {bin, read CW},
  ABSTRACT = {The study examines microfinance institutions and information sharing in Edo State, Nigeria. Information sharing among microfinance institutions can increase the repayment incentives of borrowers and constrain the information based monopoly power of lenders. However, credit bureaus and other formal institutional mechanisms, which allow for easy information exchange on borrowers in most developed countries, are absent in contexts where microfinance providers are most active especially in the developing countries. The main objective of the study is to examine how Microfinance Banks (MFBs) share information amongst themselves. By means of questionnaire, data were collected from thirty-three management staff from eleven Microfinance Banks randomly sampled from the twenty MFBs in the state. Data analysis was done using frequency, mean and simple regression model to test for the hypothesis. The result indicate that three of the explanatory variables were significant and these are; information self-efficacy (b = .125), attitude (b = .529) and subjective norms (.210). The result indicates that respondents are willing to share information on client repayment rate (mean = 3.85), interest rate (mean = 3.62), types of products and services (3.61), staff size (3.51) and loan sizes (3.33). From the study the following recommendations was stated; Microfinance Institutions should develop a good infrastructural facility and technical expertise to enhance smooth information sharing within the sector; ICTs should be well developed within the institutions for efficiency, effectiveness and reliability, and timeliness in reporting; Microfinance Association of Nigeria should be well developed with necessary facilities to aid them in area of information sharing. MFIs should always be willing to share information about their clients’ demographic characteristics, repayment rate, loan size, loan disbursed, and regional and local penetration of their organization.},
  HAS_ANNOTATION = {FALSE},
  ANNOTATION_TEXT = {},
  FULL_TEXT = {Microfinance institutions and information sharing towards national development: how realistic? (a case of selected microfinance banks in edo state of {Nigeria}) NA},
