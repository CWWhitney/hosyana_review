  AUTHOR = {Garcia, Serge M. and Grainger, Richard J. R.},
  EDITOR = {Beddington, J. R. and Kirkwood, G. P.},
  JOURNAL = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  MONTH = {},
