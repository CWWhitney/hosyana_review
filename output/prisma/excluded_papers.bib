  JOURNAL = {Frontiers in Marine Science},
  TITLE = {Considerations in {Harmful} {Algal} {Bloom} {Research} and {Monitoring}: {Perspectives} {From} a {Consensus}-{Building} {Workshop} and {Technology} {Testing}},
  VOLUME = {6},
