@Article{clemons_understanding_2017,
  AUTHOR = {Clemons, Eric K. and Dewan, Rajiv M. and Kauffman, Robert J. and Weber, Thomas A.},
  JOURNAL = {Journal of Management Information Systems},
  MONTH = {},
  NOTE = {},
  NUMBER = {2},
  PAGES = {425--456},
  TITLE = {Understanding the {Information}-{Based} {Transformation} of {Strategy} and {Society}},
  VOLUME = {34},
