@Article{shoukohyar_uncovering_2020,
  ANNOTE = {Export Date: 05 May 2024; Cited By: 22},
  AUTHOR = {Shoukohyar, Sajjad and Seddigh, Mohammad Reza},
  JOURNAL = {Technological Forecasting and Social Change},
  MONTH = {},
