@article{yokomizoDecisionScienceEffective2014,
  title = {Decision Science for Effective Management of Populations Subject to Stochasticity and Imperfect Knowledge},
  author = {Yokomizo, Hiroyuki and Coutts, Shaun R. and Possingham, Hugh P.},
  year = 2014,
  journal = {Population Ecology},
  volume = {56},
  pages = {41--53},
  publisher = {Springer},
  doi = {10.1007/s10144-013-0421-2},
  langid = {english},
  keywords = {Monitoring,Stochastic dynamic programming},
