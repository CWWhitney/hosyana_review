@article{yooStatisticalMethodsExperimentation2013,
  title = {Statistical Methods in Experimentation Recommendation Models for Discovering Gene Regulation Pathways},
  author = {Yoo, Changwon},
  year = 2013,
  journal = {Wiley Interdisciplinary Reviews: Computational Statistics},
