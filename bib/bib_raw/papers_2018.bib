@article{ylijokiRecipeBigData2018,
  title = {A Recipe for Big Data Value Creation},
  author = {Ylijoki, Ossi and Porras, Jari},
  year = 2018,
  month = jan,
  journal = {Business Process Management Journal},
  volume = {25},
  number = {5},
  pages = {1085--1100},
  publisher = {Emerald Publishing Limited},
  issn = {1463-7154},
  doi = {10.1108/BPMJ-03-2018-0082},
  urldate = {2023-12-08},
  abstract = {Purpose The purpose of this paper is to present a process-theory-based model of big data value creation in a business context. The authors approach the topic from the viewpoint of a single firm. Design/methodology/approach The authors reflect current big data literature in two widely used value creation frameworks and arrange the results according to a process theory perspective. Findings The model, consisting of four probabilistic processes, provides a ``recipe'' for converting big data investments into firm performance. The provided recipe helps practitioners to understand the ingredients and complexities that may promote or demote the performance impact of big data in a business context. Practical implications The model acts as a framework which helps to understand the necessary conditions and their relationships in the conversion process. This helps to focus on success factors which promote positive performance. Originality/value Using well-established frameworks and process components, the authors synthetize big data value creation-related papers into a holistic model which explains how big data investments translate into economic performance, and why the conversion sometimes fails. While the authors rely on existing theories and frameworks, the authors claim that the arrangement and application of the elements to the big data context is novel.},
  langid = {english},
  keywords = {Process theory},
  file = {/Users/corywhitney/Zotero/storage/FFRNFEAR/html.html}
}

@article{yuStrategicInformationSharing2018,
  title = {Strategic Information Sharing and Competition under Cap-and-Trade Regulation},
  author = {Yu, Man and Cao, Erbao},
  year = 2018,
  month = jan,
  journal = {Industrial Management \& Data Systems},
  volume = {119},
  number = {3},
  pages = {639--655},
  publisher = {Emerald Publishing Limited},
  issn = {0263-5577},
  doi = {10.1108/IMDS-03-2018-0124},
  urldate = {2023-12-07},
  abstract = {Purpose The purpose of this paper is to investigate whether truthful information sharing can be achieved via informal cheap talk in a competitive setting, and how carbon emission constraint and information-sharing modes (no information sharing, partial information sharing and public information sharing) interact with each other under cap-and-trade regulation. Design/methodology/approach This paper establishes an emission-dependent supply chain consisting of a manufacturer, an incumbent retailer who has superior demand information and a new entrant retailer. The manufacturer abates carbon emissions under the pressures of government environmental regulation and consumers' eco-friendly concern. The research formulates a multistage game to explore every party's decision and the implications of information-sharing modes. Findings The results show that truthful information sharing can be achieved when the manufacturer decides both the wholesale price and carbon emission abatement. The results also show that the incumbent retailer's information-sharing decision highly depends on the manufacturer's capacity in abating carbon emissions and the demand uncertainty. Originality/value The research adds value to information management and sustainable production literature. This work emphasizes the interaction between the information flow and material flow. Not only it investigates the factors that affect information-sharing modes from a new point of view when considering carbon emission constraint, but also provides operational strategies for manufacturers to make more profit when facing asymmetric information and emission regulation.},
  langid = {english},
  keywords = {Strategy},
  file = {/Users/corywhitney/Zotero/storage/5VDTGJQY/html.html}
}

@article{zhouIntegratedSustainableSupplier2018,
  title = {An Integrated Sustainable Supplier Selection Approach Based on Hybrid Information Aggregation},
  author = {Zhou, X. and Xu, Z.},
  year = 2018,
  journal = {Sustainability (switzerland)},
  volume = {10},
  number = {7},
  pages = {0--49},
  doi = {10.3390/su10072543},
  langid = {english},
  note = {Export Date: 05 May 2024; Cited By: 62
\par
\textbf{\emph{sustainability}}
\par
Article
\par
An Integrated Sustainable Supplier Selection
\par
Approach Based on Hybrid Information Aggregation
\par
Xiongyong ZhouID and Zhiduan Xu *
\par
School of Management, Xiamen University, Xiamen 361005, China; xiongyongzhou@stu.xmu.edu.cn
\par
* Correspondence: zhiduanx@xmu.edu.cn; Tel.: +86-189-5928-7116
\par
Received: 15 June 2018; Accepted: 12 July 2018; Published: 19 July 2018
\par
Abstract: With a great emphasis on both social and environmental responsibilities, sustainable supply
\par
chain management has gradually been adopted and promoted as an innovative business model.
\par
In sustainable supply chain practice, the choice of sustainable suppliers relates to the long-term
\par
development of a company. While the environmental performance of suppliers has been commonly
\par
considered, the social dimension has not yet received enough attention. This paper first proposes
\par
a novel criteria system for evaluating sustainable suppliers from three aspects and six dimensions,
\par
and then introduces an integrated evaluation model with a novel hybrid information aggregation.
\par
To verify the applicability and effectiveness of the proposed method, a real case of a large supermarket
\par
is introduced and analyzed. The research results show that (1) the indicator system based on Triple
\par
Bottom Line theory can serve as a framework of sustainable supplier selection for manufacturing and
\par
circulation enterprises; (2) the introduction of hybrid information aggregation can effectively handle
\par
the uncertainties of indicator scores under the realistic fuzzy environment and objectively reflect the
\par
intentions of the scorers; and (3) in comparison with the TOPSIS algorithm, the priority order finally
\par
obtained is consistent, but the proposed model shows more robustness in the sensitivity test.
\par
Keywords: sustainable supplier selection; DEMATEL; ANP; fuzzy VIKOR; IVTFN; hybrid
\par
information aggregation; TBL theory
\par
1. Introduction
\par
The problems regarding violations of corporate ethics and national laws caused by the lack of
\par
environmental and social responsibility in supply chain operations have drawn great public concern
\par
in recent times [1,2]. On 31 August 2011, five environmental groups led by the Institute of Public and
\par
Environmental Affairs (IPE), a nonprofit organization in Beijing, revealed a pollution map with regard
\par
to the supply chain of the high-tech giant Apple in China after more than six months' investigation,
\par
which exposed dozens of labor rights violations, as well as safety and environmental offenses, made by
\par
27 suspected suppliers of Apple. Subsequently, The Other Side of Apple II, a special report issued by
\par
IPE in association with other green groups strongly condemned Apple for the environmental and social
\par
irresponsibility of its business practices. Incidents included the long-term breach of environmental
\par
regulations by the factories of some suppliers, with more than ten violations of commitments to
\par
pollution and worker health accords, violations of international safety standards for the release of
\par
toxic metals such as copper and nickel, a lack of attention to the physical and mental health of the
\par
local community and public, and the disposal of hazardous wastes in a manner that violated local
\par
governmental legislation [3]. Initially, Apple denied all the charges and argued that they were just
\par
downstream purchasers that had no joint liability for bad behavior among other suppliers. However,
\par
Chinese environmental organizations and consumers did not agree with this statement, and started to
\par
boycott all Apple products. In the face of growing public pressure, Apple came to realize that they
\par
were unable to ignore the problem, since consumers place liability on the focal company in the product
\par
Sustainability 2018, 10, 2543; doi:10.3390/su10072543 www.mdpi.com/journal/sustainabilitySustainability 2018, 10, 2543 2 of 49
\par
chain more often than not. For focal companies, they should not only manage their own behavior, but
\par
also strengthen the supervision of the operations of their suppliers. Consumers in modern society
\par
are increasingly concerned about whether the products they buy are environmentally sound, and
\par
whether the brands they trust maintain a responsible supply chain. In view of the public scrutiny
\par
and social pressure, core companies cannot only concern themselves with their own transparency
\par
and green obligations; the issue of whether upstream suppliers take sustainable initiatives is directly
\par
linked to the reputations of focal firms and the supply chain at large. Therefore, they should pay much
\par
more attention to sustainable supply chain management (SSCM), especially in terms of the choice
\par
of sustainable suppliers. For purchasing managers and researchers, how to establish a practical and
\par
pragmatic evaluation system and method focusing on sustainable suppliers has become a necessary
\par
but challenging issue [4--7].
\par
The sustainable supplier selection (SSS) is a focus issue that has gained attention over the past
\par
five years [8,9]. Compared to traditional supplier selection which mainly concentrates on economic
\par
benefit and cost optimization [10--12], and green supplier evaluation that focuses on environmental
\par
performance [2,13,14], investigation of the sustainability of suppliers also needs to consider their social
\par
responsibility. The indicators of responsibility to internal stakeholders around employee rights have
\par
been put forward: occupational health and safety [4,15--17], training and practice [15,18], and other
\par
legitimate rights [4,15]. However, few works paid attention to external stakeholders, much less did
\par
they establish a comprehensive evaluation framework and logic that could be used to measure the
\par
sustainability of the supplier. Therefore, the first potential contribution of this paper is to place a
\par
stronger emphasis on suppliers' social performance, and to propose a novel measure for SSS based
\par
on the logic of the Triple Bottom Line (TBL) theory [19]. This measure covers economic, green
\par
(environmental), and social factors, with a total of 24 indicators. Among them, from stakeholder
\par
theory we point out that suppliers' social responsibility is not only reflected in their duties to
\par
internal stakeholders (such as employees and shareholders), but also to external stakeholders (such as
\par
communities and the governments).
\par
Considering the criteria of SSS, a multi-criteria decision-making (MCDM) approach provides
\par
an effective framework to solve the screen problem with different conflicting goals [6]. Some typical
\par
MCDM methods, such as the Analytic Network Process (ANP), have been widely used to solve supplier
\par
selection issues, while most studies have assumed that each cluster in the ANP has equal weight in
\par
the creation of a weighted supermatrix [20,21]. In addition, many used methods, including Artificial
\par
Neural Networks (ANNs), rarely consider the real existence of mutual influence and feedback among
\par
criteria during the process of weight determination [22]. To improve upon these shortcomings, we
\par
integrate the DEMATEL method, representing the related properties between indicators with the ANP
\par
method to calculate the weights of the various criteria. Compared with other studies proposing the
\par
DEMATEL-ANP method [21,23], we improve the method for remapping the ANP network structure,
\par
which effectively reduces computation costs.
\par
TOPSIS and VIKOR are typical compromise programming technologies which focus on ranking
\par
and selecting a set of options [24]. Compared with the TOPSIS method, which may cause an improper
\par
effect known as ``total rank reversal'' [2], the fact that the best solution obtained by VIKOR is closer
\par
to the ideal solution makes VIKOR the most suitable method for selecting suppliers in the view of
\par
many authors [25]. In light of the above factors, this paper also uses a hybrid VIKOR technology as
\par
a decision-making tool to determine the optimal sustainable supplier before the weight definition
\par
through DEMATEL-ANP method is applied.
\par
Moreover, this paper also introduces a set of hybrid information aggregation for practical
\par
evaluation, and combines this information set with the proposed integrated method. As qualitative
\par
factors and quantitative indicators often coexist simultaneously in the measure of supplier selection,
\par
accuracy and pragmatism cannot be achieved if those factors are scored by a single value type [26].
\par
For the convenience of calculation or the limitation of the method, using mixed data as an input
\par
was generally not considered in the past; rather, it served to unilaterally adopt quantitative scoringSustainability 2018, 10, 2543 3 of 49
\par
or qualitative judgment. The hybrid information aggregation we proposed can reduce the vague
\par
and subjective impact of human judgments and preferences through mixed data forms to describe
\par
the comprehensive performance of potential suppliers, which includes the precise number, interval
\par
number, and fuzzy number. Note that the linguistic term, rather than the numerical form, is proposed
\par
for decision makers (DMs) to answer the relevant questions [4], due to its simplicity and tangibility in
\par
expressing perceptions [4], which can normally be transformed into fuzzy numbers. The use of an
\par
interval-valued triangular fuzzy number (IVTFN) is proposed in this paper to effectively reduce the
\par
uncertainty and ambiguity that exists in the supplier selection process [27].
\par
A case of a retail enterprise is finally introduced to verify the applicability of the measure and
\par
feasibility of the proposed model with regard to the SSS problem. While most related literature in
\par
this field has focused on manufacturing companies [28--30], little attention is given to SSS of retail
\par
enterprises. As more and more retail companies, such as Wal-Mart and Migros, have proposed goals
\par
and plans for global sustainable procurement in recent years, the means of developing a comprehensive
\par
measure for sustainability and an effective assessment method to choose sustainable suppliers has
\par
become an urgent problem. We contribute theoretical supplements for the field of supplier selection
\par
and the question of sustainability by pointing out the limitations of the existing methods and proposing
\par
an effective model and information process approach to guide enterprises through the supply chain,
\par
especially in the retail industry, to select sustainable suppliers and implement sustainable practices.
\par
The remainder of this paper is organized as follows: Section 2 reviews the literature on
\par
SSCM, SSS criteria, and evaluation methods. Section 3 introduces our methodology, including the
\par
DEMATEL-ANP-VIKOR algorithm and hybrid information aggregation. In Section 4, an empirical
\par
case of a retail enterprise is presented to solve the SSS problem by an integrated approach. Finally, in
\par
Section 5, we discuss the implications and offer conclusions and future study avenues.
\par
2. Literature Review
\par
2.1. SSCM and Supplier Selection
\par
The earliest study of SSCM can be traced back to the 1990s, when the concept of sustainability
\par
mainly referred to environmental management. Drumwright [31] put forward the importance of social
\par
responsibility for companies in terms of purchasing, production, and consumption. In the same year,
\par
Murphy, et al. [32] suggested that priority should be placed on environmental issues over logistics
\par
management. In the late 1990s, the principles of green supply chains were proposed to change the
\par
traditional requirements and objective functions goals of operation management [33,34]. Elkington [19]
\par
further proposed the concept of TBL, focusing on the balance of economic, environmental, and social
\par
goals from a business perspective. Carter and Jennings [35] posed the dual relationship approach
\par
to analyze each system unit so as to assess change in the case where a sustainable solution was
\par
used. Mentzer, et al. [36] believed that sustainability in the supply chain is a systematic and strategic
\par
coordination of business operations and decisions within a company and its supply chain to increase
\par
the long-term comprehensive benefits. Linton, et al. [37] was the first to put forward the concept of
\par
SSCM, while Carter and Rogers [38] and Seuring and M\"uller [1] offered deeper explanations of this
\par
term. Specifically, SSCM was described as a strategic and transparent collection that covered four
\par
support aspects of sustainability, namely: risk management, transparency, strategy, and corporate
\par
culture [38], coordinating the systematic business process based on the TBL principle within internal
\par
organizations [1], to eventually get the trade-off from social, environmental, and economic objectives.
\par
Companies should have a formal mechanism to monitor and disclose responsible and sustainable
\par
issues in their supply chain [39] in order to gain both internal and external performance edges and
\par
reputations, as well as continuous competitive advantages [1,40,41].
\par
As a critical part of SSCM, helping suppliers recognize the importance of sustainability and
\par
support them in improving their SSCM practices is a vital task for core enterprises [5]. Only by
\par
the efforts of sustainable initiatives taken through the integration of upstream and downstreamSustainability 2018, 10, 2543 4 of 49
\par
partners, can sustainability in the supply chain be continued. The core enterprise can actively mobilize
\par
their suppliers to participate in environmental protection plans, doing charities, and maintaining
\par
cooperative partnerships, and encourage them to address SSCM initiatives and adopt more proactive
