  title = {A Bibliometric Analysis of Inventory Management Research Based on Knowledge Mapping},
  author = {Ye, Yong and Ge, Yuanqin},
  year = 2018,
  month = jan,
  journal = {The Electronic Library},
  volume = {37},
  number = {1},
  pages = {127--154},
  publisher = {Emerald Publishing Limited},
  issn = {0264-0473},
  doi = {10.1108/EL-11-2017-0241},
  urldate = {2023-12-07},
  abstract = {Purpose The research mainly aims at the hotspot of inventory management by knowledge mapping and provides a visualization reference in this research field. Design/methodology/approach First, inventory management journals during 1986 to 2017 were selected as the research object and text formatting in the Web of Science (WOS) database is exported. Then inventory management knowledge mapping is done and clustering keywords are extracted by using CiteSpace and VOSviewer software. Based on co-word analysis, the three special clusters are exported: inventory optimization strategy, inventory pricing and inventory technology. Besides, the clustering structure and time evolution are analysed. Finally, bibliographic item co-occurrence matrix builder (BICOMB) was used to extract the ``journal'' and ``researchers'' keywords in the inventory management research fields. Setting three parameters such as the cited half-life, centrality, frequency and keywords for data mining, it can infer the trend keywords of future research. Findings Results showed that inventory management research has been abundant in literature over the past 30 years and has experienced a change from focusing on inventory optimization strategy to inventory pricing and inventory technology in process. It shows that inventory management research focused on the classic topics and includes economic order quantity, dynamic pricing, design and technology, and the new topics include channel coordination, hierarchical price and simulation. Research limitations/implications Based on knowledge mapping, this study is still relatively macro and cannot cover all areas of inventory management. This study only investigated the state of correlational research in WOS and Google Trends and not additional databases. Originality/value The current research mainly builds on knowledge mapping for the research hotspot of inventory management and provides visual references for future research in this field.},
  langid = {english},
  keywords = {Knowledge mapping},
  file = {/Users/corywhitney/Zotero/storage/8T4SBDCE/html.html}
}

@article{yetExpectedValuePartial2018,
  title = {Expected Value of Partial Perfect Information in Hybrid Models Using Dynamic Discretization},
  author = {Yet, B. and Constantinou, A. and Fenton, N. and Neil, M.},
  year = 2018,
  journal = {IEEE Access},
  volume = {6},
  pages = {NaN-NaN},
  doi = {10.1109/ACCESS.2018.2799527},
  langid = {english},
  note = {Export Date: 05 May 2024; Cited By: 10
\par
Received September 13, 2017, accepted January 15, 2018, date of publication January 31, 2018, date of current version March 12, 2018.
\par
Digital Object Identifier 10.1109/ACCESS.2018.2799527
\par
Expected Value of Partial Perfect Information in
\par
Hybrid Models Using Dynamic Discretization
\par
BARBAROS YET 1, ANTHONY CONSTANTINOU2, NORMAN FENTON2, AND MARTIN NEIL2
\par
1 Department of Industrial Engineering, Hacettepe University, 06800 Ankara, Turkey
\par
2 School of Electronic Engineering and Computer Science, Queen Mary University of London, London E1 4NS, U.K.
\par
Corresponding author: Barbaros Yet (barbaros.yet@hacettepe.edu.tr)
\par
This work was supported in part by the ERC Project under Grant ERC-2013-AdG339182 BAYES\_KNOWLEDGE, and in part by EPSRC
\par
Project under Grant EP/P009964/1: PAMBAYESIAN
\par
ABSTRACT In decision theory models, expected value of partial perfect information (EVPPI) is an
\par
important analysis technique that is used to identify the value of acquiring further information on individual
\par
variables. EVPPI can be used to prioritize the parts of a model that should be improved or identify the parts
\par
where acquiring additional data or expert knowledge is most beneficial. Calculating EVPPI of continuous
\par
variables is challenging, and several sampling and approximation techniques have been proposed. This paper
\par
proposes a novel approach for calculating EVPPI in hybrid influence diagram (HID) models (these are
\par
influence diagrams (IDs) containing both discrete and continuous nodes). The proposed approach transforms
\par
the HID into a hybrid Bayesian network and makes use of the dynamic discretization and the junction tree
\par
algorithms to calculate the EVPPI. This is an approximate solution (no feasible exact solution is possible
\par
generally for HIDs) but we demonstrate it accurately calculates the EVPPI values. Moreover, unlike the
\par
previously proposed simulation-based EVPPI methods, our approach eliminates the requirement of manually
\par
determining the sample size and assessing convergence. Hence, it can be used by decision-makers who do
\par
not have deep understanding of programming languages and sampling techniques. We compare our approach
\par
to the previously proposed techniques based on two case studies.
\par
INDEX TERMS Bayesian networks, dynamic discretization, expected value of partial perfect information,
\par
hybrid influence diagrams, value of information.
\par
I. INTRODUCTION
\par
Value Of Information (VOI) is a powerful technique in deci-
\par
sion analysis that identifies and prioritizes the parts of a
\par
decision model where additional information is expected
\par
to be useful. Specifically, VOI identifies the potential
\par
gain that could be acquired when the state of a currently
\par
unknown variable becomes known before the decision is
\par
made [1].
\par
A convenient, but rather ineffective, VOI technique is
\par
called the Expected Value of Perfect Information (EVPI)
\par
which provides an aggregate measure showing the expected
\par
gain when we have perfect information about the states of
\par
all the variables in the model. EVPI can be easily computed
\par
with sampling methods, but its benefits are limited. A deci-
\par
sion analyst is normally interested in the value of acquiring
\par
additional information on specific individual variables rather
\par
than an aggregate value over all variables. In such cases,
\par
the Expected Value of Partial Perfect Information (EVPPI)
\par
is used to measure the potential gain from the perfect infor-
\par
mation on individual (or subgroups) of variables. However,
\par
in contrast to the EVPI, computation of the EVPPI of contin-
\par
uous variables can be difficult. Several techniques (which we
\par
review in Section III) have been proposed [2]--[8]. These tech-
\par
niques were developed specifically for sampling-based mod-
\par
elling approaches. Although some have been implemented
\par
as R packages or online apps, they still require the user to
\par
compute the posteriors of their model by using sampling
\par
techniques. This requires technical knowledge and program-
\par
ming skills to undertake necessary modelling, computation
\par
and sampling to assess convergence. As a result, the use of
\par
these sampling-based techniques is limited to domains where
\par
such experts are available.
\par
In this paper, we present a novel approach for calculating
\par
EVPPI for individual variables using an extended type of
\par
Influence Diagram (ID) and recent developments in Bayesian
\par
inference algorithms. An ID is a probabilistic graphical model
\par
7802 This work is licensed under a Creative Commons Attribution 3.0 License. For more information, see http://creativecommons.org/licenses/by/3.0/ VOLUME 6, 2018B. Yet et al.: EVPPI in Hybrid Models Using Dynamic Discretization
\par
that is able to represent large decision problems in a com-
\par
pact way and is a powerful and flexible modelling tool for
\par
decision analysis [9]. IDs that contain both discrete and
\par
continuous variables are called Hybrid IDs (HIDs). Many
\par
popular decision analysis modelling tools, including Decision
\par
Trees (DTs), Markov Models (MMs) and Bayesian decision
\par
models, can be transformed into an equivalent ID (which we
\par
discuss in Section II). Recent advances in inference algo-
\par
rithms make it possible to solve increasingly complex HID
\par
models efficiently [10], [11]. As a result, IDs offer a flexible
\par
and powerful modelling tool for decision analysis. Novel
\par
contributions of this paper include the following:
\par
{$\bullet$} It proposes an EVPPI technique that uses a completely
\par
different approach than the previous sampling-based
\par
approaches for calculating EVPPI for individual vari-
\par
ables. Because our approach uses the Dynamic Dis-
\par
cretization (DD) and Junction Tree (JT) algorithms. it
\par
does not require users to assess convergence of its results
\par
since this is automatically handled by the underlying
\par
algorithm. This makes the proposed method accessible
\par
to a much wider class of end users who are interested in
\par
VOI analysis.
\par
{$\bullet$} It proposes approximations of the proposed method to
\par
trade-off accuracy with speed. The performance of the
\par
proposed approach and its approximations are evaluated
\par
in two case studies from the health-care domain. Each
\par
case study compares our approach and its approxima-
\par
tions with previous approaches in terms of accuracy,
\par
computation time and usability.
\par
The paper also illustrates how different decision modelling
\par
techniques that are commonly used in the health economics
\par
domain can be represented as an equivalent HID. As a result,
\par
our EVPPI approach can be applied to a wide variety of deci-
\par
sion problems as different modelling tools can be transformed
\par
into an HID.
\par
The case studies also illustrate the performance of DD in
\par
solving HIDs that have mixture distributions with constants
\par
for their utility distributions. Computing the posteriors of
\par
such models is challenging as their state space is likely to
\par
have point values. The DD algorithm removes states with zero
\par
mass to prevent their exponentiation.
\par
The paper is structured as follows: Section II provides an
\par
overview of IDs and discusses how other popular decision
\par
modelling techniques can be transformed into an ID. Section
\par
III reviews the previous methods for computing EVPPI, and
\par
shows how EVPPI is generally computed in IDs. Section
\par
IV presents our method for calculating EVPPI in HIDs.
\par
Section V illustrates its application to two case studies, and
\par
Section VI presents our conclusions.
\par
II. INFLUENCE DIAGRAMS (IDs)
\par
An ID is an extension of a Bayesian Network (BN) for
\par
decision problems. In this section, we give a recap of BNs
\par
and IDs, and show how other popular modelling approaches
\par
such as DTs and MMs can be represented as an ID.
\par
A. BAYESIAN NETWORKS (BNs)
\par
A BN is a probabilistic model that is composed of a graphical
\par
structure and a set of parameters. The graphical structure
\par
of a BN is a Directed Acyclic Graph (DAG). Each node
\par
of the DAG represents a random variable and each directed
\par
edge represents a relation between those variables. When two
\par
nodes, A and B, are connected by a directed edge A {$\rightarrow$}B,
\par
we call A a parent and B a child. Each child node has a
\par
set of parameters that defines its Conditional Probability
\par
Distribution (CPD) conditioned on its parents. If both the
\par
child node and its parent nodes are discrete nodes, the CPD
\par
is encoded in a Node Probability Table (NPT). BNs that
\par
contain both discrete and continuous nodes are called Hybrid
\par
BNs (HBNs).
\par
The graphical structure of a BN encodes conditional inde-
\par
pendence assertions between its variables. For example,
\par
a node is conditionally independent from the rest of the BN
\par
given that its parents, children and the parents of their chil-
\par
dren are observed (see Pearl [12] and Fenton and Neil [13]
\par
for more information on BNs and their conditional indepen-
\par
dence properties). The conditional independence assertions
\par
encoded in the DAG enables a BN to represent a complex
\par
joint probability distribution in a compact and factorized way.
\par
BNs have established inference algorithms that make exact
\par
and approximate inference computations by exploiting the
\par
conditional independence encoded in the structure. Popular
\par
exact algorithms, such as the JT algorithm [14], provide
\par
efficient computations for BNs with only discrete variables
\par
by transforming the BN structure into a tree structure with
\par
clusters. Exact solutions are also available for a class of HBNs
\par
in which the continuous nodes are Gaussian. While there is
\par
no feasible exact algorithm possible for computing general
\par
HBNs (i.e. without Gaussian distribution constraints), effi-
\par
cient and accurate approximate algorithms have recently been
\par
developed [10].
\par
B. INFLUENCE DIAGRAMS
\par
An ID is an extension of BNs for decision prob-
\par
lems [9], [15], [16]. While all nodes in a BN represent
\par
random variables, an ID has two additional types of nodes
\par
representing decisions and utilities. Thus, the types of nodes
\par
in this ID are:
\par
{$\bullet$} Chance Node: A chance node (drawn as an ellipse) is
\par
equivalent to a BN node. It represents a random variable
\par
and has parameters that define its CPD with its parents.
\par
We distinguish two classes of chance nodes in an ID:
\par
\textopenbullet{} Observable chance nodes,\textasciimacron{}
\par
O=O1,...,Op: These
\par
precede a decision and are observable at the time
\par
of, or before, the decision is made
\par
\textopenbullet{} Unobservable chance nodes,\textasciimacron{}
\par
N=N1...Nq.
\par
{$\bullet$} Decision Node: A decision node (drawn as a rectangle)
\par
represents a decision-making stage. An ID may contain
