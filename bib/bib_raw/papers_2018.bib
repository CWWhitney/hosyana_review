@article{eyvindsonGuidelinesRiskManagement2018,
  title = {Guidelines for Risk Management in Forest Planning --- What Is Risk and When Is Risk Management Useful?},
  author = {Eyvindson, Kyle and Kangas, Annika},
  year = 2018,
  month = apr,
  journal = {Canadian Journal of Forest Research},
  volume = {48},
  number = {4},
  pages = {NaN-NaN},
  issn = {0045-5067, 1208-6037},
  doi = {10.1139/cjfr-2017-0251},
  urldate = {2024-05-04},
  abstract = {Managing forest resources occurs under various sources of uncertainty. Depending on the management problem, this uncertainty may have a substantial impact on the quality of the solution. As our knowledge on the sources and magnitude of uncertainty improves, integrating this knowledge into the development of management plans becomes increasingly useful, as additional information can improve the decision-making process. This adjustment requires a fundamental shift in how planning problems are viewed: instead of interpreting risk management as a technique needed only for addressing problems with natural hazards, risk management should be an integral part of most planning problems. Managing risks can be linked to a variety of adaptive planning methods: to help mitigate risk, either plans should be revised as new information becomes available or the possibility of adaptation should be accounted for in preparing the plans. We conduct a brief examination of the key topics in risk management and highlight how risk management implies trade-offs. Several decision problems that incorporate risk management are analyzed, and alternative perspectives for the problem are suggested to better address risk management issues. We then provide a decision framework for considering how to integrate risk management practices into the forest planning process.},
  copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
  langid = {english},
  note = {Export Date: 05 May 2024; Cited By: 8},
  file = {/Users/corywhitney/Zotero/storage/TQAQJZKP/Eyvindson and Kangas - 2018 - Guidelines for risk management in forest planning .pdf}
}

