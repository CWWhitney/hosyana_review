@article{sledgeGuidedPolicyExploration2018,
  title = {Guided Policy Exploration for Markov Decision Processes Using an Uncertainty-Based Value-of-Information Criterion},
  author = {Sledge, Isaac J. and Emigh, Matthew S. and Pr{\'i}ncipe, Jos{\'e} C.},
  year = 2018,
  month = jun,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {29},
  number = {6},
  pages = {2080--2098},
  issn = {2162-2388},
  doi = {10.1109/TNNLS.2018.2812709},
  abstract = {Reinforcement learning in environments with many action-state pairs is challenging. The issue is the number of episodes needed to thoroughly search the policy space. Most conventional heuristics address this search problem in a stochastic manner. This can leave large portions of the policy space unvisited during the early training stages. In this paper, we propose an uncertainty-based, information-theoretic approach for performing guided stochastic searches that more effectively cover the policy space. Our approach is based on the value of information, a criterion that provides the optimal tradeoff between expected costs and the granularity of the search process. The value of information yields a stochastic routine for choosing actions during learning that can explore the policy space in a coarse to fine manner. We augment this criterion with a state-transition uncertainty factor, which guides the search process into previously unexplored regions of the policy space. We evaluate the uncertainty-based value-of-information policies on the games Centipede and Crossy Road. Our results indicate that our approach yields better performing policies in fewer episodes than stochastic-based exploration strategies. We show that the training rate for our approach can be further improved by using the policy cross entropy to guide our criterion's hyperparameter selection.},
  langid = {english},
  keywords = {information theory,information-theoretic exploration,Learning (artificial intelligence),Markov processes,Quantization (signal),reinforcement learning,Space exploration,Training,uncertainty-based exploration},
  note = {Publisher: IEEE},
  file = {/Users/corywhitney/Zotero/storage/T3E3CXHM/Sledge et al. - 2018 - Guided Policy Exploration for Markov Decision Proc.pdf;/Users/corywhitney/Zotero/storage/7WHGDVUW/8326734.html;/Users/corywhitney/Zotero/storage/I8XN8SBB/8326734.html;/Users/corywhitney/Zotero/storage/S8FWUSP2/8326734.html}
