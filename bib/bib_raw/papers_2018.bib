@article{parlatoPredictingReintroductionOutcomes2018,
  title = {Predicting Reintroduction Outcomes for Highly Vulnerable Species That Do Not Currently Coexist with Their Key Threats},
  author = {Parlato, Elizabeth H. and Armstrong, Doug P.},
  year = 2018,
  month = dec,
  journal = {Conservation Biology},
  volume = {32},
  number = {6},
  pages = {1346--1355},
  issn = {0888-8892, 1523-1739},
  doi = {10.1111/cobi.13096},
  urldate = {2024-05-04},
  abstract = {Abstract                            Predicting reintroduction outcomes before populations are released is inherently challenging. It becomes even more difficult when the species being considered for reintroduction no longer coexists with the key threats limiting its distribution. However, data from other species facing the same threats can be used to make predictions under these circumstances. We used an integrated Bayesian modeling approach to predict growth of a reintroduced population at a range of predator densities when no data are available for the species in the presence of that predator. North Island Saddlebacks (               Philesturnus rufusater               ) were extirpated from mainland New Zealand by exotic mammalian predators, particularly ship rats (black rats [               Rattus rattus               ]) but are now being considered for reintroduction to sites with intensive predator control. We initially modeled data from previous saddleback reintroductions to predator-free sites to predict population growth at a new predator-free site while accounting for random variation in vital rates among sites. We then predicted population growth at different rat-tracking rates (an index of rat density) by incorporating a previously modeled relationship between rat-tracking and vital rates of another predator-sensitive species, the North Island Robin (               Petroica longipes               ), and accounted for greater vulnerability of saddlebacks to rat predation based on information on historical declines of both species. The results allowed population growth to be predicted as a function of management effort while accounting for uncertainty, which means formal decision analysis could be used to decide whether to proceed with a reintroduction. Similar approaches could be applied to other situations where data on the species of interest are limited and provide an alternative to decision making based solely on expert judgment.                        ,                                            Pron\'ostico de los Resultados de la Reintroducci\'on de Especies con Vulnerabilidad Alta que Actualmente no Coexisten con las Amenazas Clave                                Resumen                                    El pron\'ostico de los resultados de reintroducci\'on antes de que se liberen las poblaciones es un reto intr\'inseco. Este se vuelve a\'un m\'as dif\'icil cuando la especie considerada para la reintroducci\'on ya no coexiste con las amenazas clave que limitan su distribuci\'on. Sin embargo, los datos de otras especies que enfrentan las mismas amenazas pueden usarse para realizar pron\'osticos bajo estas circunstancias. Usamos una estrategia de modelado bayesiano integrado para pronosticar el crecimiento de una poblaci\'on reintroducida en un rango de densidad de depredadores cuando no existen datos disponibles para la especie en presencia de dicho depredador. El tieke de Isla del Norte                   (Philesturnus rufusater)                   fue extirpado de la Nueva Zelanda continental por mam\'iferos ex\'oticos depredadores, particularmente ratas de barco                   (Rattus rattus)                   , pero ahora se est\'an considerando para la reintroducci\'on en sitios con control intensivo de depredadores. Inicialmente modelamos datos a partir de reintroducciones previas de tiekes en sitios libres de depredadores para predecir el crecimiento poblacional en un sitio nuevo libre de depredadores a la vez que se considera la variaci\'on al azar en las tasas vitales entre los sitios. Despu\'es pronosticamos el crecimiento poblacional a diferentes tasas de rastreo de ratas (un \'indice de densidad de ratas) incorporando una relaci\'on modelada previamente entre el rastreo de ratas y las tasas vitales de otra especie susceptible a depredadores, la petroica de Isla del Norte                   (Petroica longipes)                   , y consideramos la mayor vulnerabilidad del tieke a la depredaci\'on de ratas con base en la informaci\'on de las declinaciones hist\'oricas de ambas especies. Los resultados permitieron que se pronosticara el crecimiento poblacional como funci\'on del esfuerzo de manejo mientras que se tom\'o en cuenta la incertidumbre, lo que significa que el an\'alisis de decisiones formales podr\'ia usarse para decidir si se procede con la reintroducci\'on. Se podr\'ian aplicar estrategias similares a otras situaciones en las que los datos de la especie de inter\'es son limitados y proporcionar una alternativa a la toma de decisiones basada solamente en el juicio de expertos.                                                        ,              摘要                            在物种种群放归前预测重引入的结果本身就极具挑战。而当重引入物种目前不再与限制其分布的关键威胁共存时, 预测则变得更加困难。不过, 我们可以利用其它面临相同威胁的物种的数据来预测在这种情况下的结果。我们运用整合的贝叶斯建模方法预测了一个重引入种群在不同捕食者密度下的增长情况, 当没有改物种在捕食者存在情况下的数据时。新西兰北岛黑背鸥 (               Philesturnus rufusater)               受到外来哺乳动物捕食, 特别是由船带入的家鼠 (黑家鼠               Rattus rattus)               , 因而从新西兰大陆灭绝, 但现在正被考虑重引入到那些严格控制捕食者的位点。我们首先对之前黑背鸥重引入到没有捕食者位点的数据进行建模, 预测其在新的没有捕食者位点中的种群增长, 同时考虑到位点间死亡率的随机变异。接下来我们预测了在不同家鼠出现率 (家鼠密度指标) 下黑背鸥的种群增长, 这整合了已有的另一个对捕食者敏感的物种------新西兰北岛知更鸟 (               Petroica longipes)               的家鼠出现率与其死亡率的关系, 且根据这两个物种历史上的种群下降的资料, 认为黑背鸥对家鼠的捕食更加敏感。结果表明, 种群增长可以作为管理效力的函数进行预测, 同时将不确定性纳入考虑。这意味着可以通过正式的决策分析来决定是否继续进行重引入。类似的方法还可以应用于其它所关注物种的数据缺乏的情况, 为仅依靠经验判断进行决策提供了一种替代方法。               [翻译: 胡怡思;审校: 聂永刚]                        ,                             Article impact statement               : Reintroduction success can be predicted for vulnerable species using data from less vulnerable species that coexist with key threats.},
  langid = {english},
  keywords = {Bayesian,Bayesian Decision Analysis}
}

