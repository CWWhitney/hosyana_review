@article{fatoricKnowledgeCoproductionClimate2019,
  title = {Knowledge Co-Production in Climate Adaptation Planning of Archaeological Sites},
  author = {Fatori{\'c}, Sandra and Seekamp, Erin},
  year = 2019,
  month = jun,
  journal = {Journal of Coastal Conservation},
  volume = {23},
