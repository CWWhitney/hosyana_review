@article{yuLearningRoutingPolicies2019,
  title = {Learning Routing Policies in a Disrupted, Congestible Network with Real-Time Information: An Experimental Approach},
  shorttitle = {Learning Routing Policies in a Disrupted, Congestible Network with Real-Time Information},
  author = {Yu, Xinlian and Gao, Song},
  year = 2019,
  month = sep,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {106},
  pages = {205--219},
  issn = {0968-090X},
  doi = {10.1016/j.trc.2019.07.014},
  urldate = {2023-12-07},
  abstract = {The roles of learning, inertia and real-time travel information on route choices in a highly disrupted network are investigated, based on data from a laboratory competitive route choice game. Routing policies instead of simple paths are treated as the subject of learning when real-time travel information is available, where a routing policy is defined as a contingency plan that maps realized traffic conditions to path choices. A learning model based on the power law of forgetting and reinforcement is applied to calculate the perceived travel times of alternative routing policies, based on which choices are made. A deterministic correction to the Logit choice model in a learning context is developed to account for overlapping routing policies. Model parameter estimates are obtained from maximizing the likelihood of making the observed choices on the current day based on choices from all previous days. Prediction performance is measured in terms of both one-step and full-trajectory predictions, based on observed choices up to today, in which one-step prediction entails predicting the next day's choice, while full-trajectory prediction entails predicting the next K days' choices. Three major conclusions are drawn. First, the routing policy learning model can capture travelers' learning and choice behavior better than a path-based model under real-time travel information, as it accounts for travelers' forward-looking capabilities. Secondly, inertia exists where travelers stick to previously chosen routes and do not necessarily minimize travel time. Inertia plays a dominant role in one-step prediction, and a less important role in full-trajectory prediction, suggesting that learning is more important in longer term prediction. Thirdly, relative importance of learning compared with inertia is more prominent in a less uncertain, but not close to deterministic, environment. Therefore, decreasing uncertainty by providing real-time information could encourage learning and potentially more optimal decisions for individuals and the system.},
  langid = {english},
  keywords = {Instance-based learning,Policy choice,Real-time information},
  file = {/Users/corywhitney/Zotero/storage/BMDZ3MWM/S0968090X19302852.html}
}

@article{zgodicDifferentEvidenceSummaries2019,
  title = {Different Evidence Summaries Have Implications for Contextualizing Findings of Meta-Analysis of Diagnostic Tests},
  author = {Zgodic, Anja and Schmid, Christopher H. and Olkin, Ingram and Trikalinos, Thomas A.},
  year = 2019,
  month = may,
  journal = {Journal of Clinical Epidemiology},
  volume = {109},
  pages = {51--61},
  issn = {0895-4356},
  doi = {10.1016/j.jclinepi.2019.01.002},
  urldate = {2023-12-07},
  abstract = {Objective To evaluate diagnostic tests, analysts use meta-analyses to provide inputs to parameters in decision models. Choosing parameter estimands from meta-analyses requires understanding the meta-analytic and decision-making contexts. Study Design and Setting We expand on an analysis comparing positron emission tomography (PET), PET with computed tomography (PET/CT), and conventional workup (CW) in women with suspected recurrent breast cancer. We discuss Bayesian meta-analytic summaries (posterior mean over a set of existing studies, posterior estimate in an existing study, posterior predictive mean in a new study) used to estimate diagnostic test parameters (prevalence, sensitivity, specificity) needed to calculate quality-adjusted life years in a decision model contextualizing PET, PET/CT, and CW. Results The mean and predictive mean give similar estimates, but the latter displays greater uncertainty. Namely, PET/CT outperforms CW on average but may not do better than CW when implemented in future settings. Conclusion Selecting estimands for decision model parameters from meta-analyses requires understanding the relationship between decision settings and meta-analysis studies' settings, specifically whether the former resemble one or all study settings or represents new settings. We provide an algorithm recommending appropriate estimands as input parameters in decision models for diagnostic tests to obtain output parameters consistent with the decision context.},
  langid = {english},
  keywords = {Bayesian,Bayesian Decision Analysis,Predictive mean,Prevalence,Quality-adjusted life years,Sensitivity,Specificity},
  file = {/Users/corywhitney/Zotero/storage/T8BQ8IY4/S0895435617309320.html}
}

@article{zhangIncentiveContractDesign2019,
  title = {Incentive Contract Design for the Water-Rail-Road Intermodal Transportation with Travel Time Uncertainty: A Stackelberg Game Approach},
  shorttitle = {Incentive Contract Design for the Water-Rail-Road Intermodal Transportation with Travel Time Uncertainty},
  author = {Zhang, Wenying and Wang, Xifu and Yang, Kai},
  year = 2019,
  month = feb,
  journal = {Entropy},
  volume = {21},
  number = {2},
  pages = {161--181},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {1099-4300},
  doi = {10.3390/e21020161},
  urldate = {2023-12-07},
  abstract = {In the management of intermodal transportation, incentive contract design problem has significant impacts on the benefit of a multimodal transport operator (MTO). In this paper, we analyze a typical water-rail-road (WRR) intermodal transportation that is composed of three serial transportation stages: water, rail and road. In particular, the entire transportation process is planned, organized, and funded by an MTO that outsources the transportation task at each stage to independent carriers (subcontracts). Due to the variability of transportation conditions, the travel time of each transportation stage depending on the respective carrier's effort level is unknown (asymmetric information) and characterized as an uncertain variable via the experts' estimations. Considering the decentralized decision-making process, we interpret the incentive contract design problem for the WRR intermodal transportation as a Stackelberg game in which the risk-neutral MTO serves as the leader and the risk-averse carriers serve as the followers. Within the framework of uncertainty theory, we formulate an uncertain bi-level programming model for the incentive contract design problem under expectation and entropy decision criteria. Subsequently, we provide the analytical results of the proposed model and analyze the optimal time-based incentive contracts by developing a hybrid solution method which combines a decomposition approach and an iterative algorithm. Finally, we give a simulation example to investigate the impact of asymmetric information on the optimal time-based incentive contracts and to identify the value of information for WRR intermodal transportation.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {intermodal transportation,stackelberg game,uncertain theory},
  note = {\textbf{\emph{entropy}}
\par
Article
\par
Incentive Contract Design for the Water-Rail-Road
\par
Intermodal Transportation with Travel Time
\par
Uncertainty: A Stackelberg Game Approach
\par
Wenying Zhang 1, Xifu Wang 1,* and Kai Yang 1,2,*
\par
1 School of Traffic and Transportation, Beijing Jiaotong University, Beijing 100044, China;
\par
zhangwenying@chinabata.cn
\par
2 School of Mathematical Sciences, Monash University, Clayton VIC 3800, Australia
\par
* Correspondence: xfwang1@bjtu.edu.cn (X.W.); kaiyang@bjtu.edu.cn (K.Y.)
\par
Received: 26 December 2018; Accepted: 7 February 2019; Published: 9 February 2019
\par
Abstract: In the management of intermodal transportation, incentive contract design problem has
\par
significant impacts on the benefit of a multimodal transport operator (MTO). In this paper, we analyze a
\par
typical water-rail-road (WRR) intermodal transportation that is composed of three serial transportation
\par
stages: water, rail and road. In particular, the entire transportation process is planned, organized,
\par
and funded by an MTO that outsources the transportation task at each stage to independent carriers
\par
(subcontracts). Due to the variability of transportation conditions, the travel time of each transportation
\par
stage depending on the respective carrier's effort level is unknown (asymmetric information) and
\par
characterized as an uncertain variable via the experts' estimations. Considering the decentralized
\par
decision-making process, we interpret the incentive contract design problem for the WRR intermodal
\par
transportation as a Stackelberg game in which the risk-neutral MTO serves as the leader and the
\par
risk-averse carriers serve as the followers. Within the framework of uncertainty theory, we formulate
\par
an uncertain bi-level programming model for the incentive contract design problem under expectation
\par
and entropy decision criteria. Subsequently, we provide the analytical results of the proposed model
\par
and analyze the optimal time-based incentive contracts by developing a hybrid solution method which
\par
combines a decomposition approach and an iterative algorithm. Finally, we give a simulation example to
\par
investigate the impact of asymmetric information on the optimal time-based incentive contracts and to
\par
identify the value of information for WRR intermodal transportation.
\par
Keywords: intermodal transportation; asymmetric information; stackelberg game; uncertain
\par
theory; entropy
\par
1. Introduction
\par
Water-rail-road (WRR) intermodal transportation is defined as a system that transfers the cargo from
\par
an origin to a destination in one and the same intermodal transportation unit (e.g., a twenty-foot equivalent
\par
unit (TEU) container) without handling of the goods themselves when changing modes by using three
\par
different means of transport: water, rail and road. Compared to the unimodal one, the basic features of the
\par
WRR intermodal transportation are: (1) the entire transportation process can be divided into a series of
\par
sequential transportation stages; (2) three transportation modes are used for the carriage of cargos; (3) one
\par
party, usually called multimodal transport operator (MTO), is responsible for the entire carriage and acts
\par
as a principal. In particular, the MTO does not own any means of transport, and needs to outsource
\par
Entropy 2019, 21, 161; doi:10.3390/e21020161 www.mdpi.com/journal/entropyEntropy 2019, 21, 161 2 of 20
\par
to specialized subcontractors who act as agents for all modes of transport in order to fulfill the whole
\par
intermodal transportation chain. These subcontractors (carriers) might be a waterway operator, a railway
\par
operator and a road haulier. Motivated by this, the study presented in this paper focuses on designing
\par
contracts for the carriers engaging in the WRR intermodal transportation from the MTO's perspective.
\par
By being an experienced organizer in making optimal combinations of different modes of transport,
\par
the MTO is responsible for the cargo-owner in the business of the WRR intermodal transportation, and
\par
for the cargo's complete journey from its original place of dispatch to its ultimate destination. Due to
\par
the competitive environment in the market, the MTO pays more attention to reducing the door-to-door
\par
delivery time, which is the total travel time of three serial transportation stages. One of the major reasons
\par
for the fastest possible delivery is that the MTO wants the container to come back as soon as possible after
\par
the delivery of cargo so that he can have a higher utilization ratio of the container and eventually earn
\par
more freight. With such a concern, this paper aims at designing the time-based contracts offered by MTO
\par
for the carriers to satisfy the cargo-owner's needs by providing the optimized door-to-door services with
\par
shorter delivery time.
\par
In general, the travel time of each transportation stage depends on the respective carrier's effort
\par
level, which is a broad concept and has been widely used in the economics and management field.
\par
In the intermodal transportation context, the effort level can be interpreted as the amount of human,
\par
material and financial resources required to effectively improve transport capacity and efficiently complete
\par
transportation task. For example, the carrier will incur a cost for assigning more drivers and upgrading
\par
means of transport to shorten the travel time. As a matter of fact, there exists information asymmetry
\par
between the MTO and the carriers because of maximizing their respective utilities in the decentralized
\par
decision-making system. That is, the effort level is not only the carrier's private information and unknown
\par
to the MTO, but it is also at a cost to the carrier, and the carrier may not provide the effort level that
\par
the MTO desires. This may lead to conflict between the carriers and the MTO and delay the travel
\par
time. In the real situation, the carrier may ascribe the delay in delivery to the natural causes or force
\par
majeure rather than his possible ``lazy'' behavior because the MTO cannot directly observe his action
\par
(i.e., no sharing of information). Technically, one way of addressing this issue is for the MTO to introduce
\par
communication and information technology for cargo tracking. On the other hand, from the operational
\par
management point of view, the MTO can offer incentive contracts to the carriers based on the travel time
\par
of their transportation stages to ensure that the carriers invest adequate efforts. Moreover, designing
\par
the time-based incentive contract for WRR intermodal transportation is a decentralized decision-making
\par
process that can be analyzed as a Stackelberg game in which the risk-neutral MTO serves as the leader and
\par
the risk-averse carriers serve as the followers. With such a concern, the major purpose of this paper is to
\par
develop a Stackelberg game approach to formulate the time-based incentive contract design problem for
\par
WRR intermodal transportation.
\par
Mathematically, the process of designing a time-based incentive contract can be modeled as a bi-level
\par
programming problem. In the real world, due to the variability of transportation conditions (e.g., accidents,
\par
failures and weather changes), the travel time of each transportation mode (stage) is not precisely known in
\par
advance, thus, probability theory, fuzzy theory and uncertainty theory have been introduced to overcome
\par
this issue. In some cases, sufficient historical data are known for travel time parameters and can be used
\par
to characterize stochastic (objective) uncertainty by using stochastic programming techniques. However,
\par
the travel times cannot be exactly predicted in advance when the MTO contracts with the carriers for the
\par
first time. That is, no information about their probability distributions is known except for the experiences
\par
and judgments of field experts, one must rely on fuzzy theory or uncertainty theory to handle the uncertain
\par
information. However, some surveys showed that subjective uncertainty cannot be modeled by fuzzy
\par
variables (numbers). This means that some real problems cannot be processed by fuzzy theory, because the
\par
possibility measure has no self-duality property. Doing away with the self-duality property in mathematicsEntropy 2019, 21, 161 3 of 20
\par
may lead to counterintuitive results for modeling uncertain travel times (see Appendix A for details).
\par
In order to deal with this type of uncertainty, Liu [1] founded an uncertainty theory that is a branch of
\par
mathematics based on normality, monotonicity, self-duality, and countable subadditivity axioms. Within
\par
the framework of uncertainty theory, we introduce a new version of utility function named mean-entropy
\par
form as a measure of risk in which the entropy is more general than variance because entropy is free from
\par
reliance on symmetrical uncertain distributions. Therefore, this paper aims to formulate an uncertain
\par
bi-level programming model for the time-based incentive contract design problem in a WRR intermodal
\par
transportation setting under expectation and entropy decision criteria.
\par
1.1. Literature Review
\par
This section presents a review of literature on the intermodal transportation problem, the contract
\par
theory and the uncertain theory.
\par
The first stream studies the intermodal transportation problem. The intermodal transportation is
\par
defined as the transportation of a load from its origin to its destination by a sequence of at least two
\par
transportation modes, in which the transfer from one mode to the next is performed at an intermodal
\par
terminal [2]. Caris et al. [3] proposed new research themes concerning decision support for private
\par
stakeholders as well as for public actors such as policy makers and port authorities in intermodal transport.
\par
Lam and Gu [4] focused on developing innovative approaches in the area of enhanced intermodal network
\par
design provided by freight integrators, which are to address cost minimisation, transit time minimisation,
\par
and carbon footprint to better meet market needs. Verma and Verter [5] presented an analytical framework
\par
for planning rail-truck intermodal transportation of hazmats, where a bi-objective optimization model
\par
to plan and manage intermodal shipments is developed. Wang and Meng [6] considered a discrete
\par
intermodal network design problem for freight transportation, in which the network planner needs to
\par
minimize the total operating cost of carriers and hub operators under a general route choice model of
\par
intermodal operators. Abbassi et al. [7] developed a new mathematical formulation and two solution
\par
approaches for an intermodal transportation problem of agricultural products from Morocco to Europe to
\par
minimise the transportation cost and the maximal overtime to delivery products. Wang et al. [8] presented
\par
a bi-objective optimization formulation for the hub-and-spoke based road-rail intermodal transportation
\par
network design problem by taking into account the expected value criterion and the critical value criterion.
\par
For a detailed review of the intermodal transportation problem and its variations, interested readers can
\par
refer to Arias and Fuentes [9] and Crainic et al. [10].
\par
The second stream of literature related to our work is on the contract theory. Contract theory (Nobel
\par
Memorial Prize in Economic Sciences 2016) has been highly successful and there are active research areas
\par
in economics, finance and management. For example, Hart and Moore [11] explored whether the parties
\par
can make up for this incompleteness to some extent by building into their contract a mechanism for
\par
revising the terms of trade as each party receives information about benefits and costs. Holmstr\"om [12]
\par
studied efficient contractual agreements in a principal-agent relationship under various assumptions
\par
about what can be observed, and hence contracted upon, by both parties. Bolton and Scharfstein [13]
\par
analyzed the optimal financial contract to balance the benefit of deterring predation by relaxing financial
\par
constraints against the cost of exacerbating incentive problems. Christensen et al. [14] reviewed theoretical
\par
and empirical work on financial contracting that is relevant to accounting researchers and discussed how
\par
the use of accounting information in contracts enhances contracting efficiency. Grinblatt and Titman [15]
\par
presented conditions for contract parameters that provide proper risk incentives for classes of investment
\par
strategies. Chao et al. [16] discussed two contractual agreements by which product recall costs can be
\par
shared between a manufacturer and a supplier to induce quality improvement effort. For learning contract
\par
theory, we refer the interested reader to Bolton and Dewatripont [17].Entropy 2019, 21, 161 4 of 20
\par
The third stream considers the uncertain theory. After the word ``randomness'' was used to represent
\par
probabilistic phenomena, Knight [18] and Keynes [19] started to use the word ``uncertainty'' to represent
\par
any non-probabilistic phenomena. The academic community also calls it Knightian uncertainty, Keynesian
\par
uncertainty, or true uncertainty. As the scientific terminology evolves, the concept of uncertainty had
\par
been interpreted either in terms of degrees of conviction [20], or as relative frequencies [21]. The latest
\par
development was uncertainty theory founded by Liu [1] and refined by Liu [22] based on normality, duality,
\par
subadditivity and product axioms. Since then, many experts and scholars began to pay attention to it and
\par
investigated it [23--31]. Based on uncertain theory, Liu [22] presented the uncertain programming. With the
\par
pioneering work of Liu [22], some work has been done on the extension of uncertain programming,
\par
such as in multilevel programming [32], multi-objective programming [33] and goal programming [34].
\par
Recently, uncertain theory has been used to develop the contract theory by several authors. For example,
\par
Mu et al. [35] established an uncertain contract model for the rural migrant worker's employment problem
\par
to maximize the enterprise's expected utility. Wang et al. [36] presented an uncertain contract model for
\par
the price discrimination problem in labor market to maximize the employer's expected welfare. Wu et al.
\par
[37] discussed an uncertain contract problem with multi-dimensional incomplete information based on
\par
the critical value criterion. Wang et al. [38] presented four classes of uncertain contract models in a project
\par
management setting based on the expected value and the critical value criteria. Yang et al. [39] built two
\par
classes of uncertain contract models for new product development and derived their respective optimal
\par
incentive contracts. Fu et al. [40] considered an uncertain contract problem to implement an R\&D project
\par
through a menu of incentive contracts.
\par
To clarify the novel features of this study, we detail the related research gaps of our paper as follows:
\par
{$\bullet$} This paper is distinct from the aforementioned work in that we consider an intermodal transportation
\par
decentralized setting that can be analyzed as a Stackelberg game in which the risk-neutral MTO
\par
serves as the leader and the risk-averse carriers serve as the followers from the point of view of
\par
microeconomics.
\par
{$\bullet$} This is the first work in which the WRR intermodal transportation has been considered to evaluate
\par
the uncertain travel time by domain expert's knowledge, experience and professional feelings rather
\par
than the probability which is on the basis of large sample size.
\par
{$\bullet$} There are no works addressing the uncertain contract problem in a WRR intermodal transportation
\par
context. Hence, to fill this gap, this paper presents an uncertain bi-level programming approach
\par
to formulate the time-based incentive contract design model for WRR intermodal transportation
\par
uncertain travel time uncertainty.
\par
1.2. Research Contributions and Outline
\par
According to above-mentioned reasons, this study highlights some new points for the first time in the
\par
WRR intermodal transportation area which can be useful for both academics and practitioners. The main
\par
contributions of this study are outlined as follows:
\par
{$\bullet$} This paper employs uncertain variables to capture the characteristics of subjective uncertainty within
\par
a WRR intermodal transportation field based on uncertainty theory. By doing so, the uncertain travel
\par
time can be directly handled in the proposed modeling framework. Furthermore, the uncertain
\par
distributions are flexible and diversified forms to quantify the travel time uncertainty when no
\par
samples (sufficient historical data) are available.
\par
{$\bullet$} This paper adopts the expected utility and the mean-entropy utility functions to characterize MTO
\par
and carriers' profits, respectively. In particular, the MTO's objective based on the expected utility
\par
function is to maximize the expected profit. For the carriers, the entropy is used as a synonym for riskEntropy 2019, 21, 161 5 of 20
\par
in the sense that uncertainty causes loss. Based on this, the mean-entropy utility allows the carrier to
\par
maximize the linear combination of expected value and entropy of the carrier's profit. Under these
\par
two decision criteria, this paper presents an uncertain bi-level programming model to design the
\par
time-based incentive contracts offered by the MTO.
\par
{$\bullet$} This paper develops a hybrid solution method by combining a decomposition method and an
\par
iterative algorithm to obtain the parameters of the optimal time-based incentive contract and to
\par
further identify the value of information. More specifically, the former approach divides the original
\par
model into three sub-models by taking advantage of the structural characteristics. The latter approach
\par
is to interactively solve the upper-level and lower-level programming problems in the equivalent
\par
deterministic sub-models for deriving the analytical results of the proposed model.
\par
The rest of the paper is organized as follows. Section 2 describes a modeling framework and presents
\par
an uncertain bi-level programming model to design the incentive contract for the WRR intermodal
\par
transportation. Section 3 derives the optimal time-based incentive contracts under symmetric and
\par
asymmetric information and explores the effect of information asymmetry. Section 4 conducts a simulation
\par
example to complement our analytical results. Finally, Section 5 provides conclusions and suggestions
\par
for future studies. Preliminaries on uncertainty theory and proofs of all theorems are relegated to the
\par
appendix for clarity of presentation.
\par
2. Model Development and Description
\par
In this section, we consider an MTO who is responsible for the entire WRR intermodal transportation
\par
consisting of three stages that can be transported by the water, rail and road carriers in sequence (see
\par
Figure 1). Aligning the conflicting goals of the MTO and carriers in the decentralized decision-making
\par
process is one of the major challenges and the purpose of most contracts. In reality, there is asymmetry
\par
information between the MTO and three carriers. That is, the carriers know their effort levels to accelerate
\par
their respective transportation stages, but the MTO cannot directly and fully observe how much efforts
\par
the carriers spend to shorten the travel time of their transportation stages. From the perspective of the
\par
carrier, the effort level can be measured by the amount of human, material and financial resources spent in
\par
improving transport capacity and accomplishing transportation task. As a result, the MTO should take
\par
the lead to design and offer incentive contracts to the carriers. In this way, we can model the contracting
\par
process as a Stackelberg game. Therefore, the sequence of the events in our model is described as follows:
\par
{$\bullet$} In Step 1, the MTO offers a take-it-or-leave-it incentive contract to three carriers simultaneously.
\par
{$\bullet$} In Step 2, three carriers accept or reject their contracts. If they accept, the water carrier first chooses
\par
his effort level. Then, the rail carrier chooses his effort level after the water carrier has completed his
\par
transportation stage, and the road carrier chooses his effort level after the rail carrier has completed
\par
his transportation stage. If they reject, go back to Step 1.
\par
{$\bullet$} In Step 3, the MTO pays the carriers based on their realized travel times.
\par
Next, we propose an uncertain bi-level programming approach to formulate the incentive contract
\par
design model for the WRR intermodal transportation under uncertainty. In the following discussion, we
\par
explicitly elaborate each part of the formulation, including the notations, decision variables, assumptions,
\par
objective functions and constraints.
