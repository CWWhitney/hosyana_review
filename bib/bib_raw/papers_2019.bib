@article{zhuResearchDuplicateCombined2019,
  title = {Research on Duplicate Combined Forecasting Method Based on Supply Chain Coordination},
  author = {Zhu, Yanxin and Li, Sujian and Peng, Yongfang},
  year = 2019,
  month = may,
  journal = {Cluster Computing},
  volume = {22},
  number = {3},
  pages = {NaN-NaN},
  issn = {1573-7543},
  doi = {10.1007/s10586-018-2356-z},
  urldate = {2023-12-08},
  abstract = {The coordinated forecast of agricultural means supply chain not only needs cooperation and information sharing among different parties but also needs scientific forecast methods and means. This paper firstly builds the synergetic framework of demand forecast and analyzes the key factors of demand forecast coordination in different forecast stages and then confirms duplicate combined forecast method for time series based on the factors which influence the demand of agricultural means. GM(1,1) is used in the model to forecast the fluctuant items of long-term trend; BP neural network and ARMA are used to simulate periodically fluctuant items. Particle swarm algorithm is used to confirm the combined forecast model of periodically fluctuant items. Finally, a calculating example is used to compare the forecast precision of the combined forecast model, GM(1,1), BP neural network model and ARMA model. In conclusion, duplicate combined forecast model is applicable to forecasting the demand of agricultural means which are influenced by long-term trend and periodically fluctuant factors.},
  langid = {english},
  keywords = {Particle swarm algorithm,Supply chain coordination},
  note = {Cluster Computing (2019) 22:S6621--S6632
\par
https://doi.org/10.1007/s10586-018-2356-z(0123456789().,-volV) (0123456789(). ,- volV)
\par
Research on duplicate combined forecasting method based on supply
\par
chain coordination
\par
Yanxin Zhu1,2 {$\bullet$} Sujian Li1
\par
{$\bullet$} Yongfang Peng2
\par
Received: 6 January 2018 / Revised: 25 February 2018 / Accepted: 1 March 2018 / Published online: 7 March 2018
\par
\'O Springer Science+Business Media, LLC, part of Springer Nature 2018
\par
Abstract
\par
The coordinated forecast of agricultural means supply chain not only needs cooperation and information sharing among
\par
different parties but also needs scientific forecast methods and means. This paper firstly builds the synergetic framework of
\par
demand forecast and analyzes the key factors of demand forecast coordination in different forecast stages and then
\par
confirms duplicate combined forecast method for time series based on the factors which influence the demand of agri-
\par
cultural means. GM(1,1) is used in the model to forecast the fluctuant items of long-term trend; BP neural network and
\par
ARMA are used to simulate periodically fluctuant items. Particle swarm algorithm is used to confirm the combined forecast
\par
model of periodically fluctuant items. Finally, a calculating example is used to compare the forecast precision of the
\par
combined forecast model, GM(1,1), BP neural network model and ARMA model. In conclusion, duplicate combined
\par
forecast model is applicable to forecasting the demand of agricultural means which are influenced by long-term trend and
\par
periodically fluctuant factors.
\par
Keywords Demand of agricultural means Supply chain coordination Grey forecast Combined forecast model
\par
Particle swarm algorithm
\par
1 Introduction
\par
Since supply chain management concept and technique is
\par
used in large quantity of enterprises, the issue of supply
\par
chain coordination becomes increasingly prominent. After
\par
Wal-Mart and some other companies put forward the
\par
supply chain management technique of coordinated plan,
\par
forecast and replenishment (CPFR), the issue of supply
\par
chain coordination has become a focus issue any enterprise
\par
cannot avoid. As the core of CPFR, coordinated forecast is
\par
the basis of coordinated plan and coordinated storage. The
\par
coordinated forecast made through cooperation of supply
\par
chain members can offer reference for downstream and
\par
upstream enterprises of supply chain to make a series of
\par
plans of purchase and production and make decisions of
\par
logistics. The coordinated forecast is for the purpose of
\par
raising operation efficiency of supply chain, decreasing
\par
storage and raising the degree of customers' satisfaction.
\par
In actual forecast, it is not possible for single forecast
\par
model to consider all factors because of the large quantity
\par
of influencing factors. In addition, it is difficult to deter-
\par
mine the precise relationship among many parameters in
\par
the model. A combination of multiple prediction methods
\par
needs to be combined to predict, so as to improve the
\par
prediction accuracy as much as possible, and to improve
\par
the prediction performance. Therefore, on the bases of
\par
features of agricultural means demand and the coordinated
\par
forecast framework of agricultural means supply chain, this
\par
paper focuses on the forecast on demand of agricultural
\par
means circulation enterprises and uses duplicate optimizing
\par
combined forecast technique to analyze it and get good
\par
effect of forecast.
\par
\& Yanxin Zhu
\par
zhuyanxin2006@yeah.net
\par
1 Mechanical Engineering College, University of Science \&
\par
Technology Beijing (USTB), Beijing, China
\par
2 Commercial College, Hebei GEO University, Shijiazhuang,
\par
China
\par
123S6622 Cluster Computing (2019) 22:S6621--S6632
\par
2 Literature review
\par
In order to improve the supply chain performance under the
\par
condition of demand uncertainty, Lee [1] suggests that
\par
enterprises in the same supply chain share information and
\par
adjust orders, which requires more reasonable demand
\par
forecasting. However, Ali [2] argues that because of the
\par
constraints of information system compatibility, informa-
\par
tion quality, trust and confidentiality, there may be many
\par
supply chains in which information may not be shared.
\par
Therefore, a new type of technology called downstream
\par
demand reasoning (DDI) Strategy to compare the DDI
\par
strategy with the best Information Sharing (NIS) strategy
\par
and the best FIS strategy in the supply chain. Case studies
\par
show that using DDI strategies can improve NIS. Helena
\par
and Patrik [3] described the extent of supplier access to
\par
customer forecast information and the perceived quality of
\par
the information,and then explained the impact of forecast
\par
information access and forecast information quality of
\par
supply chain performance. Based on the game theory,
\par
Dong et al. [4] analyzed the profit distribution mechanism
\par
of collaborative demand forecasting, quantitatively ana-
\par
lyzed the overall profitability coefficient of supply chain
\par
collaborative demand forecasting, proposed a dynamic
\par
incentive mechanism considering the benefits and costs,
\par
and also qualitatively analyzed the core enterprises'
\par
Information sharing and trust mechanisms.
\par
At present, most of the research on demand forecasting
\par
is often limited to a single level of the supply chain or
\par
multi-level inventory management but assumes that all
\par
enterprises use the same inventory strategy [5]. There is not
\par
much research on the demand forecasting of multi-level
\par
supply chain using different inventory systems [6]. Rajesh
\par
[7] proposed an improved gray prediction model to predict
\par
the periodic index of elastic properties,and applied it to the
\par
supply chain forecast of Indian electronic manufacturers,
\par
which proved that the model had a good prediction effect.
\par
Li and Gao [8] established a two-supplier-single-manu-
\par
facturer synergetic supply model with uncertain delivery
\par
time and demand price-time sensitivity. The results show
\par
that the supply chain benefits of the collaborative supply
\par
decision should be obvious which is larger than that of the
\par
supply chain without considering the cooperative supply
\par
decision. However, the optimal product sales price of the
\par
manufacturer and the optimal agreement lead time of the
\par
supplier under the collaborative supply decision are both
\par
less than those without considering the collaborative
\par
decision. Chen et al. [9] quantitatively analyzed the bull-
\par
whip effect in a single supply chain from the aspects of
\par
prediction, lead time and information. Joshi et al. [10]
\par
empirically analyzed how adaptive collaboration in supply
\par
chain management impacts demand forecast accuracy,and
\par
applied ANOVA and ordered feature evaluation analysis
\par
(OFEA) to analyze the main effects and specific interaction
\par
effects of all variables. Cheng and Duan [11] studied the
\par
coordination of three-level supply chain composed of
\par
manufacturers, distributors and retailers under the random
\par
market demand. Through the comparison of the supply
\par
chain benefits under decentralized and uncoordinated
\par
states, the Qd-Ps joint contract model was designed by
\par
using the double discounts mechanism of quantity discount
\par
and price subsidy. Then, they used cases to prove that
\par
through the reasonable range of parameter setting and
\par
value, the profit sharing of supply chain nodes enterprises
\par
can be realized and the supply chain system can be effec-
\par
tively coordinated.
\par
Currently, there are two methods of forecasting the
\par
demand in supply chain: one is linear forecast method
\par
based on time series analysis, including moving averages,
\par
exponential smoothing, regression analysis and autore-
\par
gressive conditions heteroskedasticity (ARCH). Corre-
\par
sponding time series forecast means is used to quantify
\par
bullwhip effect. The other is nonlinear forecast method.
\par
The method is applicable to uncertain, nonlinear and
\par
unstable time series analysis. Short-term demand of market
\par
can be accurately forecast. Frequently-used forecast
\par
methods are grey forecast method, neural network forecast
\par
method and SVM forecast method [12]. GM(1,1) can well
\par
simulate the trend part of time series. As for periodical
\par
fluctuation factor, the precision of forecast is very low [13].
\par
BP neural network is widely used for forecasting time
\par
series. As for periodical fluctuation factor, the effect of
\par
forecast is especially ideal but it ignores some loud noise
\par
[14]. ARIMA (Autoregressive Moving Average Model) is
\par
a very effective method for analyzing time series. It can
\par
evaluate the randomness, stability and seasonality of time
\par
series. The method requires time series to be stable after
\par
being differentiated. Besides, it is difficult to confirm the
\par
accurate relation among parameters in model. Therefore,
\par
several forecast methods shall be combined to raise pre-
\par
cision of forecast and improve forecast performance. In
\par
short, it is difficult to obtain the accurate demand forecast
\par
due to uncertainty of the supply chain environment and the
\par
complexity of its own structure. The extensive existence of
\par
bullwhip effect has caused a lot of resources waste. How to
\par
obtain high quality demand forecast is a difficult problem
\par
for enterprises. In this regard, enterprises not only need to
\par
choose a very effective synergetic strategy but also need to
\par
comprehensively apply a variety of forecasting methods to
\par
reduce the uncertainty of demand forecasting and improve
\par
the demand forecasting effect.
