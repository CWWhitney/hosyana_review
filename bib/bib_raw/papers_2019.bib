@article{palleyExtractingWisdomCrowds2019,
  title = {Extracting the Wisdom of Crowds When Information Is Shared},
  author = {Palley, Asa B. and Soll, Jack B.},
  year = 2019,
  month = may,
  journal = {Management Science},
  volume = {65},
  number = {5},
  pages = {2291--2309},
  publisher = {INFORMS},
  issn = {0025-1909},
  doi = {10.1287/mnsc.2018.3047},
  urldate = {2023-12-07},
  abstract = {Using the wisdom of crowds---combining many individual judgments to obtain an aggregate estimate---can be an effective technique for improving judgment accuracy. In practice, however, accuracy is limited by the presence of correlated judgment errors, which often emerge because information is shared. To address this problem, we propose an elicitation procedure in which respondents are asked to provide both their own best judgment and an estimate of the average judgment that will be given by all other respondents. We develop an aggregation method, called pivoting, which separates individual judgments into shared and private information and then recombines these results in the optimal manner. In several studies, we investigate the method and examine the accuracy of the aggregate estimates. Overall, the empirical data suggest that the pivoting method provides an effective judgment aggregation procedure that can significantly outperform the simple crowd average. Data and the online appendix are available at https://doi.org/10.1287/mnsc.2018.3047. This paper was accepted by Manel Baucells, decision analysis.},
  langid = {english},
  keywords = {judgment aggregation,shared information,wisdom of crowds}
}

