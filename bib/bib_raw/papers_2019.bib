@article{horganMakingMostInnovation2019,
  title = {Making the Most of Innovation in Personalised Medicine: An {{EU}} Strategy for a Faster Bench to Bedside and beyond Process},
  shorttitle = {Making the Most of Innovation in Personalised Medicine},
  author = {Horgan, Denis and Lal, Jonathan~A.},
  year = 2019,
