@article{stammActorsActionsUncertainties2019,
  title = {Actors, Actions, and Uncertainties: Optimizing Decision-Making Based on 3-{{D}} Structural Geological Models},
  shorttitle = {Actors, Actions, and Uncertainties},
  author = {Stamm, Fabian Antonio and {de la Varga}, Miguel and Wellmann, Florian},
  year = 2019,
