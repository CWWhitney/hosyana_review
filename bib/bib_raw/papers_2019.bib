@article{almutairiStakeholderMappingDisruption2019,
  title = {Stakeholder Mapping and Disruption Scenarios with Application to Resilience of a Container Port},
  author = {Almutairi, Ayedh and Collier, Zachary A. and Hendrickson, Daniel and {Palma-Oliveira}, Jos{\'e} M. and Polmateer, Thomas L. and Lambert, James H.},
