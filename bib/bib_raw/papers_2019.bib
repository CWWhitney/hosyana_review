@article{moosivandSupplyChainChallenges2019,
  title = {Supply Chain Challenges in Pharmaceutical Manufacturing Companies: Using Qualitative System Dynamics Methodology},
  shorttitle = {Supply Chain Challenges in Pharmaceutical Manufacturing Companies},
  author = {Moosivand, Asiye and Rajabzadeh Ghatari, Ali and Rasekh, Hamid Reza},
