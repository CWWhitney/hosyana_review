  langid = {english},
  keywords = {Risk,tax base,tax jurisdictions,tax optimization,tax rates,Value-added tax,VAT},
  file = {/Users/corywhitney/Zotero/storage/AZCCZ4DL/Akhmadeev et al. - 2019 - Targets determination model for VAT risks mitigati.pdf}
}

