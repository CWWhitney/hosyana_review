@article{broekhuizenPublicPreferencesLung2017,
  title = {Public Preferences for Lung Cancer Screening Policies},
  author = {Broekhuizen, Henk and {Groothuis-Oudshoorn}, Catharina G. M. and Vliegenthart, Rozemarijn and Groen, Harry and IJzerman, Maarten J.},
  year = 2017,
  month = jul,
  journal = {Value in Health},
  volume = {20},
  number = {7},
  pages = {NaN-NaN},
