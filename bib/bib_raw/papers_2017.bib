@article{wuInfluenceCustomerParticipation2017,
  title = {Influence of Customer Participation on Information Technology Services},
  author = {Wu, Jia-Jhou and Kung, Hung Yu and Lin, Tom M.Y.},
  year = 2017,
  month = jan,
  journal = {Industrial Management \& Data Systems},
  volume = {117},
  number = {6},
  pages = {1077--1092},
  publisher = {Emerald Publishing Limited},
  issn = {0263-5577},
  doi = {10.1108/IMDS-03-2016-0104},
  urldate = {2023-12-07},
  abstract = {Purpose The purpose of this paper is to investigate how customer participation (CP) influences the two contrasting relationship maintenance mechanisms: dedication and constraint, and identifies its antecedents in the context of business-to-business information technology (IT) services. Design/methodology/approach An empirical study was conducted through a survey of 126 firms receiving IT services in Taiwan. The partial least squares method was used to test the conceptual model of the study. Findings The results indicated that CP positively relates to IT service quality, thereby influencing satisfaction (i.e. dedication). In addition, CP was also found to be positively associated with switching costs (i.e. constraint). Both satisfaction and switching costs have significant influences on loyalty. Furthermore, IT capabilities, organizational compatibility, and role clarity are positively related to CP. Research limitations/implications Longitudinal studies are needed to explore how CP affects the dual mechanisms in different phases of customer-firm relationships. Originality/value The study contributes to a thorough understanding of the influences of CP on relationship maintenance.},
  langid = {english},
  keywords = {Loyalty,Satisfaction,Service quality,Switching costs,Value co-creation},
  file = {/Users/corywhitney/Zotero/storage/7GPGFVRM/html.html}
}

@article{wuIntegratedSustainabilityAssessment2017,
  title = {Integrated Sustainability Assessment of Public Rental Housing Community Based on a Hybrid Method of {{AHP-entropy}} Weight and Cloud Model},
  author = {Wu, Guangdong and Duan, Kaifeng and Zuo, Jian and Zhao, Xianbo and Tang, Daizhong},
  year = 2017,
  journal = {Sustainability},
  volume = {9},
  number = {4},
  pages = {603},
  publisher = {MDPI},
  urldate = {2023-12-06},
  langid = {english},
  note = {\textbf{\emph{sustainability}}
\par
Article
\par
Integrated Sustainability Assessment of Public Rental
\par
Housing Community Based on a Hybrid Method of
\par
AHP-Entropy Weight and Cloud Model
\par
Guangdong Wu 1,*, Kaifeng Duan 1, Jian Zuo 2, Xianbo Zhao 3 and Daizhong Tang 4,*
\par
1 School of Tourism and Urban Management, Jiangxi University of Finance \& Economics,
\par
Nanchang 330013, China; kefee920729@163.com
\par
2 School of Architecture and Built Environment; Entrepreneurship, Commercialisation and Innovation
\par
Centre (ECIC), The University of Adelaide, Adelaide 5005, Australia; jian.zuo@adelaide.edu.au
\par
3 School of Engineering and Technology, Central Queensland University, Sydney, NSW 2000, Australia;
\par
b.zhao@cqu.edu.au
\par
4 School of Economics and Management, Tongji University, Shanghai 200092, China
\par
* Correspondence: gd198410@163.com (G.W.); tdzhong@126.com (D.T.)
\par
Academic Editors: Umberto Berardi and Marc A. Rosen
\par
Received: 9 February 2017; Accepted: 11 April 2017; Published: 13 April 2017
\par
Abstract: As an essential part of a city, community is significant to the sustainable development of
\par
the city. At present, research on community sustainability assessment systems is relatively scarce.
\par
The existing community sustainability assessment systems often lack integrated consideration of
\par
community sustainability. For example, these systems especially place emphasis on the ecological
\par
and environmental aspects, but the economic and social aspects of sustainability are partially ignored.
\par
In order to comprehensively evaluate the sustainability of a community, this paper draws on the
\par
``participatory philosophy'' and constructs an integrated assessment indicator system that includes
\par
five dimensions: environment; economy; society; institution; and culture. On this basis, a new hybrid
\par
evaluation method based on analytical hierarchy process (AHP)-entropy weight and the cloud model
\par
is proposed to evaluate community sustainability. This method combines AHP and the entropy
\par
weight method to determine index weight, thus making full use of their respective advantages. At the
\par
same time, it makes use of the superiority of the cloud model to transform qualitative remarks into
\par
quantitative representations and to reflect fuzziness and randomness. To verify the feasibility of this
\par
method, a case study is carried out on the ``Minxinjiayuan'' public rental housing community in
\par
Chongqing, China. The results show that the overall sustainability of the community lies between
\par
the ``middle'' and ``good'' level, and closer to the ``middle'' level. The level of the economic and social
\par
sustainability is higher than that of the environmental, institutional and cultural sustainability.
\par
Keywords: AHP-entropy weight; cloud model; public rental housing community; sustainability
\par
assessment; indicator system
\par
1. Introduction
\par
Since the concept of ``sustainable development'' was defined in the Brundtland Report [1]
\par
in 1987, it has gradually been accepted by organizations and governments around the world [2]
\par
and spread to a variety of disciplines. The construction industry has significant impacts on the
\par
economy, society and natural environment due to its huge consumption of resources [3,4]. It is
\par
necessary to realize the transformation from traditional building to sustainable building [5]. Building
\par
sustainability assessment systems can help systematically evaluate the sustainability of the design,
\par
construction, operation and management stages of a building's whole life cycle [6]. It is one of the most
\par
important tools in promoting sustainable building development. Recently, more and more scholars
\par
