@article{grustamCareCoordinationBusinesstobusiness2017,
  title = {Care Coordination in a Business-to-Business and a Business-to-Consumer Model for Telemonitoring Patients with Chronic Diseases},
  author = {Grustam, Andrija S and Vrijhoef, Hubertus and Cordella, Antonio and Koymans, Ron and Severens, Johan L},
  year = 2017,
