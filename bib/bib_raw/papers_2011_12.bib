@article{schwarczReevaluatingStandardizedInsurance2011,
  title = {Reevaluating Standardized Insurance Policies},
  author = {Schwarcz, Daniel},
  year = 2011,
  journal = {The University of Chicago Law Review},
  volume = {78},
