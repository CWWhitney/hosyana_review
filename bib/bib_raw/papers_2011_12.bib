@article{zhangDecipheringWordofmouthSocial2012,
  title = {Deciphering Word-of-Mouth in Social Media: Text-Based Metrics of Consumer Reviews},
  shorttitle = {Deciphering Word-of-Mouth in Social Media},
  author = {Zhang, Zhu and Li, Xin and Chen, Yubo},
  year = 2012,
  month = apr,
  journal = {ACM Transactions on Management Information Systems},
  volume = {3},
  number = {1},
  pages = {1--23},
  issn = {2158-656X, 2158-6578},
  doi = {10.1145/2151163.2151168},
  urldate = {2023-10-18},
  abstract = {Enabled by Web 2.0 technologies, social media provide an unparalleled platform for consumers to share their product experiences and opinions through word-of-mouth (WOM) or consumer reviews. It has become increasingly important to understand how WOM content and metrics influence consumer purchases and product sales. By integrating marketing theories with text mining techniques, we propose a set of novel measures that focus on sentiment divergence in consumer product reviews. To test the validity of these metrics, we conduct an empirical study based on data from Amazon.com and BN.com (Barnes \& Noble). The results demonstrate significant effects of our proposed measures on product sales. This effect is not fully captured by nontextual review measures such as numerical ratings. Furthermore, in capturing the sales effect of review content, our divergence metrics are shown to be superior to and more appropriate than some commonly used textual measures the literature. The findings provide important insights into the business impact of social media and user-generated content, an emerging problem in business intelligence research. From a managerial perspective, our results suggest that firms should pay special attention to textual content information when managing social media and, more importantly, focus on the right measures.},
  langid = {english},
  note = {\textbf{Deciphering Word-of-Mouth in Social Media: Text-Based}
\par
\textbf{Metrics of Consumer Reviews}
\par
ZHU ZHANG, University of Arizona, Tucson
\par
XIN LI, City University of Hong Kong
\par
YUBO CHEN, University of Arizona, Tucson and Tsinghua University, Beijing, China
\par
Enabled by Web 2.0 technologies, social media provide an unparalleled platform for consumers to share
\par
their product experiences and opinions through word-of-mouth (WOM) or consumer reviews. It has become
\par
increasingly important to understand how WOM content and metrics influence consumer purchases and
\par
product sales. By integrating marketing theories with text mining techniques, we propose a set of novel
\par
measures that focus on sentiment divergence in consumer product reviews. To test the validity of these
\par
metrics, we conduct an empirical study based on data from Amazon.com and BN.com (Barnes \& Noble). The
\par
results demonstrate significant effects of our proposed measures on product sales. This effect is not fully
\par
captured by nontextual review measures such as numerical ratings. Furthermore, in capturing the sales
\par
effect of review content, our divergence metrics are shown to be superior to and more appropriate than some
\par
commonly used textual measures the literature. The findings provide important insights into the business
\par
impact of social media and user-generated content, an emerging problem in business intelligence research.
\par
From a managerial perspective, our results suggest that firms should pay special attention to textual content
\par
information when managing social media and, more importantly, focus on the right measures.
\par
