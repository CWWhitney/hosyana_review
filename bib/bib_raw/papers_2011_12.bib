@article{soiniTrabectedinTreatmentMetastatic2011,
  title = {Trabectedin in the Treatment of Metastatic Soft Tissue Sarcoma: Cost-Effectiveness, Cost-Utility and Value of Information},
  shorttitle = {Trabectedin in the Treatment of Metastatic Soft Tissue Sarcoma},
  author = {Soini, E.J.O. and Garc{\'i}a San Andr{\'e}s, B. and Joensuu, T.},
