@article{robertsHysterectomyEndometrialAblation2011,
  title = {Hysterectomy, Endometrial Ablation, and Levonorgestrel Releasing Intrauterine System (Mirena) for Treatment of Heavy Menstrual Bleeding: Cost Effectiveness Analysis},
  shorttitle = {Hysterectomy, Endometrial Ablation, and Levonorgestrel Releasing Intrauterine System (Mirena) for Treatment of Heavy Menstrual Bleeding},
  author = {Roberts, T. E. and Tsourapas, A. and Middleton, L. J. and Champaneria, R. and Daniels, J. P. and Cooper, K. G. and Bhattacharya, S. and Barton, P. M.},
  year = 2011,
  month = apr,
  journal = {BMJ (clinical Research Ed.)},
