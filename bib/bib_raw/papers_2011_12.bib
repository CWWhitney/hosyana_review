  title = {Spatial Cloud Computing: How Can the Geospatial Sciences Use and Help Shape Cloud Computing?},
  shorttitle = {Spatial Cloud Computing},
  author = {Yang, Chaowei and Goodchild, Michael and Huang, Qunying and Nebert, Doug and Raskin, Robert and Xu, Yan and Bambacus, Myra and Fay, Daniel},
