@article{huIntelligentAnalysisModel2012,
  title = {Intelligent Analysis Model for Outsourced Software Project Risk Using Constraint-Based Bayesian Network},
  author = {Hu, Yong and Mo, Xizhu and Zhang, Xiangzhou and Zeng, Yuran and Du, Jianfeng and Xie, Kang},
