  title = {Logistics Systems and Optimisation Strategies under Uncertain Operational Environment},
  author = {Yildiz, Turkay and Yercan, Funda},
  year = 2011,
  journal = {International Journal of Decision Sciences, Risk and Management},
  volume = {3},
