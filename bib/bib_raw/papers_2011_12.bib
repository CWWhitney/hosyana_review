@article{burmanModellingSimulationPharmaceutical2011,
  title = {Modelling and Simulation in the Pharmaceutical Industry---Some Reflections},
  author = {Burman, Carl-Fredrik and Wiklund, Stig Johan},
  year = 2011,
  journal = {Pharmaceutical Statistics},
  volume = {10},
  number = {6},
  pages = {508--516},
  issn = {1539-1612},
  doi = {10.1002/pst.523},
  urldate = {2023-06-21},
  abstract = {Modelling and simulation (M\&S) is increasingly being applied in (clinical) drug development. It provides an opportune area for the community of pharmaceutical statisticians to pursue. In this article, we highlight useful principles behind the application of M\&S. We claim that M\&S should be focussed on decisions, tailored to its purpose and based in applied sciences, not relying entirely on data-driven statistical analysis. Further, M\&S should be a continuous process making use of diverse information sources and applying Bayesian and frequentist methodology, as appropriate. In addition to forming a basis for analysing decision options, M\&S provides a framework that can facilitate communication between stakeholders. Besides the discussion on modelling philosophy, we also describe how standard simulation practice can be ineffective and how simulation efficiency can often be greatly improved. Copyright \copyright{} 2011 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {Bayesian,Bayesian Decision Analysis,modelling principles,simulation efficiency},
  note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/pst.523},
  file = {/Users/corywhitney/Zotero/storage/R62PXCVQ/Burman und Wiklund - 2011 - Modelling and simulation in the pharmaceutical ind.pdf;/Users/corywhitney/Zotero/storage/DHPSX68N/pst.html;/Users/corywhitney/Zotero/storage/UDRPWP5C/pst.html}
}

