@article{thompsonUncertaintyRiskWildland2011b,
  title = {Uncertainty and Risk in Wildland Fire Management: A Review},
  shorttitle = {Uncertainty and Risk in Wildland Fire Management},
  author = {Thompson, Matthew P. and Calkin, Dave E.},
  year = 2011,
  month = aug,
  journal = {Journal of Environmental Management},
  volume = {92},
  number = {8},
  pages = {1895--1909},
  issn = {03014797},
  doi = {10.1016/j.jenvman.2011.03.015},
  urldate = {2023-06-21},
  abstract = {Wildland fire management is subject to manifold sources of uncertainty. Beyond the unpredictability of wildfire behavior, uncertainty stems from inaccurate/missing data, limited resource value measures to guide prioritization across fires and resources at risk, and an incomplete scientific understanding of ecological response to fire, of fire behavior response to treatments, and of spatiotemporal dynamics involving disturbance regimes and climate change. This work attempts to systematically align sources of uncertainty with the most appropriate decision support methodologies, in order to facilitate costeffective, risk-based wildfire planning efforts. We review the state of wildfire risk assessment and management, with a specific focus on uncertainties challenging implementation of integrated risk assessments that consider a suite of human and ecological values. Recent advances in wildfire simulation and geospatial mapping of highly valued resources have enabled robust risk-based analyses to inform planning across a variety of scales, although improvements are needed in fire behavior and ignition occurrence models. A key remaining challenge is a better characterization of non-market resources at risk, both in terms of their response to fire and how society values those resources. Our findings echo earlier literature identifying wildfire effects analysis and value uncertainty as the primary challenges to integrated wildfire risk assessment and wildfire management. We stress the importance of identifying and characterizing uncertainties in order to better quantify and manage them. Leveraging the most appropriate decision support tools can facilitate wildfire risk assessment and ideally improve decisionmaking.},
  langid = {english},
  note = {Export Date: 05 May 2024; Cited By: 200},
  file = {/Users/corywhitney/Zotero/storage/4ACITKSU/Thompson und Calkin - 2011 - Uncertainty and risk in wildland fire management .pdf}
}

@article{tielemansAdvancedREACHTool2011,
  title = {Advanced {{REACH}} Tool ({{ART}}): Overview of Version 1.0 and Research Needs},
  shorttitle = {Advanced {{REACH}} Tool ({{ART}})},
  author = {Tielemans, Erik},
  year = 2011,
  month = nov,
  journal = {Annals of Occupational Hygiene},
  issn = {1475-3162},
  doi = {10.1093/annhyg/mer094},
  urldate = {2023-06-21},
  langid = {english},
  note = {Ann. Occup. Hyg., Vol. 55, No. 9, pp. 949--956, 2011
\par
\'OThe Author 2011. Published by Oxford University Press
\par
on behalf of the British Occupational Hygiene Society
\par
doi:10.1093/annhyg/mer094
\par
Advanced REACH Tool (ART): Overview of Version
\par
1.0 and Research Needs
\par
ERIK TIELEMANS1*, NICK WARREN2, WOUTER FRANSMAN1
\par
,
\par
MARTIE VAN TONGEREN3, KEVIN McNALLY2, MARTIN TISCHER4
\par
,
\par
PETER RITCHIE3, HANS KROMHOUT5, JODY SCHINKEL1
\par
,
\par
THOMAS SCHNEIDER6,7 and JOHN W. CHERRIE3
\par
1TNO, PO Box 360, 3700 AJ Zeist, The Netherlands; 2Health and Safety Laboratory (HSL), Harpur
\par
Hill, Buxton, Derbyshire SK17 9JN, UK; 3Institute of Occupational Medicine (IOM), Research Avenue
\par
North, Riccarton, Edinburgh EH14 4AP, UK; 4Federal Institute for Occupational Safety and Health
\par
(BAuA), Friedrich Henkel Weg 1--25, 44149 Dortmund, Germany; 5Institute for Risk Assessment
\par
Sciences, Environmental Epidemiology Division, Utrecht University, 3508 TD, Utrecht, The
\par
Netherlands and 6National Research Centre for the Working Environment, Lers\o{} Parkalle \textasciiacute{} 105, 2100
\par
K\o benhavn \O, Denmark
\par
Received 14 April 2011; in final form 18 August 2011
\par
This paper provides an outline of the Advanced REACH Tool (ART) version 1.0 and a discus-
\par
sion of how it could be further developed. ART is a higher tier exposure assessment tool that
\par
combines mechanistically modelled inhalation exposure predictions with available exposure
\par
data using a Bayesian approach. ART assesses exposure for scenarios across different plants
\par
and sites. Estimates are provided for different percentiles of the exposure distribution and con-
\par
fidence intervals around the estimate. It also produces exposure estimates in the absence of
\par
data, but uncertainty of the estimates will decrease when results of exposure measurements
\par
are included. The tool has been calibrated using a broad range of exposure data and provides
\par
estimates for exposure to vapours, mists, and dusts. ART has a robust and stable conceptual
\par
basis but will be refined in the future and should therefore be considered an evolving system.
\par
High-priority areas for future research are identified in this paper and include the integration
\par
of partially analogous measurement series, inclusion of company and site-specific assessments,
\par
user decision strategies linked to ART predictions, evaluation of validity and reliability of
\par
ART, exploring the possibilities for incorporating the dermal route and integration of ART
\par
predictions with tools for modelling internal dose. ART is initially developed in the scope of
\par
REACH but is equally useful for exposure assessment in other areas.
\par
Keywords: Bayesian analysis; exposure modelling; uncertainty
\par
INTRODUCTION
\par
Under the European Union regulation on the Regula-
\par
tion, Evaluation, Authorization and restriction of
\par
Chemicals (REACH), many thousands of substances
\par
need to be assessed for their safety in use at work over
\par
the coming years. It is clear that the availability of re-
\par
*Author to whom correspondence should be addressed.
\par
Tel: \th 31 88 8665162; fax: \th 31 3069 44070;
\par
e-mail: erik.tielemans@tno.nl
\par
7Present address: K\o gemestervej 13, 3400 Hiller\o d,
\par
Denmark.
\par
liable and accurate exposure models is critical as the
\par
European occupational hygiene community will not
\par
be able to collect sufficient number of exposure meas-
\par
urements to obtain exposure estimates for all relevant
\par
scenarios. A tiered approach is proposed in which
\par
comparatively simple assessments are performed on
\par
all substances (Tier 1 assessment), followed by more
\par
elaborate evaluations for selected chemicals at higher
\par
risk (higher tier assessment). The need for ongoing
\par
scientific development of exposure modelling as a dis-
\par
cipline is also advocated in a vision document on
\par
toxicity testing in the 21st century (NRC, 2007).
\par
949950 E. Tielemans et al.
\par
Indeed, it is argued that the exposure community must
\par
step up to the challenges to develop a robust and pre-
\par
dictive exposure science that can be used to address
\par
the complex risk assessment problems that prevail
\par
today (Sheldon and Cohen Hubal, 2009).
\par
Only a few generic screening tools for assessing
\par
occupational inhalation exposure are available in
\par
Europe, such as COSHH essentials (Maidment,
\par
1998), ECETOC TRA (Money et al., 2007; ECE-
\par
TOC, 2009), Stoffenmanager (Marquart et al.,
\par
2008), and the `Easy-to-use workplace control
\par
scheme for hazardous substances (EMKG) (http://
\par
www.reachhelpdesk.de/en/exposure/exposure.html).
\par
Some information on the validity of these models has
\par
been published but in general only limited information
\par
is available (Schinkel et al., 2010). Another valuable re-
\par
source of available exposure models is the AIHA book
\par
with a description of various methods useful for the
\par
exposure assessment community (Keil et al., 2009).
\par
In general, however, exposure modelling has been a
\par
relatively neglected area in occupational hygiene.
\par
The urgent need for improvements in exposure
\par
modelling, particularly incorporating a Bayesian sta-
\par
tistical approach, has been expressed repeatedly in
\par
the past years (e.g. Creely et al., 2005; Hewett
\par
et al., 2006; Ramachandran, 2008). The Advanced
\par
Reach Tool (ART) is a higher tier model that follows
\par
a Bayesian approach, making full use of mechanically
\par
modelled estimates of inhalation exposure and any
\par
relevant measurements of exposure (www.advanced
\par
reachtool.com). ART has a robust and stable concep-
\par
tual basis but will be further refined in the future and
\par
should therefore be considered an evolving system.
\par
Future areas for development are identified in this pa-
\par
per. As with the development of version 1.0, these
\par
new initiatives will be carried out in close collabora-
\par
tion with stakeholders such as exposure scientists and
\par
practitioners representing industry, governments, and
\par
occupational hygiene societies. ART is initially devel-
\par
oped in the scope of REACH but is equally useful for
\par
exposure assessment in other areas.
\par
This paper briefly reflects the general outline of
\par
ART version 1.0, including the mechanistic model,
\par
Bayesian update process, type of exposure predic-
\par
tions, and applicability domain. Specific elements
\par
of the tool are elaborated on in separate papers.
\par
BAYESIAN MODELLING OF THE EXPOSURE
\par
DISTRIBUTION
\par
ART is developed to model inhalation exposure
\par
for a defined group of workers sharing operational
\par
conditions (e.g. type of handling, product, and work
\par
environment) and risk management measures across
\par
different plants and locations in Europe. This per-
\par
spective in the context of REACH can and will be
\par
expanded in the future to also include company
\par
and site-specific exposure estimates. In statistical
\par
terms, it is assumed that every exposure scenario
\par
has a distinct exposure distribution that is adequately
\par
represented by a lognormal mixed effects model,
\par
with mean exposure and random effects representing
\par
between-company, between-worker, and within-
\par
worker variability. A first estimate of the geometric
\par
mean exposure level of a scenario is produced by
\par
a mechanistic model as outlined in the next para-
\par
graph and discussed in detail by Fransman et al.
\par
(2011). Information from meta-analyses of the liter-
\par
ature provides the initial estimates of exposure vari-
\par
ability between-companies, between-workers, and
\par
within-workers. Information on between- and
\par
within-worker variability was taken from Kromhout
\par
et al. (1993) and information on between-company
\par
variability was derived from Symanski et al.
\par
(2006) as outlined in a next paragraph.
\par
In Bayesian terminology, these initial estimates of
\par
the measure of central tendency and variability are
\par
referred to as `priors', which can then be updated us-
\par
ing the likelihood defined by exposure data to yield
\par
a more refined posterior exposure estimate. The prior
\par
distribution is a representation of knowledge about
\par
the parameter a priori before observing any (new)
\par
data. This is mathematically combined with the like-
\par
lihood to obtain the posterior distribution for the
\par
parameter. The posterior will ideally provide a nar-
\par
rower probability distribution of the parameter than
\par
either the prior knowledge or the exposure data.
\par
The posterior and likelihood will converge with an
\par
increasing exposure data set. The posterior is criti-
\par
cally dependent on the quality of the exposure data
\par
and will be more robust when exposure data used
\par
for the likelihood are completely analogous and rep-
\par
resentative for the particular assessment scenario
\par
(see also Discussion).
\par
It is important to highlight that ART also produces
\par
an exposure estimate in the absence of data, based on
\par
the mechanistic model and exposure variability ob-
\par
tained from the meta-analyses. In this respect, the
\par
ART model follows a stepwise approach, with an
\par
initial mechanistic model estimate and subsequent
\par
posterior estimate.
\par
It can be argued that occupational hygienists al-
\par
ready intuitively apply Bayesian ideas in daily prac-
\par
tice, as they often have to supplement and integrate
\par
limited data with subjective judgements. However,
\par
a formal Bayesian analysis explicitly takes into ac-
\par
count the variability in the available exposure data as
\par
well as uncertainty in the prior knowledge. The overallOverview of ART version 1.0 and research needs structure of the ART tool with different priors, expo-
\par
sure data, and Bayesian module is depicted in Fig. 1.
\par
A detailed description of the Bayesian model in
\par
ART, its underlying assumptions, and testing will be
\par
given by McNally et al. (unpublished data).
\par
MECHANISTIC MODEL
\par
The mechanistic model is based on a conceptual
\par
framework following a source receptor approach
\par
(Cherrie and Schneider, 1999; Tielemans et al.,
\par
2008). This framework describes the stepwise trans-
\par
port of a contaminant from the source to the receptor
\par
(i.e. the worker) and defines nine independent princi-
\par
pal modifying factors (MF): e.g. substance emission
\par
potential, activity emission potential, localized con-
\par
trol, segregation, dilution, separation, surface contam-
\par
ination, personal behaviour, and respiratory protective
\par
equipment. The latter two MF are not yet incorpo-
\par
rated in the mechanistic model and may be included
\par
951
\par
in a later stage. The algorithm consists of a near field
\par
(NF) (within 1 m from the worker's head) and far field
\par
(FF) component. Others have described a two-zone
\par
approach as well and successfully used these algo-
\par
rithms in various applications (e.g. Nicas, 1996).
\par
MFs are structured in a multiplicative manner
\par
within these NF and FF components. The principal
\par
MFs are structured in a hierarchical manner with
\par
multiple underlying determinants on a lower level
\par
of abstraction: e.g. for powders, substance emission
\par
potential is decomposed into the parameters `dusti-
\par
ness', `moisture', and percentage active ingredient
\par
(van Tongeren et al., 2011).
\par
Relative weights have been assigned to each under-
\par
lying determinant category based on analyses from
\par
first principles (e.g. the relationship between vapour
\par
pressure and substance emission potential), available
\par
occupational hygiene literature [e.g. control efficacy
\par
values collated by Fransman et al. (2008)], numerical
\par
simulation results [e.g. for dispersion (Cherrie et al.,
\par
Fig. 1. Schematic outline of ART structure with priors for variability, prior for geometric mean, exposure measurements
\par
(likelihood), Bayesian module, and posterior exposure estimates.952 E. Tielemans et al.
\par
2011)], and expert elicitation. A description of the
\par
mechanistic model, assignment of multipliers, and
\par
its underlying assumptions are presented by Fransman
\par
et al. (2011). An activity class system for structured
\par
assessment of activity emission potential is described
\par
by Marquart et al. (2011). This is an important ele-
\par
ment in the ART system as it allows selecting differ-
\par
ent underlying determinants for different types of
\par
activities: e.g. drop height and transfer rate in bagging
\par
operations, worker orientation (e.g. overhead work),
\par
and spray rate for spraying, etc.
\par
The dimensionless mechanistic model gives a rela-
\par
tive score for the geometric mean exposure of a sce-
\par
nario and is fitted to exposure measurements to
\par
convert these scores to absolute exposure estimates
\par
in milligrams per cubic metre. For this purpose, good
\par
quality data covering multiple industries, scenarios,
\par
and types of exposure were collated across Europe.
\par
The calibration was done using mixed-effects regres-
\par
sion models as described by Schinkel et al. (2011).
\par
These statistical analyses also provided information
\par
on the uncertainty of the mechanistic model esti-
\par
mates, which is a prerequisite for the estimates to
\par
serve as an informative prior for the geometric mean
\par
in a Bayesian analysis.
\par
REVIEW OF LITERATURE ON EXPOSURE
\par
VARIABILITY
\par
Exposure concentrations vary substantially in an
\par
exposure scenario. This may be due to differences
\par
across locations (e.g. ventilation), worker (e.g. behav-
\par
iour), and time (e.g. time activity patterns). These
\par
sources of variability may contribute to between-com-
\par
pany, between-worker, and within-worker variability.
\par
Separation of variability into its components is a pre-
\par
requisite for the estimation of both long-term average
\par
and shift-based exposure estimates as discussed
\par
within the section `Exposure predictions: variability
\par
versus uncertainty'.
\par
We re-analysed the large database of Kromhout
\par
et al. (1993) to define priors for within- and be-
\par
tween-worker variability. These data suggest differ-
\par
ences in the extent to which exposure generally
\par
varies within- and between-workers, which may be
\par
related to factors such as type of exposure (aerosols
\par
versus vapours), environment (outdoor versus in-
\par
door), and process (intermittent versus continuous).
\par
A more recent systematic review of available litera-
\par
ture, also covering occupational groups across loca-
\par
tions (Symanski et al., 2006), was used to derive
\par
estimates of variability between companies. Details
\par
of the derivation of priors for components of variance
\par
are described in McNally et al. (unpublished data).
\par
APPLICABILITY DOMAIN
\par
Factors affecting emission and dispersion of aero-
\par
sols and vapours/gases are clearly distinct as aero-
\par
sols are much larger than air molecules in which
\par
they are suspended, and aerosols can be generated
\par
in different sizes (Popendorf, 2006). This also affects
\par
the way these exposures should be modelled. Sepa-
\par
rate characterization was therefore necessary result-
\par
ing in different determinants or weights for the MFs
\par
substance emission potential, activity emission po-
\par
tential, and dispersion for aerosols and vapours. In
\par
addition, the ART mechanistic model was calibrated
\par
separately for vapours, mists, and dusts. Three other
\par
exposure forms (gases, fibres, and fumes) are not yet
\par
included in the calibration and are therefore outside
\par
the applicability domain of the current ART.
\par
EXPOSURE PREDICTIONS: VARIABILITY
\par
VERSUS UNCERTAINTY
\par
Variability reflects true differences in exposure sit-
\par
uations, whereas uncertainty reflects lack of knowl-
\par
edge about the situation. Basically, variability is
\par
a property of nature, whereas uncertainty may be re-
\par
duced with additional knowledge acquired during
\par
the risk assessment process. Variability and uncer-
\par
tainty need to be treated separately in exposure mod-
\par
els such as ART. The user of ART can select (i)
\par
different percentiles of the exposure distribution (i.e.
\par
variability) and (ii) different confidence intervals
\par
around that percentile (i.e. uncertainty).
\par
After an initial ART assessment, the user can
\par
modify the results by either applying a Bayesian
\par
update or revising the scenario. A Bayesian update
\par
will result in a reduction of uncertainty of the esti-
\par
mate of a particular percentile, with the extent of re-
\par
duction depending on the sample size, the
\par
variability in the data, the balance in the data set
\par
(i.e. number of companies and workers sampled),
\par
and the relative difference between model predic-
\par
tion and data. However, the point estimates of a par-
\par
ticular percentile of the exposure distribution can
\par
either increase or decrease after a Bayesian update,
\par
depending on the distribution of the measurement
\par
data. Revision of input parameters will obviously
\par
result in changes in percentile estimates, whereas
\par
the uncertainty around the point estimate will re-
\par
main unchanged (Table 1).
\par
The extent of exposure variability is related to the av-
\par
eraging time of the exposure assessment, with reduced
\par
exposure variability with longer averaging periods. It
\par
is clear therefore that this should be taken into ac-
\par
count in a sound risk assessment. ART incorporatesOverview of ART version 1.0 and research needs Table 1. Influence of Bayesian updating and ART iterations with revised input parameters on predictions of the exposure
