  doi = {10.1016/0198-9715(81)90004-1},
  urldate = {2024-05-03},
  abstract = {The purpose of this report is to present an approach that provides an analytical base for management and evaluation of human service programs. The relevant literature shows that several major obstacles have existed in service program evaluation. Some key issues are the underlying assumptions of human service programs, definition of needs, evaluation context, and policy development based upon evaluations. These issues are addressed in this study and the utility of needs assessment data as a context setting device for program management, experts, and evaluators is examined. The results of the study demonstrate that a systematic analytical-based approach to defining assumptions and needs is required before programs to `treat' those needs are evaluated. A major conclusion is that the effectiveness of program evaluations for management and policy purposes is enhanced if conditions antecedent to the evaluations are understood by management, experts and evaluators.},
  langid = {english},
  file = {/Users/corywhitney/Zotero/storage/RALUCMU3/0198971581900041.html}
}

