@article{weissReflectionsValuePolicy1986,
  title = {Reflections on Value: Policy Makers Evaluate Federal Information Systems},
  shorttitle = {Reflections on Value},
  author = {Weiss, Janet A. and Gruber, Judith E. and Carver, Robert H.},
  year = 1986,
  journal = {Public Administration Review},
  volume = {46},
  eprint = {975571},
  eprinttype = {jstor},
  pages = {497--505},
  publisher = {[American Society for Public Administration, Wiley]},
  issn = {0033-3352},
  doi = {10.2307/975571},
  urldate = {2024-05-03},
  abstract = {This paper explores ways in which policy makers think about the value of information in the policy process. Close to 200 federal, state, and local policy makers gave us their judgments about information systems which were mandated by the federal government in elementary and secondary education. We predicted that the value they reported would be influenced by their structural location in the educational policy system and by the policy theories about education which they embraced. These predictions were confirmed. Knowledge of a policy maker's structural location and policy theories facilitates understanding of how much he or she will value federal data on education. The results point toward a clearer understanding of the political context in which federal information systems must operate.},
  langid = {english}
}

@article{weitzKnowledgeMotivationAdaptive1986,
  title = {Knowledge, Motivation, and Adaptive Behavior: A Framework for Improving Selling Effectiveness},
  shorttitle = {Knowledge, Motivation, and Adaptive Behavior},
  author = {Weitz, Barton A. and Sujan, Harish and Sujan, Mita},
  year = 1986,
  journal = {Journal of Marketing},
  volume = {50},
  number = {4},
  eprint = {1251294},
  eprinttype = {jstor},
  pages = {174--191},
  publisher = {American Marketing Association},
  issn = {0022-2429},
  doi = {10.2307/1251294},
  urldate = {2024-05-03},
  abstract = {The authors propose that adaptive selling is influenced by salespeople's knowledge of customer types and sales strategies as well as their motivation to alter the direction of their behavior. Pertinent research in psychology and personal selling is reviewed and specific propositions relating to knowledge, motivation, and adaptive behavior are advanced. On the basis of these propositions, suggestions are made for selecting, training, managing, and compensating salespeople.},
  langid = {english}
}

