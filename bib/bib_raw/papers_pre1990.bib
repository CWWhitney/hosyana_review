@article{wrightComparisonLensSubjective1982,
  title = {Comparison of the Lens and Subjective Probability Paradigms for Financial Research Purposes},
  author = {Wright, William F.},
  year = 1982,
  month = jan,
  journal = {Accounting, Organizations and Society},
  volume = {7},
  number = {1},
  pages = {65--75},
  issn = {0361-3682},
  doi = {10.1016/0361-3682(82)90026-5},
  urldate = {2024-05-03},
  abstract = {Two paradigms have been used by researchers to model and evaluate the quality of financial judgments relative to environmental conditions; the Brunswik Lens and the subjective probability (SP) paradigms. Here the Lens and SP paradigms are analyzed and compared in terms of their appropriateness for research issues such as the accuracy and reliability of financial judgments, the relative importance of data, effects of data sets, etc. Aspects considered include the assumptions and technical properties, descriptive statistics generated, environmental comparisons typically made and the overall effort required to utilize each paradigm. Direct comparisons are provided. Guidance is provided for researchers contemplating usage of the paradigms.},
  langid = {english}
}

