@article{brynjolfssonConsumerSurplusDigital2003,
  title = {Consumer Surplus in the Digital Economy: Estimating the Value of Increased Product Variety at Online Booksellers},
  shorttitle = {Consumer Surplus in the Digital Economy},
  author = {Brynjolfsson, Erik and Hu, Yu (Jeffrey) and Smith, Michael D.},
  year = 2003,
