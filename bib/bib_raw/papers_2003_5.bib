@article{zhouEffectsStrategicOrientations2005,
  title = {The Effects of Strategic Orientations on Technology- and Market-Based Breakthrough Innovations},
  author = {Zhou, Kevin Zheng and Yim, Chi Kin (Bennett) and Tse, David K.},
  year = 2005,
  month = apr,
  journal = {Journal of Marketing},
  volume = {69},
  number = {2},
  pages = {NaN-NaN},
  issn = {0022-2429, 1547-7185},
  doi = {10.1509/jmkg.69.2.42.60756},
  urldate = {2023-10-25},
  abstract = {Does market orientation impede breakthrough innovation? To date, researchers have presented opposing arguments with respect to this important issue. To address this controversy, the authors conceptualize and empirically test a model that links different types of strategic orientations and market forces, through organizational learning, to breakthrough innovations and firm performance. The results show that a market orientation facilitates innovations that use advanced technology and offer greater benefits to mainstream customers (i.e., technology-based innovations) but inhibits innovations that target emerging market segments (i.e., market-based innovations). A technology orientation is beneficial to technology-based innovations but has no impact on market-based innovations, and an entrepreneurial orientation facilitates both types of breakthroughs. Different market forces (demand uncertainty, technology turbulence, and competitive intensity) exert significant influence on technology- and market-based innovations, and these two types of innovations affect firm performance differently. The results have significant implications for firm strategies to facilitate product innovations and achieve competitive advantages.},
  langid = {english},
  keywords = {linter/error},
  file = {/Users/corywhitney/Zotero/storage/2PQHXDXU/Zhou et al. - 2005 - The Effects of Strategic Orientations on Technolog.pdf}
}

@article{zhuPostadoptionVariationsUsage2005,
  title = {Post-Adoption Variations in Usage and Value of {{E-business}} by Organizations: Cross-Country Evidence from the Retail Industry},
  shorttitle = {Post-Adoption Variations in Usage and Value of {{E-business}} by Organizations},
  author = {Zhu, Kevin and Kraemer, Kenneth L.},
  year = 2005,
  month = mar,
  journal = {Information Systems Research},
  volume = {16},
  number = {1},
  pages = {NaN-NaN},
  issn = {1047-7047, 1526-5536},
  doi = {10.1287/isre.1050.0045},
  urldate = {2023-10-04},
  abstract = {Grounded in the innovation diffusion literature and the resource-based theory, this paper develops an integrative research model for assessing the diffusion and consequence of e-business at the firm level. Unlike the typical focus on adoption as found in the literature, we focus on postadoption stages, that is, actual usage and value creation. The model thus moves beyond dichotomous ``adoption versus nonadoption'' and accounts for the ``missing link''---actual usage---as a critical stage of value creation. The model links technological, organizational, and environmental factors to e-business use and value, based on which a series of hypotheses are developed. The theoretical model is tested by using structural equation modeling on a dataset of 624 firms across 10 countries in the retail industry. To probe deeper into whether e-business use and value are influenced by economic environments, two subsamples from developed and developing countries are compared. The study finds that technology competence, firm size, financial commitment, competitive pressure, and regulatory support are important antecedents of e-business use. In addition, the study finds that, while both front-end and back-end capabilities contribute to e-business value, back-end integration has a much stronger impact. While front-end functionalities are becoming commodities, e-businesses are more differentiated by back-end integration. This is consistent with the resource-based theory because back-end integration possesses the value-creating characteristics of resources (e.g., firm specific, difficult to imitate), which are strengthened by the Internet-enabled connectivity. Our study also adds an international dimension to the innovation diffusion literature, showing that careful attention must be paid to the economic and regulatory factors that may affect technology diffusion across different countries.},
  langid = {english},
  keywords = {linter/error},
  file = {/Users/corywhitney/Zotero/storage/FH8C7ATJ/Zhu and Kraemer - 2005 - Post-Adoption Variations in Usage and Value of E-B.pdf;/Users/corywhitney/Zotero/storage/GETLSDEM/Zhu and Kraemer - 2005 - Post-Adoption Variations in Usage and Value of E-B.pdf}
}

@article{ziervogelAgentbasedSocialSimulation2005,
  title = {Agent-Based Social Simulation: A Method for Assessing the Impact of Seasonal Climate Forecast Applications among Smallholder Farmers},
  shorttitle = {Agent-Based Social Simulation},
  author = {Ziervogel, Gina and Bithell, Mike and Washington, Richard and Downing, Tom},
  year = 2005,
  journal = {Agricultural Systems},
  volume = {83},
  number = {1},
  pages = {NaN-NaN},
  publisher = {Elsevier},
  doi = {10.1016/j.agsy.2004.02.009},
  langid = {english},
  note = {AGRICULTURAL
\par
SYSTEMS
\par
Agricultural Systems 83 (2005) 1--26
\par
www.elsevier.com/locate/agsy
\par
Agent-based social simulation: a method
\par
for assessing the impact of seasonal
\par
climate forecast applications among
\par
smallholder farmers
\par
Gina Ziervogel a,*, Mike Bithell b, Richard Washingtonc
\par
,
\par
Tom Downinga
\par
a Stockholm Environment Institute Oxford Office, 10B Littlegate Street, Oxford OX1 1QT, UK
\par
b Department of Geography, University of Cambridge, Downing Place, Cambridge CB2 3EN, UK
\par
c School of Geography and the Environment, 1a Mansfield Road, University of Oxford, OX1 3TB, UK
\par
Received 3 January 2003; received in revised form 10 February 2004; accepted 11 February 2004
\par
Abstract
\par
Seasonal climate forecasts provide probabilistic information on future climate on time-
\par
scales of two to three months. Where this information is not presently used it is difficult to
\par
evaluate the impact it might have. In order to justify disseminating the information to mar-
\par
ginal groups it is important that the potential impact of the forecast is explored so that the
\par
negative and positive effects are at least partially appreciated before use of the information
\par
is widely promoted. We use an agent-based social simulation model, based on empirical evi-
\par
dence from field work in Lesotho, to assess the impact of using seasonal forecasts among
\par
smallholder farmers. The impact of using the forecast depends on the agents' initial household
\par
characteristics, what options they choose in responding to the forecast and the trust they place
\par
in the forecast (which in turn depends on their ability to learn and to follow their neighbours).
\par
Interaction of climate, crop productivity and social factors determines how much household-
\par
agents benefit or lose, evaluated in terms of crop yields and likelihood of exhausting food
\par
storage. Adoption of the forecast has the potential to decrease starvation among marginal
\par
household-agents but poor forecasts may do more harm than good. This work suggests that
\par
if forecasts are not correct more than 60--70\% of the time, then they are unlikely to benefit
\par
* Corresponding author. Present address: Climate Systems Analysis Group, Department of Environ-
\par
mental and Geographical Science, University of Cape Town, Private Bag, Rondebosch 7701, South
\par
Africa. Tel.: +27-21-650-2999; fax: +27-21-650-773.
\par
E-mail addresses: gina.ziervogel@sei.se (G. Ziervogel).
\par
0308-521X/\$ - see front matter \'O 2004 Elsevier Ltd. All rights reserved.
\par
doi:10.1016/j.agsy.2004.02.0092 G. Ziervogel et al. = Agricultural Systems 83 (2005) 1--26
\par
poor farmers. Poor forecasts, or forecasts that fail badly, when they do fail, lead to longer
\par
adoption timescales for forecast use. Further investigation into the impact of the forecast at
\par
the village level is encouraged before dissemination is actively pursued without appreciating
\par
potential impacts.
\par
\'O 2004 Elsevier Ltd. All rights reserved.
\par
Keywords: Seasonal climate forecast applications; Agent-based social simulation; Marginal farmers;
\par
Lesotho; Climate adaptation
\par
1. Introduction
\par
International efforts to improve societal responses to seasonal climate forecasts
\par
are a priority because of their potential for ameliorating the impacts of climate var-
\par
iability on marginal groups whose livelihoods are often highly impacted by climate
\par
(Agrawala et al., 2001; Hansen, 2002; Anderson, 2003). Despite this priority, there
\par
are few examples of how forecasts have been used by marginal groups (Eakin,
\par
2000; Vogel, 2000). This dearth of information leads to uncertainty as to how fore-
\par
cast development should be approached. The understanding of the impacts that fore-
\par
casts might have on marginal groups is paramount to evaluating adaptation to
\par
climate variability, a growing concern for the climate change community (Smit
\par
et al., 2000).
\par
Research has shown that marginal farmers (those individuals that struggle to se-
\par
cure access to resources and services) are interested in receiving the seasonal fore-
\par
cast but the communication systems responsible for disseminating the forecast are
\par
poorly developed and resource and cultural constraints restrict response options
\par
(Archer, 2003; Eakin, 2000; Kirshen and Flitcroft, 2000; Mukhala et al., 2000;
\par
O'Brien et al., 2000; Vogel, 2000; Phillips et al., 2001; Walker et al., 2001; Ziervo-
\par
gel, 2004; Ingram et al., 2002; Patt and Gwata, 2002). Because forecasts are not
\par
widely used at present, the impacts of forecasts are difficult to assess (Ziervogel
\par
and Calder, 2003). Modelling approaches have been used successfully to assess
\par
the value of using seasonal forecasts for tactical decisions in other counties, such
\par
as Australia (Carberry et al., 2000; Hammer et al., 1996), but it is necessary to in-
\par
clude the possible decision options when dealing with a group that has not previ-
\par
ously used forecasts (Gadgil et al., 2002). Hansen (2002) suggests that a
\par
combination of modelling and descriptive approaches can help to provide holistic
\par
analyses and a co-learning approach where farmers and research both benefit.
\par
Other research has suggested that a modelling approach that incorporates climate
\par
and crop constraints and socio-economic factors be used as a tool for assessing
\par
the potential value and use of forecasts in southern Africa (Vogel, 2000). The model
\par
presented in this paper combines qualitative decision characteristics with quantita-
\par
tive environmental information and so integrates descriptive and modelling
\par
approaches.
\par
The model represents household response to the integration of forecasts into rural
\par
communities at the village level. The objective is to develop a simulation that illus-G. Ziervogel et al. = Agricultural Systems 83 (2005) 1--26 3
\par
trates prospective pathways that might occur if households integrate the forecast into
\par
their decisions. Specifically we aim to investigate:
\par
1. The pay-offs of using the forecast as a function of forecast accuracy.
\par
2. How mean trust in the forecast of farmer-agents grows or declines as a function of
\par
forecast accuracy.
\par
3. What the benefit of using the forecast might be in terms of yield, with and without
\par
interactions among farmer-agents and for different wealth profiles.
\par
Forecast accuracy here refers specifically to rainfall, and is the percentage of time
\par
that the forecast and actual rainfall are in agreement. The modelled behaviour is sup-
\par
ported by empirical data from Lesotho, giving a baseline data set with a realistic dis-
\par
tribution of household characteristics and response options for using forecasts. The
\par
model is an abstraction of the Lesotho case study, but it does allow the analyst to
\par
explore the potential of seasonal forecasts among smallholder farmers. Since farmers
\par
have not received and used climate forecasts, the model is one way to explore scenar-
\par
ios of future development.
\par
Section 2 describes the seasonal forecasts and highlights the difficulties associated
\par
with assessing their usefulness. The case study of smallholder farmers in Lesotho, on
\par
which the model is based, is then discussed. Agent-Based Social Simulation (ABSS)
\par
is then introduced as a technique that allows crop, climate and social factors to be
\par
coupled together for the exploration of the impact of seasonal forecast use. Section
\par
3 outlines the model development and describes the results obtained; Section 4
\par
discusses possible extensions of the model and the final section concludes with a
\par
model evaluation and the implication of the findings for future forecast application
\par
developments.
\par
2. Background: seasonal forecasts, field work and agent-based social simulation models
\par
2.1. Forecast dissemination and adoption
\par
During the past few decades, climatologists have improved their ability to predict
\par
the seasonal climate (Cane et al., 1986; Palmer and Anderson, 1994; Martin et al.,
\par
2000; Murphy et al., 2001). These seasonal climate forecasts are based on ocean--
\par
atmosphere interaction such that sea surface temperatures (SSTs) determine future
\par
atmospheric perturbation states (Washington and Downing, 1999). This predictabil-
\par
ity is largely confined to the tropical atmospheric circulation and is principally de-
\par
pendent on El Ni\textasciitilde{} no-Southern Oscillation (ENSO)-related anomalies (Mason
\par
et al., 1996). Seasonal climate forecasts are available for temperature and rainfall.
\par
Regional forecasts are produced in a number of regions including Australia, Latin
\par
America, the Caribbean, Pacific islands, Southeast Asia, West Africa, the Greater
\par
Horn of Africa and southern Africa (Basher et al., 2001; Stone and de Hoedt,
\par
2000). In southern Africa, where the rainy season stretches from October to March,
\par
a regional consensus meeting, organised by the Drought Monitoring Centre (DMC)-
\par
Harare, is held in September (O'Brien et al., 2000; Basher et al., 2001). A six-month
\par
consensus forecast, that integrates the output of numerous seasonal forecast models,4 G. Ziervogel et al. = Agricultural Systems 83 (2005) 1--26
\par
is issued for October--March. A mid-season correction meeting is held in December
\par
to update the forecast for January--February--March. Each country adapts the re-
\par
gional forecast using local data to produce a national forecast.
\par
The nature of the seasonal forecast means that it is not appropriate for all users,
\par
as there are numerous sector-specific constraints associated with using the forecast,
\par
which can limit uptake (Nicholls, 1999; Orlove and Tosteson, 1999; Patt, 2001).
\par
These can be separated broadly into problems of forecast dissemination and prob-
\par
lems of forecast use. The national meteorological organizations are responsible for
\par
disseminating the forecast within their country. Most countries in southern Africa
\par
do not have well-developed dissemination strategies and so there is not great aware-
\par
ness of the forecast at the national level and even less at the local level (O'Brien et al.,
\par
2000). Furthermore, the coarse scale and temporal resolution of the forecast make it
\par
difficult to apply locally. Even with effective distribution of the forecast, the level of
\par
use is dependent on further factors; both the skill of the forecast and the credibility
\par
of the source play a role. The skill of the forecast is a measure of the degree of cor-
\par
respondence between forecasts and observation (Murphy, 1997). Skill scores such as
\par
this are an attempt to summarise the joint probability distribution of many climate
\par
variables, and as such may not bear directly on the probability of rainfall occurring,
\par
for example. The credibility of the forecast, which will determine the amount of trust
\par
users place in the forecast, is partly determined by past skill and partly by forecast
\par
communicators' reputations (Patt, 2000, 2001; Patt and Gwata, 2002). Trust will also
\par
be affected by the way the forecast supports or contradicts local beliefs about the cli-
\par
mate (Eakin, 1999). These beliefs might be based on cultural norms or environmental
\par
indicators. Improved credibility may therefore depend on improved forecasts and
\par
better data, it may depend on better communication that emphasises the probabilis-
\par
tic nature of the forecast and comes from a respected source or it may depend on
\par
adjustment of cultural and social perceptions that view the forecast in a favourable
\par
light.
\par
Forecasts are innovations that have not been widely adopted, particularly among
\par
marginal groups. Traditional information dissemination literature would assess the
\par
success of adoption of forecasts, a type of innovation, as a function of the numbers
\par
of users that have already adopted the innovation in comparison to those who have
\par
not (Rogers, 1995). This may be inappropriate when there is not a high adoption rate
\par
and so few data. It does not enable the stochastic nature of adoption, associated with
\par
prospective technological innovations, to be anticipated (Mazzocco et al., 1992). As-
\par
sessing the possible use and impact of forecasts, when they have not been available
\par
previously, requires a process-based model for the exploration of available future
\par
pathways of development. In this way, the potential range of impacts of forecast
\par
use can be captured (Stern and Easterling, 1999; Downing et al., 2000).
\par
2.2. Lesotho: case study
\par
Lesotho, a small mountainous country in southern Africa, provides a natural lab-
\par
oratory in which to assess how seasonal forecasts are being disseminated, perceived
\par
and used at a national and local scale. In Lesotho, the seasonal forecast is developedG. Ziervogel et al. = Agricultural Systems 83 (2005) 1--26 5
\par
using statistical methods that combine past climate data with seasonal ocean and at-
\par
mospheric data. An analysis of the 2000 October--November--December rainfall
\par
forecast showed a skill of 56\% of a hindcast compared to past data (Peshoane,
\par
2000). The systems that disseminate forecasts in Lesotho are not particularly well de-
\par
veloped (Ziervogel and Downing, in press). Lesotho Meteorological Services (LMS)
\par
has issued the forecast for six years but dissemination is not widespread. LMS hold
\par
an annual workshop to announce the forecast but the meeting is attended primarily
\par
by government officials, who tend not to disseminate the forecast beyond their im-
\par
mediate colleagues. The radio programmes that report on the workshop do not im-
\par
prove awareness of the forecast much, as they read out a press statement rather than
\par
expanding on the forecast characteristics and possible uses.
\par
Field work, undertaken in one village in southern Lesotho, Ha Tlhaku, and sup-
\par
ported by field work from other parts of Lesotho, has been used to develop the
\par
model. Modelled requirements for food, available resources and likely reactions to
\par
introduction of the forecast have been based on field work undertaken between
\par
September 2000 and November 2001.
\par
A range of data elicitation techniques such as surveys, workshops and participa-
\par
tory tools were used to gather data. A role-play exercise was developed to elicit how
\par
farmers might use forecast information that they had not heard before. This partic-
\par
ipatory method enabled farmers to think through the situation with which they were
\par
faced at the beginning of the growing season, when presented with new information
\par
about the climate (the seasonal forecast). They were asked whether they would in-
\par
tegrate the forecast into their decisions and if so, how. The scenario was first pre-
\par
sented for the present year when they were asked about what decisions they faced
\par
that season. It was then repeated for the following year when a forecast of below
\par
normal rainfall was expected and lastly for a year with a forecast for above normal
\par
rainfall.
\par
The role-play exercise elicited options that farmers thought they might pursue if
\par
they received the forecast, as seen in Table 1. The options suggest that abundant re-
\par
sources are not required for all responses. Some suggestions were more prevalent
\par
than others and some more appropriate for a wide range of users. Options such as
\par
changing cropping densities can be pursued by all households and many can change
\par
crop type by bartering with their neighbours, as is a common practise. Changing to
\par
drought resistant varieties might only be an option for households who can afford to
\par
buy new seed, unlike most households that keep their seed from the harvest to plant
\par
the following year.
\par
The types of decisions that people mentioned they might undertake in response to
\par
the forecast were mostly short-term tactical decisions such as sowing less maize and
\par
wheat, planting earlier or protecting the livestock, rather than long-term strategic de-
\par
cisions. These decisions are a form of agricultural risk management. The focus on
\par
short-term decisions is expected when using new information. When these decisions
\par
seem an appropriate way of responding to the forecast, then more long-term deci-
\par
sions can be made in response to the forecast, depending on the risk preference of
\par
the decision maker (Carberry et al., 2000). The decisions chosen for use in the model,
\par
in response to the forecast, are the adjustment of cropping densities and the ratio of6 G. Ziervogel et al. = Agricultural Systems 83 (2005) 1--26
