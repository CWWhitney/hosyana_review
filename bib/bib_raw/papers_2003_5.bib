@article{banker50thAnniversaryArticle2004,
  title = {50th Anniversary Article: The Evolution of Research on Information Systems: A Fiftieth-Year Survey of the Literature in {\emph{Management Science}}},
  shorttitle = {50th Anniversary Article},
  author = {Banker, Rajiv D. and Kauffman, Robert J.},
  year = 2004,
