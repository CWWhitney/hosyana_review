@article{alhinaiDisasterManagementDigitally2020,
  title = {Disaster Management Digitally Transformed: Exploring the Impact and Key Determinants from the {{UK}} National Disaster Management Experience},
  shorttitle = {Disaster Management Digitally Transformed},
  author = {AlHinai, Yousuf Salim},
  year = 2020,
  month = dec,
