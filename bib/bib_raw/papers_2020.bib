@article{rungeSimulatingCouncilspecificImpact2020,
  title = {Simulating the Council-Specific Impact of Anti-Malaria Interventions: A Tool to Support Malaria Strategic Planning in {{Tanzania}}},
  shorttitle = {Simulating the Council-Specific Impact of Anti-Malaria Interventions},
  author = {Runge, Manuela and Snow, Robert W. and Molteni, Fabrizio and Thawer, Sumaiyya and Mohamed, Ally and Mandike, Renata and Giorgi, Emanuele and Macharia, Peter M. and Smith, Thomas A. and Lengeler, Christian and Pothin, Emilie},
  year = 2020,
  month = feb,
  journal = {PLOS One},
  volume = {15},
  number = {2},
  pages = {NaN-NaN},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0228469},
  urldate = {2023-10-25},
  abstract = {Introduction The decision-making process for malaria control and elimination strategies has become more challenging. Interventions need to be targeted at council level to allow for changing malaria epidemiology and an increase in the number of possible interventions. Models of malaria dynamics can support this process by simulating potential impacts of multiple interventions in different settings and determining appropriate packages of interventions for meeting specific expected targets. Methods The OpenMalaria model of malaria dynamics was calibrated for all 184 councils in mainland Tanzania using data from malaria indicator surveys, school parasitaemia surveys, entomological surveillance, and vector control deployment data. The simulations were run for different transmission intensities per region and five interventions, currently or potentially included in the National Malaria Strategic Plan, individually and in combination. The simulated prevalences were fitted to council specific prevalences derived from geostatistical models to obtain council specific predictions of the prevalence and number of cases between 2017 and 2020. The predictions were used to evaluate in silico the feasibility of the national target of reaching a prevalence of below 1\% by 2020, and to suggest alternative intervention stratifications for the country. Results The historical prevalence trend was fitted for each council with an agreement of 87\% in 2016 (95\%CI: 0.84--0.90) and an agreement of 90\% for the historical trend (2003--2016) (95\%CI: 0.87--0.93) The current national malaria strategy was expected to reduce the malaria prevalence between 2016 and 2020 on average by 23.8\% (95\% CI: 19.7\%-27.9\%) if current case management levels were maintained, and by 52.1\% (95\% CI: 48.8\%-55.3\%) if the case management were improved. Insecticide treated nets and case management were the most cost-effective interventions, expected to reduce the prevalence by 25.0\% (95\% CI: 19.7\%-30.2) and to avert 37 million cases between 2017 and 2020. Mass drug administration was included in most councils in the stratification selected for meeting the national target at minimal costs, expected to reduce the prevalence by 77.5\% (95\%CI: 70.5\%-84.5\%) and to avert 102 million cases, with almost twice higher costs than those of the current national strategy. In summary, the model suggested that current interventions are not sufficient to reach the national aim of a prevalence of less than 1\% by 2020 and a revised strategic plan needs to consider additional, more effective interventions, especially in high transmission areas and that the targets need to be revisited. Conclusion The methodology reported here is based on intensive interactions with the NMCP and provides a helpful tool for assessing the feasibility of country specific targets and for determining which intervention stratifications at sub-national level will have most impact. This country-led application could support strategic planning of malaria control in many other malaria endemic countries.},
  langid = {english},
  keywords = {Insecticides,Malaria,Malarial parasites,Schools,Simulation and modeling,Tanzania},
  file = {/Users/corywhitney/Zotero/storage/RKZ938L9/Runge et al. - 2020 - Simulating the council-specific impact of anti-mal.pdf}
}

@article{sakibQualitativeStudyUnited2020,
  title = {A Qualitative Study on the {{United States}} Internet of Energy: A Step towards Computational Sustainability},
  shorttitle = {A Qualitative Study on the {{United States}} Internet of Energy},
  author = {Sakib, Nazmus and Hossain, Eklas and Ahamed, Sheikh Iqbal},
