@article{wangInfluencePRINCE2Standard2020,
  title = {The Influence of {{PRINCE2}} Standard on Customer Satisfaction in Information Technology Outsourcing: An Investigation of a Mediated Moderation Model},
  shorttitle = {The Influence of {{PRINCE2}} Standard on Customer Satisfaction in Information Technology Outsourcing},
  author = {Wang, Jian-Jun and Sasanipoor, Negin and Wang, Meng-Meng},
