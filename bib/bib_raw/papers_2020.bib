@article{aspenEvaluatingAlternativeEnergy2020,
  title = {Evaluating Alternative Energy Carriers in Ferry Transportation Using a Stochastic Multi-Criteria Decision Analysis Approach},
  author = {Aspen, Dina Margrethe and Sparrevik, Magnus},
  year = 2020,
  month = sep,
  journal = {Transportation Research Part D: Transport and Environment},
  volume = {86},
