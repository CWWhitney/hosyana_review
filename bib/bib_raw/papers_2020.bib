@article{karakocSocialVulnerabilityEquity2020,
  title = {Social Vulnerability and Equity Perspectives on Interdependent Infrastructure Network Component Importance},
  author = {Karakoc, Deniz Berfin and Barker, Kash and Zobel, Christopher W. and Almoghathawi, Yasser},
  year = 2020,
