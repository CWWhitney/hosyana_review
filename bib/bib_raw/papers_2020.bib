@article{karandikarStabilityBoundaryOptimal2020,
  title = {Stability Boundary and Optimal Operating Parameter Identification in Milling Using Bayesian Learning},
  author = {Karandikar, Jaydeep and Honeycutt, Andrew and Schmitz, Tony and Smith, Scott},
