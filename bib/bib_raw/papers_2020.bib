@article{lenjaniResiliencebasedMethodPrioritizing2020,
  title = {A Resilience-Based Method for Prioritizing Post-Event Building Inspections},
  author = {Lenjani, Ali and Bilionis, Ilias and Dyke, Shirley J. and Yeum, Chul Min and Monteiro, Ricardo},
