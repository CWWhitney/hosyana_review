@article{tangRemanufacturingCompetitiveMarket2020,
  title = {Remanufacturing in a Competitive Market: A Closed-Loop Supply Chain in a Stackelberg Game Framework},
  shorttitle = {Remanufacturing in a Competitive Market},
  author = {Tang, Shaolong and Wang, Wenjie and Zhou, Gaoguang},
