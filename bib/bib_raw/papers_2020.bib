@article{bhosaleAnalysingInterrelationshipSupply2020,
  title = {Analysing the Interrelationship among Supply Chain Knowledge Flow Barriers: A {{DEISMI}} Approach},
  shorttitle = {Analysing the Interrelationship among Supply Chain Knowledge Flow Barriers},
  author = {Bhosale, Vishal A. and Kant, Ravi},
  year = 2020,
