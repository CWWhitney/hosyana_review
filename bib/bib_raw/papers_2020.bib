  author = {French, David P. and Astley, Susan and Brentnall, Adam R. and Cuzick, Jack and Dobrashian, Richard and Duffy, Stephen W. and Gorman, Louise S. and Harkness, Elaine F. and Harrison, Fiona and Harvie, Michelle and Howell, Anthony and Jerrison, Andrew and Machin, Matthew and Maxwell, Anthony J. and McWilliams, Lorna and Payne, Katherine and Qureshi, Nadeem and Ruane, Helen and Sampson, Sarah and Stavrinos, Paula and Thorpe, Emma and Ulph, Fiona and {van Staa}, Tjeerd and Woof, Victoria and Evans, D. Gareth},
