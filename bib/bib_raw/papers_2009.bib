  title = {Reducing the Probability of Bankruptcy through Supply Chain Coordination},
  author = {Xu, Xiaoyan and Sun, Yanhong and Hua, Zhongsheng},
  year = 2009,
  journal = {IEEE Transactions on Systems, Man, and Cybernetics, Part C (applications and Reviews)},
  volume = {40},
