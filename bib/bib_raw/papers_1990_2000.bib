  author = {Lee, Kerry L. and Woodlief, Lynn H. and Topol, Eric J. and Weaver, W. Douglas and Betriu, Amadeo and Col, Jacques and Simoons, Maarten and Aylward, Phil and Van De Werf, Frans and Califf, Robert M.},
