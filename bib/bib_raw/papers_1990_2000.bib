@article{cooperIDEAARIDEAModels1999,
  title = {{{IDEA}} and {{AR-IDEA}}: Models for Dealing with Imprecise Data in {{DEA}}},
  shorttitle = {{{IDEA}} and {{AR-IDEA}}},
  author = {Cooper, William W. and Park, Kyung Sam and Yu, Gang},
  year = 1999,
  month = apr,
  journal = {Management Science},
  volume = {45},
  number = {4},
  pages = {597--607},
  issn = {0025-1909, 1526-5501},
  doi = {10.1287/mnsc.45.4.597},
  urldate = {2024-05-03},
  abstract = {Data Envelopment Analysis (DEA) is a nonparametric approach to evaluating the relative efficiency of decision making units (DMUs) that use multiple inputs to produce multiple outputs. An assumption underlying DEA is that all the data assume the form of specific numerical values. In some applications, however, the data may be imprecise. For instance, some of the data may be known only within specified bounds, while other data may be known only in terms of ordinal relations. DEA with imprecise data or, more compactly, the Imprecise Data Envelopment Analysis (IDEA) method developed in this paper permits mixtures of imprecisely- and exactly-known data, which the IDEA models transform into ordinary linear programming forms. This is carried even further in the present paper to comprehend the now extensively employed Assurance Region (AR) concepts in which bounds are placed on the variables rather than the data. We refer to this approach as AR-IDEA, because it replaces conditions on the variables with transformations of the data and thus also aligns the developments we describe in this paper with what are known as cone-ratio envelopments in DEA. As a result, one unified approach, referred to as the AR-IDEA model, is achieved which includes not only imprecise data capabilities but also assurance region and cone-ratio envelopment concepts.},
  langid = {english}
}

@article{cooperImplicationsCompetingValues1993,
  title = {Implications of the Competing Values Framework for Management Information Systems},
  author = {Cooper, Randolph B. and Quinn, Robert E.},
  year = 1993,
  month = mar,
  journal = {Human Resource Management},
  volume = {32},
  number = {1},
  pages = {175--201},
  issn = {0090-4848, 1099-050X},
  doi = {10.1002/hrm.3930320109},
  urldate = {2024-05-03},
  abstract = {Abstract             Problems with evaluating management information systems' (MIS) effectiveness are due to the lack of an MIS effectiveness theory. This article draws on the Competing Values Framework to develop a framework of MIS effectiveness which links MIS characteristics to organizational effectiveness via management activity support. This framework is based in both organizational and MIS literatures and is corroborated by cognitive maps of recognized MIS experts. The framework is then used to gain a better understanding of the MIS effectiveness construct and thus to provide guidance for evaluating MIS effectiveness. \copyright{} 1993 by John Wiley \& Sons, Inc.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

@article{cooperInformationTechnologyImplementation1990,
  title = {Information Technology Implementation Research: A Technological Diffusion Approach},
  shorttitle = {Information Technology Implementation Research},
  author = {Cooper, Randolph B. and Zmud, Robert W.},
  year = 1990,
  month = feb,
  journal = {Management Science},
  volume = {36},
  number = {2},
  pages = {123--139},
  issn = {0025-1909, 1526-5501},
  doi = {10.1287/mnsc.36.2.123},
  urldate = {2024-05-03},
  abstract = {Based on the innovation and technological diffusion literatures, promising research questions concerning the implementation of a production and inventory control information system (material requirements planning: MRP) are identified and empirically examined. These questions focus on the interaction of managerial tasks with the information technology and the resulting effect on the adoption and infusion of that technology.             Using a random sample of manufacturing firms across the United States, we find that this interaction does indeed affect the adoption of MRP, though it does not seem to affect MRP infusion. These results support the notion that though rational decision models may be useful in explaining information technology adoption, political and learning models may be more useful when examining infusion.},
  langid = {english}
}

@article{coxjrInternalDoseUncertainty1999,
  title = {Internal Dose, Uncertainty Analysis, and Complexity of Risk Models},
  author = {Cox Jr, Louis Anthony},
  year = 1999,
  journal = {Environment International},
  volume = {25},
  number = {6-7},
  pages = {841--852},
  publisher = {Elsevier},
  doi = {10.1016/S0160-4120(99)00062-8},
  langid = {english},
  note = {\copyright{} COX ASSOCIATES, 1999. 503 Franklin St., Denver, CO, 80218. Ph 303-388-1778; Fax --303-388-0609. tony@cox-associates.com
\par
\textbf{Internal Dose, Uncertainty Analysis, and}
\par
\textbf{Complexity of Risk Models}
\par
Louis Anthony Cox, Jr.
\par
Cox Associates
\par
503 Franklin Street
\par
Denver, CO, 80218
\par
April, 1999
\par
(Forthcoming in \emph{Environment International,} 1999.)
\par
\textbf{ABSTRACT: }Practitioners and consumers of risk assessments often wonder whether the
\par
trend toward more complex risk models, incorporating increasing amounts of biological
\par
knowledge and increasing numbers of biologically interpretable parameters, actually lead
\par
to better risk estimates. A contrary view might be that the need to estimate more
\par
uncertain quantities undermines the advantages of greater descriptive realism so much that
\par
the final risk estimates are less certain than the ones traditionally obtained from simpler,
\par
less realistic, statistical curve-fitting models. In opposition to this pessimistic view is the
\par
widespread common-sense notion that including more information in a risk model can
\par
never worsen (and will usually improve) the resulting risk estimates. This paper appeals to
\par
mathematical arguments to resolve these conflicting intuitions. First, it emphasizes the
\par
fact that risk depends on multiple inputs only through a small number of "reduced
\par
quantities" -- perhaps on only one, which would then be defined as internal dose. Thus,
\par
uncertainty about risk may have limited sensitivity to uncertainties in the original input
\par
quantities. The concept of internal dose and its possible algebraic relations to the original
\par
input quantities are clarified using concepts from dimensional analysis. Then, the question
\par
of whether greater model complexity leads to better or worse risk estimates is addressed
\par
in an information-theoretic framework, using entropies of probability distributions to
\par
quantify uncertainties. Within this framework, it is shown that models with greater
\par
intrinsic or "structural" complexity (meaning complexity that can not be eliminated by
\par
reformulating the model in terms of its reduced quantities) lead to better-informed, and\copyright{} COX ASSOCIATES, 1999. 503 Franklin St., Denver, CO, 80218. Ph 303-388-1778; Fax --303-388-0609. tony@cox-associates.com
\par
hence more certain (lower-entropy) risk estimates. The compatibility of this result with
\par
results from decision theory, in which expected loss rather than entropy is used as a
\par
criterion, is discussed.
\par
\textbf{\emph{Key Words: }}response modeling, complexity
\par
Uncertainty analysis, derivation graphs, Monte Carlo simulation, dose-\copyright{} COX ASSOCIATES, 1999. 503 Franklin St., Denver, CO, 80218. Ph 303-388-1778; Fax --303-388-0609. tony@cox-associates.com
\par
\textbf{INTRODUCTION}
\par
There has been much thoughtful debate about the most useful definition of
\par
"internal dose" for predicting and extrapolating risks. This paper attempts to clarify the
\par
problem and to show that, when formulated carefully, the concept of internal dose has
\par
strong implications both for the possible algebraic forms of dose-response functions and
\par
for managing uncertainties in complex risk models. Section 1 examines the concept of
\par
"internal dose", and proposes to define it as a numerical quantity containing the minimal
\par
sufficient information needed to determine risk from administered dose. Section 2
\par
investigates the algebraic consequences of this definition, applying the "product theorem"
\par
from dimensional analysis (Bhaskar and Nigam, 1990, p. 79) to conclude that internal dose
\par
should be expressible as a product of powers of input quantities. This result leads to a
\par
novel derivation of the Weibull dose-response function and some generalizations.
\par
Since internal dose typically depends on more than just administered dose, using
\par
internal doses in risk models generally requires an increase in model complexity.
\par
"Biologically-based" risk assessment (BBRA) models that predict risk based on
\par
calculations of internal (e.g., delivered or biologically effective) doses include additional
\par
biological parameters (e.g., metabolic rate constants, metabolite elimination rates and
\par
partition coefficients) beyond those required in simpler statistical risk models that relate
\par
probability of response directly to administered dose. The additional parameters may be
\par
very uncertain, or even unknown. Thus, the use of BBRA models raises the question of
\par
whether their added complexity leads to risk estimates that are more uncertain, or less
\par
accurate on average, than simpler models that give a cruder conceptual approximation to
\par
biological reality but that represent fewer uncertain input quantities.
\par
Section 3 examines this question in detail and answers it negatively. The reasoning
\par
is roughly as follows. A complex model's output quantities depend on its input quantities
\par
only through certain "reduced quantities" (e.g., internal dose) derived from the input
\par
quantities. Uncertainty about the reduced quantities is never greater (and is usually less)
\par
than uncertainty about the raw inputs -- a result that can be proved formally within an
\par
information-theory framework in which entropy is used to quantify uncertainty about
\par
random variables (Cover and Thomas, 1991). Moreover, even poor information that is
\par
relevant to estimating internal dose (e.g., "noisy" measurements containing large
\par
measurement errors, or measurements of dose surrogates that are only weakly correlated
\par
with the true quantities of interest) leads to better estimates when it is included than when\copyright{} COX ASSOCIATES, 1999. 503 Franklin St., Denver, CO, 80218. Ph 303-388-1778; Fax --303-388-0609. tony@cox-associates.com
\par
it is ignored. Therefore, more complex models that allow (even poor) additional
\par
observations to be brought to bear in estimating a dose-response relation tend to produce
\par
better risk estimates. Section 4 shows that this conclusion, based on entropy measures, is
\par
compatible with conventional "value of information" analysis from Bayesian decision
\par
theory. A simple example is presented to illustrate the Bayesian approach.
\par
On the other hand, a model that is more complex than another only in the sense
\par
that it contains more uncertain quantities (variables and/or parameters) to estimate, but
\par
that does not allow any additional observations, contains what we term "spurious
\par
complexity". It can be simplified, e.g., by algebraically combining unobserved quantities,
\par
without impairing ability to estimate the observable ones. This simplification process,
\par
referred to in this paper as "model reduction", prunes away spurious uncertainties. Failing
\par
to use reduced models can lead to increased uncertainties about outputs (e.g., predicted
\par
risk) when there are more input quantities to estimate, but this is better regarded as an
\par
artifact of improper modeling methodology than as a true relation between model
\par
complexity and uncertainty of model predictions.
\par
\textbf{1. THE CONCEPT OF INTERNAL DOSE}
\par
Recall how internal doses are used by risk assessors. Suppose that administered
\par
dose creates a probability of response in a particular sex, strain, and species. This causal
\par
relationship might be diagrammed as
\par
x {$\rightarrow$} P
\par
or written in algebraic notation as
\par
P = f(x),
\par
where
\par
x = administered dose (e.g., a time series of concentrations of a chemical in inhaled
\par
air)
\par
P = lifetime probability of response (typically estimated from the observed fraction
\par
of animals responding in a bioassay experiment)\copyright{} COX ASSOCIATES, 1999. 503 Franklin St., Denver, CO, 80218. Ph 303-388-1778; Fax --303-388-0609. tony@cox-associates.com
\par
f denotes a dose-response mathematical function mapping values of x to
\par
corresponding values of P
\par
{$\rightarrow$} means "affects the value of". More specifically, the value of any variable is
\par
modeled as being determined by the values of the variables that point into it. This
\par
"derivation graph" notation is explained and used further below.
\par
In practice, it is unlikely that the administered dose is sufficient to completely and uniquely
\par
determine the value of P. Given the value of x and additional relevant information (e.g.,
\par
about the body weight, breathing rate, enzyme and hormone status, individual metabolism,
\par
etc.), one should be better able to predict the value of P than would be possible from
\par
knowledge of the value of x alone.
\par
To indicate that factors other than the administered dose affect the probability of
\par
response, the conceptual model of the dose-response relation might be redrawn as
\par
x {$\rightarrow$} P \textleftarrow{} z
\par
and the algebraic dose-response model rewritten as
\par
P = f(x ; z)
\par
where z is a vector of individual covariates.
\par
The vector z may be partitioned further, e.g., into observed covariates (such as body
\par
weight, age, duration of follow-up period, etc.), unobserved or "latent" variables (such as
\par
individual "susceptibility", "frailty", or "tolerance threshold"), and parameters (covariates
\par
whose values are the same for all individuals in a population, e.g., the sex and strain of the
\par
mice in a particular exposure group). The symbol z will denote any and all quantities
\par
other than x that affect the value of P.
\par
A central problem of applied risk assessment is to predict the value of P for any
\par
pair of input values, (x, z) after observing the responses of animals i = 1, 2, ..., N satisfying
\par
