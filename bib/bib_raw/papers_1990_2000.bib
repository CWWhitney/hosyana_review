@article{cohenEffectConstantOutcome1992,
  title = {The Effect of Constant Outcome Value on Judgments and Decision Making given Linguistic Probabilities},
  author = {Cohen, Brent L and Wallsten, Thomas S.},
  year = 1992,
  month = jan,
  journal = {Journal of Behavioral Decision Making},
  volume = {5},
  number = {1},
  pages = {53--72},
  issn = {0894-3257, 1099-0771},
  doi = {10.1002/bdm.3960050107},
  urldate = {2024-05-03},
  abstract = {Abstract                            Two experiments were performed to determine whether judgments of the relative chances of two independent events occurring are biased by constant outcome values contingent on the events when the uncertainties are specified by linguistic expressions (e.g.               doubtful               ). In Experiment 1, subjects directly judged the relative chances of the two events, of which one was represented by a spinner and the other by a linguistic probability expression. In Experiment 2, only linguistic probability expressions were used to describe the two events and a betting procedure was used. A bias was evident in both studies, such that the relative judgments tended to favour the event with the positive rather than the negative contingent outcome. The bias was smaller for the low- than for the high-probability phrases. Individual differences were great, with the bias appearing strongly in only about one-third of the population. Theoretical implications of the present and related results are discussed.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

@article{cohenScientistStakeholderCollaboration1997,
  title = {Scientist--Stakeholder Collaboration in Integrated Assessment of Climate Change: Lessons from a Case Study of Northwest {{Canada}}},
  shorttitle = {Scientist--Stakeholder Collaboration in Integrated Assessment of Climate Change},
  author = {Cohen, Stewart J.},
  year = 1997,
  journal = {Environmental Modeling and Assessment},
  volume = {2},
  pages = {281--293},
  publisher = {Springer},
  doi = {10.1023/A:1019077814917},
  langid = {english},
  note = {Environmental Modeling and Assessment 2 (1997) 281--293 281
\par
Scientist--stakeholder collaboration in integrated assessment of
\par
climate change: lessons from a case study of Northwest Canada
\par
Stewart J. Cohen
\par
\emph{Environmental Adaptation Research Group, Environment Canada and Sustainable Development Research Institute, University of British Columbia,}
\par
\emph{B5-2202 Main Mall, Vancouver, BC, Canada}
\par
Received 7 February 1997; revised 29 May 1997
\par
Research on the climate change issue has generally focused on uncertainties in climate projections and calculation of mitigation costs.
\par
Most integrated assessment (IA) efforts have been directed at the mitigation component. The problem of climate change, however, is
\par
really about the potential effects on ecosystems, resources, and societies that depend on them. As illustrated by experiences from the
\par
Mackenzie Basin Impact Study, a case study from Northwest Canada, these effects will be unique to each region and country. Many of
\par
these will be indirect, including region specific thresholds, vulnerabilities and adaptations which may not be included in sectoral analyses.
\par
Science can define some of the ``What if'' aspects of climate change, but the regional ``So what'' and ``What should be done'' questions are
\par
largely unanswered and subject to intense debate in various political fora. IA needs to recognize the multiobjective and multistakeholder
\par
aspects of vulnerabilities, risks, and potential responses to climate change. IA could provide a more holistic analysis of the regional
\par
impacts dimension of climate change by including both modeling and non-modeling approaches, and incorporating institutional and
\par
stakeholder issues that do not readily lend themselves to economic analyses.
\par
\textbf{1. Introduction}
\par
The Intergovernmental Panel on Climate Change (IPCC)
\par
has published its Second Assessment Report (SAR). Work-
\par
ing Group I has concluded that recent climatic trends cannot
\par
be ascribed completely to ``natural'' forces. The human in-
\par
fluence on the earth's climate is being felt now. This has
\par
created a sense of urgency among scientists and stakehold-
\par
ers, particularly on the issue of mitigation of greenhouse
\par
gas emissions.
\par
Much of the discussion on policy response in IPCC and
\par
the Conference of the Parties (COP) to the United Nations
\par
Framework Convention on Climate Change (UNFCCC) is
\par
focused on the costs of mitigation options (i.e., how to
\par
reduce greenhouse gas emissions). Comparatively less in-
\par
formation is provided on the benefits of impacts avoided,
\par
including adaptation options. This is reflected in IPCC
\par
Working Group III reports [57] and the literature on IA.
\par
Meanwhile, mitigation efforts are becoming bogged down.
\par
At the present time, most countries report that they will
\par
not reach their emission reduction targets [38]. Political
\par
support for such efforts is relatively weak, although there
\par
are signs emerging from COP-2 (held in Geneva in July,
\par
1996) that this may be changing. Some countries are pur-
\par
suing voluntary programs. Several have entered into Joint
\par
Implementation initiatives, now known as Activities Im-
\par
plemented Jointly (AIJ). These are currently at the pilot
\par
stage [28].
\par
Since the IPCC and COP have been the focal points for
\par
mitigation policy debates, results of IA have attracted con-
\par
siderable attention, and this will certainly continue through-
\par
out the coming years. It is appropriate, therefore, to con-
\par
 Baltzer Science Publishers BV
\par
sider the IA process, and whether it is capturing the full
\par
extent of the climate change issue.
\par
The IPCC considers IA to be a modeling approach that
\par
enables stakeholders to make informed decisions about mit-
\par
igation options [12]. Integrated assessment models (IAM)
\par
have played an important role in the analysis of mitigation
\par
options, and the application of such tools has dominated
\par
much of the results of IPCC Working Group III [83]. The
\par
IPCC SAR includes a comparison of 22 IAMs designed to
\par
address mitigation. Only 8 of these have an impact assess-
\par
ment component beyond indications of changes in tempera-
\par
ture. One of the biggest challenges facing IA is to develop
\par
a credible way to represent and value the impacts of climate
\par
change [83].
\par
Since integrated assessment of climate change has fo-
\par
cused on global scale IAMs, regional adaptation has re-
\par
ceived considerably less attention. This is encouraged by
\par
the conventional thinking that impact costs will be less than
\par
2\% of GDP in a 2\texttimes CO2 scenario for most countries, with
\par
the exception of the small island states or other areas vul-
\par
nerable to sea level rise [57]. This has had the effect
\par
of ``anchoring'' subsequent analyses [63]. It is suggested
\par
here that the integration challenge has an undervalued im-
\par
pacts dimension which is regional in scale, providing con-
\par
text for analysis of adaptation as a complement to mitiga-
\par
tion.
\par
A number of reviewers are raising questions about the
\par
IAM approach, particularly its representation of stakeholder
\par
interests, parameterizations of the complexities of impacts
\par
and adaptation, and the dependence of traditional economic
\par
analyses on interest rates which are difficult to apply to
\par
assessments of ecosystem impacts [27,72,78].282 \emph{S.J. Cohen / Scientist--stakeholder collaboration in integrated assessment of climate change}
\par
Impacts description and valuation is considered to be
\par
a weak area in IA [54], but this is not solely a question
\par
of economics. The narrow dimensions of the current de-
\par
bate on climate change may be a consequence of the lack
\par
of attention given to the needs of stakeholders who may be
\par
affected by the impacts of climate change on land, fresh wa-
\par
ter and marine resources [18]. Many developing countries
\par
may become marginalized in the global dialogue on climate
\par
issues if the focus continues to be on greenhouse gas emis-
\par
sions, and not the consequences of failure to control emis-
\par
sions [34]. There is a need to recognize the importance of
\par
stakeholder participation [79], which is dependent on pub-
\par
lic understanding of climate change. Increased \emph{awareness}
\par
of issues like climate change, global environmental change
\par
and sustainable development are not necessarily indicative
\par
of the level of public \emph{understanding }[76]. Parson [55]
\par
suggests that stakeholder values are more important than
\par
scientific uncertainty, and that reduction of uncertainty is
\par
unlikely to reduce policy conflicts.
\par
Some perspectives from a case study from Northwest
\par
Canada are presented in order to illustrate an IA alterna-
\par
tive, in which several different integration exercises, includ-
\par
ing models, are combined with sectoral analyses and stake-
\par
holder participation to provide a more holistic approach
\par
to IA of climate change. This approach includes stake-
\par
holder participation in the formation of research questions,
\par
the generation of new information, and the discussion on
\par
results and recommendations. This ``learning by doing'' ap-
\par
proach has been employed in exercises to get stakeholders
\par
to identify policy options [82], but this also assumes un-
\par
derstanding of all dimensions of the climate change issue,
\par
including the impacts and adaptation dimension. It is sug-
\par
gested that a broad ``scientists--stakeholder collaborative''
\par
(s--s) could be a useful framework for producing an IA of
\par
climate change impacts for regions and countries. Such a
\par
collaborative could make use of IAMs and other tools, and
\par
would also be able to try non-modeling approaches. This
\par
is consistent with Parson's [55] suggestion for multi-actor
\par
representation in the development and use of assessments.
\par
\emph{2.1. A research and consulting framework}
\par
In the s--s approach, the project leader begins by or-
\par
ganizing a steering committee composed of scientists and
\par
stakeholders with an interest in the issue, either because
\par
of the topic, or the study area, or both. Government and
\par
non-government stakeholders need to be part of this.
\par
The steering committee would have several tasks as part
\par
of its terms of reference. First, it would define critical is-
\par
sues, and if necessary, critical regions within the study area,
\par
that the IA should focus on. These might differ from those
\par
that would be defined by scientists alone. Second, it would
\par
play a role in identifying scenarios for the IA, including
\par
baseline economic and population scenarios which provide
\par
context for the climate change impact assessment. Third,
\par
it would review and rank proposals for sectoral and cross-
\par
sectoral research activities within the IA, using a broad
\par
range of criteria. Such activities would have to show that
\par
they could address the study's critical issues. Good science,
\par
by itself, would not be enough for a high ranking. Finally,
\par
it would facilitate communication between scientists and
\par
stakeholders (``vertical'' integration), and between scientists
\par
of various disciplines (``horizontal'' integration). This kind
\par
of communication does not necessarily happen on its own.
\par
\emph{2.2. Expert judgment as part of integration}
\par
\textbf{2. Scientist--stakeholder collaboration as a component}
\par
\textbf{of integrated assessment}
\par
Although the IPCC has tended to view IA through the
\par
IAM, there are many other ways to combine information
\par
from various sources for the purpose of assessing climate
\par
change. Current practice in IA can be categorized into
\par
eight types of exercises (table 1). Some of these (analogue,
\par
education, expert judgement, themes and places) use non-
\par
model exercises to combine information, and may be per-
\par
ceived as more accessible to stakeholders, but it is also pos-
\par
sible to draw stakeholders into assessments using decision-
\par
support models and testing of instruments. A particular
\par
scientist--stakeholder (s--s) collaborative may, in fact, con-
\par
sist of a range of integration exercises. The point is that
\par
the issue, rather than a particular analysis tool, should be
\par
the guide.
\par
Expert judgment plays an important role in the s--s ap-
\par
proach. Expert judgment, including stakeholders' views,
\par
are dependent on subjective personal opinions which are
\par
not always transparent, and can be difficult to reproduce
\par
and explain. In the case of traditional knowledge (TK), an
\par
important medium for aboriginal people to present their in-
\par
formation about ecosystems, there are strongly held cultural
\par
beliefs that underlie opinions expressed by participants. TK
\par
is a collection of rules of thumb acquired through a trial and
\par
error process over a long time [30]. The cultural context
\par
differs from western science, and there is a preference for
\par
research that is defined and controlled by the community
\par
rather than ``outsiders'' [39].
\par
There are some cases in which s--s has been developed
\par
in order to obtain community support for assessing com-
\par
plex issues related to the environment. The New Zealand
\par
Climate Change Programme established the Maori Working
\par
Group as part of its national study [50]. Its role was to work
\par
with the Programme's Steering Group, Policy Group, and
\par
various technical groups [29]. Within the Mackenzie Basin
\par
region of Northwest Canada, a water resources research
\par
project, known as the Northern River Basins Study, created
\par
a First Nations Committee and a TK working group [22,53].
\par
Expert judgment is also a sub-component of other sec-
\par
toral and integration exercises through the experiences and
\par
biases of the investigators, whether or not a ``model'' is
\par
used. Stakeholders can be part of model-based exer-
\par
cises, particularly techniques such as Analytic Hierarchy
\par
Process which involve the characterization of goals or pref-
\par
erences [88]. At earlier stages of the assessment, during the\emph{S.J. Cohen / Scientist--stakeholder collaboration in integrated assessment of climate change }Table 1
