  title = {Uncertainty, Climate Change and the Economic Value of Information: An Economic Methodology for Evaluating the Timing and Relative Efficacy of Alternative Response to Climate Change with Application to Protecting Developed Property from Greenhouse Induced Sea Level Rise},
  shorttitle = {Uncertainty, Climate Change and the Economic Value of Information},
  author = {Yoke, Gary W.},
