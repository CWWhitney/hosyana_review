  langid = {english},
  note = {\textbf{Pergamon}
\par
S0277-9536(96)00221-3
\par
\emph{Soc. Sci. Med. }Vol. 44, No. 5, pp. 681-692, 1997
\par
Copyright \copyright{} 1997 Elsevier Science Ltd
