@article{hammittEvaluationEndpointsClimate1999,
  title = {Evaluation Endpoints and Climate Policy: Atmospheric Stabilization, Benefit-Cost Analysis, and near-Term Greenhouse-Gas Emissions},
  shorttitle = {Evaluation Endpoints and Climate Policy},
  author = {Hammitt, James K.},
  year = 1999,
  month = mar,
  journal = {Climatic Change},
  volume = {41},
  number = {3},
  pages = {NaN-NaN},
  issn = {1573-1480},
  doi = {10.1023/A:1005499206442},
  urldate = {2024-07-22},
  abstract = {The Framework Convention on Climate Change calls for stabilizing atmospheric concentrations of carbon dioxide and other greenhouse gases. In contrast, many economists espouse the goal of minimizing the present value of abatement costs and damages. The choice between evaluation endpoints -- least-cost stabilization and maximization of benefits less costs -- involves a tradeoff between accuracy and relevance. Atmospheric concentrations associated with candidate abatement policies can be more accurately predicted, for any level of confidence, than can the monetary values of climate damages associated with those policies. The monetary value of damages is more relevant to the question of what resources should be devoted to abatement, however, because atmospheric concentrations are of little interest except as they influence climate and its impacts on economic activities, ecosystems, and other elements of human concern. As demonstrated using both analytic and numerical models, the choice between endpoints is not solely a matter of analytic convenience but has substantive implications when comparing near-term abatement policies. For the next few decades, maximization of benefits less costs is likely to require greater abatement than will cost-effective stabilization of atmospheric concentrations.},
  langid = {english},
  keywords = {Carbon Dioxide,Climate Change,Dioxide,Economic Activity,Endpoint},
  note = {\textbf{EVALUATION ENDPOINTS AND CLIMATE POLICY: ATMOSPHERIC}
\par
\textbf{STABILIZATION, BENEFIT-COST ANALYSIS, AND NEAR-TERM}
\par
\textbf{GREENHOUSE-GAS EMISSIONS}
\par
JAMES K. HAMMITT
\par
\emph{Center for Risk Analysis and Department of Health Policy and Management, Harvard School of}
\par
\emph{Public Health, 718 Huntington Ave., Boston, MA 02115, U.S.A.}
\par
\emph{E-mail: jkh@hsph.harvard.edu}
\par
\textbf{Abstract. }The Framework Convention on Climate Change calls for stabilizing atmospheric concen-
\par
trations of carbon dioxide and other greenhouse gases. In contrast, many economists espouse the goal
\par
of minimizing the present value of abatement costs and damages. The choice between evaluation
\par
endpoints -- least-cost stabilization and maximization of benefits less costs -- involves a tradeoff
\par
between accuracy and relevance. Atmospheric concentrations associated with candidate abatement
\par
policies can be more accurately predicted, for any level of confidence, than can the monetary values
\par
of climate damages associated with those policies. The monetary value of damages is more relevant
\par
to the question of what resources should be devoted to abatement, however, because atmospheric
\par
concentrations are of little interest except as they influence climate and its impacts on economic ac-
\par
tivities, ecosystems, and other elements of human concern. As demonstrated using both analytic and
\par
numerical models, the choice between endpoints is not solely a matter of analytic convenience but has
\par
substantive implications when comparing near-term abatement policies. For the next few decades,
\par
maximization of benefits less costs is likely to require greater abatement than will cost-effective
\par
stabilization of atmospheric concentrations.
\par
\textbf{1. Introduction}
\par
Decision making about actions to abate global climate change is complicated by
\par
daunting uncertainty about the consequences of choosing alternative emission
\par
paths of carbon dioxide and other greenhouse gases (GHGs). Several alternative
\par
objectives and corresponding endpoints for evaluating abatement policies have
\par
been considered, including limiting anthropogenic emissions of GHGs, stabilizing
\par
atmospheric GHG concentrations, limiting the magnitude or rate of increase of
\par
global mean surface temperature, and maximizing the difference between benefits
\par
and costs of abatement. The choice of evaluation endpoint requires making trade-
\par
offs between desired criteria, notably the relevance of the endpoint (the extent to
\par
which it captures consequences that are of direct interest to policy makers) and the
\par
accuracy with which future levels of the endpoint can be projected under alternative
\par
policies.
\par
The choice between endpoints is not simply one of analytic convenience; it
\par
may also affect the apparent merits of alternative policies. In particular, `optimal'
\par
policies based alternatively on benefit-cost analysis and on stabilizing GHG con-
\par
\emph{Climatic Change }\textbf{41: }447--468, 1999.
\par
\copyright{} 1999 \emph{Kluwer Academic Publishers. Printed in the Netherlands.}448 JAMES K. HAMMITT
\par
centrations at least cost differ systematically, with policies based on benefit-cost
\par
analysis generally requiring larger near-term reductions in GHG emissions.{$\ast$}
\par
The systematic effect of the evaluation endpoint on the assessed merits of alter-
\par
native policies is examined here using a simple analytic model and the magnitude
\par
of the effect is evaluated using a numerical integrated-assessment model. The intu-
\par
ition is straightforward: the present value of abatement costs is likely to be reduced
\par
by deferring emission reductions to the future, due to discounting future costs to
\par
reflect the opportunity cost of capital, anticipated improvements in abatement tech-
\par
nologies, avoidance of premature depreciation of existing physical and human capi-
\par
tal, and the existence of oceanic and other sinks that remove greenhouse gases from
\par
the atmosphere (Wigley et al., 1996). Under a stabilization objective, emissions
\par
are harmful only to the extent that they interfere with achieving the stabilization
\par
goal. Within limits, higher near-term emissions can be offset by greater subsequent
\par
emission reductions. In contrast, both near-term and future damages from climate
\par
change are accounted for under a benefit-cost objective. Near-term damages from
\par
climate change cannot be prevented by future emission reductions (although the
\par
monetary value of near-term damages may be compensated by decreasing future
\par
damages). In short, near-term and future abatement costs are counted under both
\par
objectives, but near-term consequences of emissions are counted only under the
\par
benefit-cost objective.
\par
Alternative evaluation endpoints and criteria for choosing among them are dis-
\par
cussed in Section 2. The result that optimal near-term emission reductions are
\par
larger under a benefit-cost than a least-cost stabilization objective is established
\par
using an analytic model in Section 3. The magnitude of the difference in near-term
\par
emission paths for a variety of stabilization levels and climate-damage functions
\par
is evaluated using an integrated assessment model in Section 4. Conclusions are
\par
presented in Section 5.
\par
\textbf{2. Endpoints for Policy Evaluation}
\par
The Framework Convention on Climate Change calls for `stabilization of green-
\par
house-gas concentrations . . . at a level that would prevent dangerous anthropogenic
\par
interference with the climate system'. Although an appropriate level has not been
\par
identified, emission paths that stabilize carbon dioxide concentrations at several
\par
levels have been constructed (Schimel et al., 1995; Wigley et al., 1996).\dag{} An
\par
economic-welfare perspective suggests an alternative goal, maximizing the differ-
\par
ence between the benefits of reducing climate change and the costs of abatement.
\par
This approach has been widely used in integrated-assessment modeling (Cline,
