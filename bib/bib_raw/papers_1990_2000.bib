@article{forgionneQualitativeThinkingSupport1995,
  title = {Qualitative Thinking Support Systems ({{QTSS}})},
  author = {Forgionne, Guisseppi A. and Clements, James P. and Newman, John},
  year = 1995,
  month = jan,
  journal = {Journal of Decision Systems},
