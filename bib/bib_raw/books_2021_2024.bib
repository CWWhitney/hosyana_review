@book{abu-salihSocialBigData2021,
  title = {Social Big Data Analytics: Practices, Techniques, and Applications},
  shorttitle = {Social Big Data Analytics},
  author = {{Abu-Salih}, B. and Wongthongtham, P. and Zhu, D. and Chan, K.Y. and Rudra, A.},
  year = 2021,
  series = {Social {{Big Data Analytics}}: {{Practices}}, {{Techniques}}, and {{Applications}}},
  pages = {218},
  doi = {10.1007/978-981-33-6652-7},
  abstract = {Over the past few decades, people have been able to exchange knowledge and experiences at high speed, overcoming the constraints of time and space. This has naturally led to the dissolution of cultural differences between groups and individuals. These new information and communication technologies have opened new horizons and brought profound changes to various aspects of human, cultural, intellectual and social life. These technologies have been leveraged by the extensive use and the prevalence of the Internet, which have not only produced enormous technical, economic, educational, and social benefits for humanity, but have also contributed to the emergence of new forms of media which consist of different norms, orientations and means. Social media is one of the most significant outcomes of the communication revolution. Social media has established various means by which people can exchange knowledge, thoughts, expertise, interests and visions. Social media has also enabled people to generate and actively engage with online published contents. The online social services have expanded and produced explosive propagation of social data that led to coining the term "Social Big Data". This new notion, which has manifested a combination of two terms ``social media'' and ``big data'', established new research arenas and produced new dissimilar aspects to comprehend the social impact of such digital environments. Therefore, the applications of Social Big Data span a wide variety of domains and motivate researchers to design effective solutions that are capable of mining enormous amounts of social data. Simultaneously, companies incorporate advanced social data analytics to extract high-quality, relevant and meaningful information that offers a plethora of benefits to enhance the decision-making process. In this context, social data analysis is an evolving task which joins various disciplines such as social credibility, semantic discovery, sentiment analysis, affective design and big data computing. As an example, it is essential to measure social credibility in numerous domains since Social Big Data is derived from a variety of sources. Another important reflection is the semantics of extracted social textual data from which meaningful information can be derived. Also, the era of Social Big Data has exposed several fertile resources from which a large scale of big affective data can be discovered and collected. Last but not least, development of opinion mining and sentiment analysis techniques to extract and summarise sentiment data effectively can assist to hear voice of the customer and voice of the market obtained from social media. This book is aimed to provide academics, professional and technical practitioners with a review of the current state-of-the-art approaches for Social Big Data analytics, as well as to present dissimilar methods to infer value from social data. This book first presents an overview of the notion of Social Big Data and the big data ecosystem including a discussion on big data characteristics and the latest technology stacks. The book further examines several areas of research that benefits from the propagation of social data. In particular, the book presents a correlated array of substantial applications and technical data analytics that are effective to handle big data features, to filter out unsolicited data, to measure the quality of the inferred data and to transform the amended data for further data analysis. Moreover, this book reports solutions to derive knowledge and sentiments from Social Big Data, and to provide social data classification and prediction. These technical solutions improve the overall comprehension of the processed textual datasets and deliver knowledge in the form of unambiguous results. These approaches incorporate several technologies such as semantic discovery, sentiment analysis, affective computing and machine learning that will be thoroughly discussed in chapters of this book.},
  langid = {english},
  keywords = {read CW},
  file = {/Users/corywhitney/Zotero/storage/AWBXKXGE/Abu-Salih et al. - 2021 - Social Big Data Analytics Practices, Techniques, .pdf}
}

@book{abubakar13thconferenceproceedingscomplete2022,
  title = {13th-Conference-Proceedings-Complete},
  author = {Abubakar, Ali},
  year = 2022,
  month = aug,
  abstract = {Abstract  This study assessed the relationship between employees' performance and discrimination in Kaduna Polytechnic. Over the years issues of discrimination at work place has been treated with levity and recent studies shows that victims of discrimination suffer emotional trauma. It is envisage that this emotional trauma could affect employee output. The study adopts cross sectional survey research design and through the stratified random sampling. Sample of 400 employees of Kaduna Polytechnic were selected for the study. The major technique used for data analysis is ANOVA and multiple regression. It was used to test if there is any significant relationship between the four independent variables and employees' performance. The result shows a significant relationship in three of the independent variables which includes age discrimination, region/ethnic discrimination and religion discrimination. Only one of the independent variable which is gender discrimination indicates that there is no significant relationship between it and employees performance. It was recommended that; thorough screening of applicant is needed in other to avoid hiring people who are unable or unwilling to respect the right of their co-workers and also, mixing of generations and different ethnic group in the workplace should be encourage as this will foster unity. This will to a great extent reduce or eradicate completely discrimination at work place.},
  langid = {english},
  file = {/Users/corywhitney/Zotero/storage/DP7SJ7ZE/Abubakar - 2022 - 13th-Conference-Proceedings-Complete.pdf}
}

