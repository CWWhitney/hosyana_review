@article{pyrczUncertaintyReservoirModeling2015a,
  title = {Uncertainty in Reservoir Modeling},
  author = {Pyrcz, Michael J. and White, Christopher D.},
  year = 2015,
  month = mar,
  journal = {Interpretation-a Journal of Bible and Theology},
  volume = {3},
  number = {2},
  pages = {SQ7-SQ19},
  issn = {2324-8858},
  doi = {10.1190/INT-2014-0126.1},
  urldate = {2023-05-25},
  abstract = {Uncertainty is due to incomplete and imprecise knowledge as a result of limited sampling of the subsurface heterogeneities. Well data and seismic data have incomplete coverage and finite resolution. The interpretations are uncertain. Reservoirs are heterogeneous and difficult to predict away from wells. Ignoring uncertainty and locking in important model parameters and choices amounts to an assumption of perfect knowledge and is generally an unacceptable approach. Uncertainty must be explicitly modeled. Understanding the (1) sources of uncertainty, (2) methods to represent uncertainty, (3) the formalisms of uncertainty, and (4) uncertainty modeling methods and workflows were essential for the integration of all reservoir information sources and providing good models for decision making in the presence of uncertainty.},
  langid = {english},
  note = {Publisher: Society of Exploration Geophysicists and American Association of Petroleum \dots{}},
  file = {/Users/corywhitney/Zotero/storage/AGKHJUNZ/sfx_ubo.html;/Users/corywhitney/Zotero/storage/KT65QZKI/Uncertainty-in-reservoir-modeling.html;/Users/corywhitney/Zotero/storage/V7VEVXMU/Uncertainty-in-reservoir-modeling.html;/Users/corywhitney/Zotero/storage/WSLV7VI6/sfx_ubo.html}
