  langid = {english},
  note = {Publisher: Taylor \& Francis
\par
\textbf{The Impact of IT Governance on IT Capability}
\par
\textbf{and Firm Performance}
\par
\emph{Research-in-Progress}
\par
\textbf{Peiqin Zhang}
\par
Texas State University
\par
McCoy College of Business
\par
Administration
\par
601 University Drive, San Marcos, TX
