@book{thompsonDisputedDecisionsWorld2019,
  title = {Disputed Decisions of World War {{II}}: Decision Science and Game Theory Perspectives},
  shorttitle = {Disputed Decisions of World War {{II}}},
  author = {Thompson, Mark},
  year = 2019,
  month = dec,
  publisher = {McFarland},
  abstract = {A former Harvard professor of decision science and game theory draws on those disciplines in this review of controversial strategic and tactical decisions of World War II. Allied leaders--although outstanding in many ways--sometimes botched what now is termed meta-decision making or deciding how to decide. Operation Jubilee, a single-division raid on Dieppe, France, in August 1942, for example, illustrated the pitfalls of groupthink. In the Allied invasion of North Africa three months later, American and British leaders fell victim to the planning fallacy: having unrealistically rosy expectations of an easy victory. In Sicily in the summer of 1943, they violated the millennia-old principle of command unity--now re-endorsed and elaborated on by modern theorists. Had Allied strategists understood the game theory of bluffing, in January 1944 they might well not have landed two-plus divisions at Anzio in Italy.},
  googlebooks = {G9rKDwAAQBAJ},
  isbn = {978-1-4766-8004-0},
  langid = {english}
}

@book{violetteEstimatingSavingsPersistence2019,
  title = {Estimating Savings Persistence -- Value of Information and Continuous Learning Approaches},
  author = {Violette, Daniel and Moaz, Karen},
  year = 2019,
  month = sep,
  abstract = {Persistence of energy savings for DSM programs is one of the more uncertain factors in assessing cost effectiveness of DSM investments. This uncertainty is compounded by the high cost of verifying persistence, particularly for those measures with medium to longer-term expected useful lives (EULs). Field studies to verify an EUL of greater than, for example, 8 years can require field data from both before and after the 8-year expected life to produce direct estimates of the EUL median value. The high cost of in-field EUL research along with the complexities of multi-year experimental designs makes identifying cost-effective research approaches important for the industry. All of these issues are now challenges for ComEd as the passage of the Illinois Future Energy Jobs Act (FEJA) now sets savings goals in terms of attained ``cumulative persisting annual savings'' (CPAS).  This paper presents innovative approaches currently being used by ComEd to address challenges associated with producing estimates of cumulative persisting savings of its programs. These approaches draw from a broad literature on prioritizing research and development (R\&D) investments widely used in industries such as pharmaceuticals, oil and gas exploration, and computer technology. They are based on structured decision analyses and value of information (VOI) methods that examine where research efforts are likely to have the greatest value in estimating savings. While these approaches have wide adoption in other industries, they have had limited application to DSM evaluation and research.},
  langid = {english},
  file = {/Users/corywhitney/Zotero/storage/JKAUVUJL/Violette and Moaz - 2019 - Estimating Savings Persistence – Value of Informat.pdf}
}

