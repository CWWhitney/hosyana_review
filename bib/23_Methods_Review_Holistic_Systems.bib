@book{karndacharuk_road_2017,
	title = {Road transport management framework and principles},
	abstract = {The purpose of the project was to review the international and local practices in road transport management (RTM) in order to inform the development of a harmonised RTM framework. Fifteen interrelated topics that are of relevance to Australasian road transport agencies have been identified through a literature review, a review of current RTM practice in Australia and New Zealand and stakeholder consultation. They constitute the principles that underpin the proposed RTM framework. 

Enabling a safe, efficient, reliable and sustainable road transport system is a key objective of the RTM framework. The interconnectivity of the principles is demonstrated in the RTM landscape that consists of mobility, safety, asset, technology aspects along with the triple bottom line of economic, social and environmental considerations.

The adoption of new and emerging transport technologies, particularly those related to electric, connected and autonomous vehicles, and the increasing demand for a better use of Intelligent Transport System for road and transport management will alter how the RTM principles interact in the four main areas of mobility, safety, asset and technology. Nonetheless, the relevance of the RTM framework and principles can be considered in the context of integrated system planning focusing on the whole jurisdiction, an entire city or region and at the transport network level, to more detailed planning that occurs at corridor, route and link levels. The framework can also be applied to the infrastructure asset life cycle from strategic and solution planning, design and construction, and operation and maintenance.},
	language = {en},
	author = {Karndacharuk, Auttapone and Hassan, Asif},
	month = sep,
	year = {2017},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/VETDEJG4/Karndacharuk and Hassan - 2017 - Road Transport Management Framework and Principles.pdf:application/pdf},
}

