@article{zangPrioritizingAdditionalData2020,
	title = {Prioritizing additional data collection to reduce decision uncertainty in the {HIV}/{AIDS} response in 6 {US} cities: a value of information analysis},
	volume = {23},
	issn = {1098-3015},
	shorttitle = {Prioritizing additional data collection to reduce decision uncertainty in the {HIV}/{AIDS} response in 6 {US} cities},
	url = {https://www.sciencedirect.com/science/article/pii/S1098301520343503},
	doi = {10.1016/j.jval.2020.06.013},
	abstract = {Objectives The ambitious goals of the US Ending the HIV Epidemic initiative will require a targeted, context-specific public health response. Model-based economic evaluation provides useful guidance for decision making while characterizing decision uncertainty. We aim to quantify the value of eliminating uncertainty about different parameters in selecting combination implementation strategies to reduce the public health burden of HIV/AIDS in 6 US cities and identify future data collection priorities. Methods We used a dynamic compartmental HIV transmission model developed for 6 US cities to evaluate the cost-effectiveness of a range of combination implementation strategies. Using a metamodeling approach with nonparametric and deep learning methods, we calculated the expected value of perfect information, representing the maximum value of further research to eliminate decision uncertainty, and the expected value of partial perfect information for key groups of parameters that would be collected together in practice. Results The population expected value of perfect information ranged from \$59 683 (Miami) to \$54 108 679 (Los Angeles). The rank ordering of expected value of partial perfect information on key groups of parameters were largely consistent across cities and highest for parameters pertaining to HIV risk behaviors, probability of HIV transmission, health service engagement, HIV-related mortality, health utility weights, and healthcare costs. Los Angeles was an exception, where parameters on retention in pre-exposure prophylaxis ranked highest in contributing to decision uncertainty. Conclusions Funding additional data collection on HIV/AIDS may be warranted in Baltimore, Los Angeles, and New York City. Value of information analysis should be embedded into decision-making processes on funding future research and public health intervention.},
	language = {en},
	number = {12},
	urldate = {2022-12-09},
	journal = {Value in Health},
	author = {Zang, Xiao and Jalal, Hawre and Krebs, Emanuel and Pandya, Ankur and Zhou, Haoxuan and Enns, Benjamin and Nosyk, Bohdan},
	month = dec,
	year = {2020},
	keywords = {metamodel},
	pages = {NaN--NaN},
	annote = {Export Date: 05 May 2024; Cited By: 3},
	annote = {Publisher: Elsevier},
	file = {Accepted Version:/Users/corywhitney/Zotero/storage/I3AUMVD5/Zang et al. - 2020 - Prioritizing Additional Data Collection to Reduce .pdf:application/pdf;Available Version (via Google Scholar):/Users/corywhitney/Zotero/storage/CTUNIZWI/S1098301520343503.html:text/html;Available Version (via Google Scholar):/Users/corywhitney/Zotero/storage/45Z9HUGI/S1098301520343503.html:text/html;Full Text:/Users/corywhitney/Zotero/storage/QRKVNVVW/S1098301520343503.html:text/html;S1098301520343503:/Users/corywhitney/Zotero/storage/C63A7N9A/S1098301520343503.html:text/html;S1098301520343503:/Users/corywhitney/Zotero/storage/GAY26KX9/S1098301520343503.html:text/html;Zang et al. - 2020 - Prioritizing Additional Data Collection to Reduce:/Users/corywhitney/Zotero/storage/55G2IW97/Zang et al. - 2020 - Prioritizing Additional Data Collection to Reduce .pdf:application/pdf},
