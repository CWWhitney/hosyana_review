@article{lewis_phase_1965,
	title = {Phase theory and the judicial process},
	volume = {1},
	url = {https://heinonline.org/HOL/P?h=hein.journals/cwlr1&i=9},
	language = {en},
	urldate = {2024-05-03},
	journal = {California Western Law Review},
	author = {Lewis, Ovid C.},
	year = {1965},
	keywords = {read CW},
	pages = {NaN--NaN},
	annote = {Annotations(5/16/2024, 5:52:06 PM)
“Studies of the judicial process are essentially inquiries into the methods by which judges make decisions in the cases brought before them. The purpose of this article is to propose an approach to the study of the judicial process which allows for constructive eclecticism while providing a framework within which one can relate proliferating jurimetric and behavioral studies to the judicial process.'” (Lewis, 1965, p. 2)“It is proposed that since judges are problem-solvers, albeit of a highly specialized variety, their behavior is subject to the same general psychological and logical constraints that affect problem-solvers in general. These constraints are best understood by viewing a case as a problem and the judge as a problem-solver.” (Lewis, 1965, p. 2)“The phase theory is undoubtedly more prescriptive than descriptive since judges do not actually become involved in each stage in most cases either consciously or unconsciously.” (Lewis, 1965, p. 3)“But in the difficult problem cases where reflective5 or critical thinking' is required, most of the six phases may be involved.” (Lewis, 1965, p. 3)“In any case, the requirement of principled decision-making implies that the judge ought to behave in accordance with a similar sequence of operations. Jurimetric and behavioral developments portend to require explicit analysis of at least some of the phases, e.g. electronic retrieval material” (Lewis, 1965, p. 3)“"Critical thinking calls for a persistent effort to examine any belief or supposed form of knowledge in the light of the evidence that supports it and the further conclusions to which it tends. It also generally requires ability to recognize problems, to find workable means for meeting those problems, to gather and marshal pertinent information, to recognize unstated assumptions and values, to comprehend and use language with accuracy, clarity, and discrimination, to interpret data, to appraise evidence and evaluate arguments, to recognize the existence (or non-existence) of logical relationships between propositions, to draw warranted conclusions and generalizations, to put to test the conclusions and generalizations at which one arrives, to reconstruct one's patterns of beliefs on the basis of wider experience, and to render accurate judgments about specific things and qualities in everyday life." GLASER, AN EXPERI. MENT IN THE DEVELOPMENT OF CRITICAL THINKING 6 (1941).” (Lewis, 1965, p. 3)“Simply stated, motivation is tension directed toward a goal the attainment of which results in tension reduction.” (Lewis, 1965, p. 5)“Simply stated, motivation is tension directed toward a goal the attainment of which results in tension reduction." Implicit in this formulation are three conceptual elements: "the individual's expectation about what are satisfying objects or events; the actual satisfying or dissatisfying object or event” (Lewis, 1965, p. 5)“Simply stated, motivation is tension directed toward a goal the attainment of which results in tension reduction." Implicit in this formulation are three conceptual elements: "the individual's expectation about what are satisfying objects or events; the actual satisfying or dissatisfying object or event ... [the goal or end]; and the tension ...directed to this state ...[motive." '2” (Lewis, 1965, p. 5)“motive is simply the force that impels decision” (Lewis, 1965, p. 6)
},
	annote = {““To fully explicate the interrelationship of the characteristics of a particular problem-solver and a given problem a phase theory of the decision process is adopted, postulating that there are six significant phases or stages involved in problem solving: (1) presentation or identification of the problem (2) obtaining the relevant information; (3) production of potential solutions; (4) evaluation of the available solutions; (5) selection of a strategy or means to effectuate the solution selected; (6) actual performance of the solution and subsequent learning and revision.'” (Lewis, 1965, p. 3)
},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/9PK2L54X/Lewis - 1965 - Phase Theory and the Judicial Process.pdf:application/pdf},
}

