@article{rand_resilience_2020,
	title = {A resilience matrix approach for measuring and mitigating disaster-induced population displacement},
	volume = {42},
	issn = {2212-4209},
	url = {https://www.sciencedirect.com/science/article/pii/S2212420919303048},
	doi = {10.1016/j.ijdrr.2019.101310},
	abstract = {Globally, risk factors for population displacement due to major disasters are on the rise. These factors include the increasing frequency of extreme weather events, aging infrastructure, growing populations, and increasing urbanization. In cases of widespread damage, tools are needed to support complicated multiyear reconstruction efforts so that populations can return. We adapt the resilience matrix approach [1] as an organizing framework and resilience assessment tool to the problem of population displacement under conditions of damaged infrastructure. The resulting Population Resilience Matrix (PRM) links infrastructure reconstruction directly to the goal of reducing displacement due to infrastructure damage through performance metrics across the physical, social, information, and project management domains. This approach yields a summary of status and priorities that accounts for funding availability and the multi-phase recovery process. The PRM is applied to a synthetic extreme flood scenario, and includes detailed event-specific, locally relevant recovery assessment metrics. A practical approach to identifying the contributions of interdependent infrastructure systems to displacement is also outlined. The PRM is intended to support decision makers with coordinating roles, such as local disaster recovery managers. This approach is compatible with and complementary to US guidance on pre- and post-disaster planning and can also be applied internationally.},
	language = {en},
	urldate = {2023-10-25},
	journal = {International Journal of Disaster Risk Reduction},
	author = {Rand, Krista and Kurth, Margaret and Fleming, Cody H. and Linkov, Igor},
	month = jan,
	year = {2020},
	keywords = {Infrastructure interdependencies, Migration, Recovery, Resilience},
	pages = {101310},
	file = {ScienceDirect Full Text PDF:/Users/corywhitney/Zotero/storage/B7CH639H/Rand et al. - 2020 - A resilience matrix approach for measuring and mit.pdf:application/pdf;ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/4NLUQ3MM/S2212420919303048.html:text/html},
}

