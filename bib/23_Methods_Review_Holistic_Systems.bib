@phdthesis{huynh_episol_nodate,
	address = {Ann Arbor, United States},
	type = {Doctoral dissertation},
	title = {Episol study simulator 1.0: a tool to design cost-efficient epidemiological studies},
	copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
	shorttitle = {Episol study simulator 1.0},
	url = {https://www.proquest.com/docview/1508258435/abstract/C64F0923A66C4971PQ/1},
	abstract = {Background: Top-down approaches have been implemented with varying results to control the rising cost of conducting epidemiological studies. We introduce bottom-up approaches to design and conduct cost-efficient epidemiological studies.
Objectives: We aimed to 1. systematically assess published comparisons of operational processes (recruitment, retention, or follow-up strategies) in studies that report the cost of conducting the study; 2. develop a cost function to guide decisions about trade-offs to be made in clinical trial design; 3. design a simulation model that mimics the operational processes in epidemiological studies; and 4. use the EpiSol Study Simulator to determine cost-efficient designs.
Methods: Our systematic review included studies where participants were assigned to two or more operational processes. Economic evaluation techniques compared the cost of studies that randomized operational processes. For the cost function, we took the first order partial derivatives of the Lagrange function. For the third objective, we used data from a randomized controlled trial (Surgical Treatments Outcomes Project for Dysfunctional Uterine Bleeding – STOP-DUB) and a prospective observational study (Longitudinal Study of Ocular Complications of AIDS – LSOCA) to design and calibrate the discrete event simulation model in Arena. We varied follow-up periods to determine cost-efficient designs.
Results: Over 95\% of the included studies (N=58) reported the comparison of recruitment strategies. We found that investing additional resources to recruit participants yielded between 4\% to 23\% additional participants. In the constrained optimization problem, the partial derivatives provided information about the shadow cost with respect to the number of clinical sites, the number of follow-up visits, and the study duration. To minimize the cost of the study, the shadow costs of all three choice variables should be equal. The EpiSol Study Simulator simulated values that were similar to selected parameters in STOP-DUB and LSOCA. The simulator forecasted the impact of the trade-offs on key outcomes such as cost of clinic reimbursement and power to detect differences in patient-reported outcomes.
Conclusions: Our research provides tools that help investigators to explicitly consider different options for design parameters and reduce the multi-dimensionality of decisions in making complex trade-offs.},
	language = {en},
	urldate = {2023-10-19},
	author = {Huynh, Lynn},
	note = {ISBN: 9781303769955},
	keywords = {Operational process, bin, read CW},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/ME9LPLEL/Huynh - Episol study simulator 1.0 A tool to design cost-.pdf:application/pdf},
}

