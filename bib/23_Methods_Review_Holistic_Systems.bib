@article{brazier_identification_2019,
	title = {Identification, review, and use of health state utilities in cost-effectiveness models: an {ISPOR} good practices for outcomes research task force report},
	volume = {22},
	issn = {1098-3015},
	shorttitle = {Identification, review, and use of health state utilities in cost-effectiveness models},
	url = {https://www.sciencedirect.com/science/article/pii/S1098301519300518},
	doi = {10.1016/j.jval.2019.01.004},
	abstract = {Cost-effectiveness models that present results in terms of cost per quality-adjusted life-year for health technologies are used to inform policy decisions in many parts of the world. Health state utilities (HSUs) are required to calculate the quality-adjusted life-years. Even when clinical studies assessing the effectiveness of health technologies collect data on HSUs to populate a cost-effectiveness model, which rarely happens, analysts typically need to identify at least some additional HSUs from alternative sources. When possible, HSUs are identified by a systematic review of the literature, but, again, this rarely happens. In 2014, ISPOR established a Good Practices for Outcome Research Task Force to address the use of HSUs in cost-effectiveness models. This task force report provides recommendations for researchers who identify, review, and synthesize HSUs for use in cost-effectiveness models; analysts who use the results in models; and reviewers who critically appraise the suitability and validity of the HSUs selected for use in models. The associated Minimum Reporting Standards of Systematic Review of Utilities for Cost-Effectiveness checklist created by the task force provides criteria to judge the appropriateness of the HSUs selected for use in cost-effectiveness models and is suitable for use in different international settings.},
	language = {en},
	number = {3},
	urldate = {2023-12-07},
	journal = {Value in Health},
	author = {Brazier, John and Ara, Roberta and Azzabi, Ismail and Busschbach, Jan and Chevrou-Séverac, Hélène and Crawford, Bruce and Cruz, Luciane and Karnon, John and Lloyd, Andrew and Paisley, Suzy and Pickard, A. Simon},
	month = mar,
	year = {2019},
	keywords = {preference-based, quality of life, systematic reviews, utilities},
	pages = {NaN--NaN},
	file = {Accepted Version:/Users/corywhitney/Zotero/storage/5LFDCSFL/Brazier et al. - 2019 - Identification, Review, and Use of Health State Ut.pdf:application/pdf;ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/YG7EGERY/S1098301519300518.html:text/html},
