	keywords = {Bayesian, Maritime transportation, Port resilience, Resilience capacities},
	pages = {378--396},
	file = {ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/I5GYVM36/S0951832018310718.html:text/html},
}

