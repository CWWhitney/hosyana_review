@article{lundgren_rethinking_2020,
	title = {Rethinking capabilities in information security risk management: a systematic literature review},
	volume = {23},
	issn = {1466-8297},
	shorttitle = {Rethinking capabilities in information security risk management},
	url = {https://www.inderscienceonline.com/doi/abs/10.1504/IJRAM.2020.106978},
	doi = {10.1504/IJRAM.2020.106978},
	abstract = {Information security risk management capabilities have predominantly focused on instrumental onsets, while largely ignoring the underlying intentions and knowledge these management practices entail. This article aims to study what capabilities are embedded in information security risk management. A theoretical framework is proposed, namely rethinking capability as the alignment between intent and knowing. The framework is situated around four general risk management practices. A systematic literature review utilising the framework was conducted, resulting in the identification of eight identified capabilities. These capabilities were grouped into respective practices: integrating various perspectives and values to reach a risk perception aligned with the intended outcome (identify); adapting to varying perspectives of risks and prioritising them in accordance with the intended outcome (prioritise); security controls to enable resources, and integrate/reconfigure beliefs held by various stakeholders (implement); and sustaining the integrated resources and competences held by stakeholders to continue the alignment with the intended outcome (monitor).},
	language = {en},
	number = {2},
	urldate = {2023-10-31},
	journal = {International Journal of Risk Assessment and Management},
	author = {Lundgren, Martin},
	month = jan,
	year = {2020},
	note = {Publisher: Inderscience Publishers},
	keywords = {information security, intent, knowing},
	pages = {169--190},
}

@phdthesis{capitan_jimenez_behavioral_2020,
	address = {United States -- Wyoming},
	type = {Doctoral dissertation},
	title = {The behavioral economics of information preferences},
	copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
	url = {https://www.proquest.com/docview/2478600256/abstract/B72DB8229F434427PQ/1},
	abstract = {Information can be used to make better choices, yet people often choose to avoid costless information. I study some of the reasons behind such information avoidance (and what to do about it). The first chapter is Expecting to get it: An endowment effect for information. The intuition can be captured with a simple example. I have a prior belief that a cake I am about to eat is either high-calorie or low-calorie with equal probability (i.e., a lottery). If I get a menu with calorie information, I face the lottery (50\% good outcome, 50\% bad outcome). If I do not get a menu with information, I face a degenerate lottery (the expected value of my prior belief with certainty). As such, I might avoid getting information because it exposes me to loss sensations (magnified by loss aversion) when I get the bad outcome and compare that outcome to my prior belief. The endowment effect for information arises because when I expect to receive the information, I have already accounted for some of those loss sensations and getting the information does not expose me to as much loss sensations. The second chapter is Make it count: Increasing calorie information uptake, in which I assume that due to behavioral biases people avoid information. Hence, nudges or interventions to reduce such behavioral biases lead to increased information uptake. In a laboratory experiment with 800 participants, I show that asking people to think about the behavioral bias itself or a feature related to the bias, is effective to increase calorie information uptake. In addition, I find similar results with a replication with 600 gig workers on MTurk. The third chapter is Time-varying pricing may increase total electricity consumption: Evidence from Costa Rica, in which I evaluate the impact of a change in the pricing schedule on total electricity consumption. Contrary to the standard result in this literature, I find that total electricity consumption increases. To explain this seemingly contradictory result I develop a simple economic model in which I show how the signal (i.e., information) sent by the new pricing schedule operate through different channels in different contexts. While people do not respond to the marginal pricing, they do respond to some average price that reflects the incentives set by the new pricing schedule.},
	language = {en},
	urldate = {2023-10-31},
	school = {University of Wyoming},
	author = {Capitán Jiménez, Tabaré},
	year = {2020},
	note = {ISBN: 9798557048927},
	keywords = {Microeconomics},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/BQDZ6DFE/Capitán Jiménez - 2020 - The Behavioral Economics of Information Preference.pdf:application/pdf},
}

@article{adar_communicative_2021,
	title = {Communicative visualizations as a learning problem},
	volume = {27},
	issn = {1941-0506},
	url = {https://ieeexplore.ieee.org/abstract/document/9222102},
	doi = {10.1109/TVCG.2020.3030375},
	abstract = {Significant research has provided robust task and evaluation languages for the analysis of exploratory visualizations. Unfortunately, these taxonomies fail when applied to communicative visualizations. Instead, designers often resort to evaluating communicative visualizations from the cognitive efficiency perspective: “can the recipient accurately decode my message/insight?” However, designers are unlikely to be satisfied if the message went `in one ear and out the other.' The consequence of this inconsistency is that it is difficult to design or select between competing options in a principled way. The problem we address is the fundamental mismatch between how designers want to describe their intent, and the language they have. We argue that visualization designers can address this limitation through a learning lens: that the recipient is a student and the designer a teacher. By using learning objectives, designers can better define, assess, and compare communicative visualizations. We illustrate how the learning-based approach provides a framework for understanding a wide array of communicative goals. To understand how the framework can be applied (and its limitations), we surveyed and interviewed members of the Data Visualization Society using their own visualizations as a probe. Through this study we identified the broad range of objectives in communicative visualizations and the prevalence of certain objective types.},
	language = {en},
	number = {2},
	urldate = {2023-10-31},
	journal = {IEEE Transactions on Visualization and Computer Graphics},
	author = {Adar, Eytan and Lee, Elsie},
	month = feb,
	year = {2021},
	note = {Conference Name: IEEE Transactions on Visualization and Computer Graphics},
	pages = {946--956},
	file = {IEEE Xplore Abstract Record:/Users/corywhitney/Zotero/storage/ZQPNAKJQ/9222102.html:text/html;Submitted Version:/Users/corywhitney/Zotero/storage/EX4HPF8A/Adar and Lee - 2021 - Communicative Visualizations as a Learning Problem.pdf:application/pdf},
}

