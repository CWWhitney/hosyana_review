@article{gouiferda_supply_2020,
	title = {Supply chain information sharing and performance improvements},
	volume = {4},
	copyright = {Copyright (c) 2020 Information Systems Management and Innovation},
	issn = {2509-0933},
	url = {https://revues.imist.ma/index.php/ISMI/article/view/23060},
	doi = {10.34874/IMIST.PRSM/ISMI/23060},
	abstract = {Facing the environment changes characterized by increasing level of uncertainties and demand requirements, firms can no longer achieve competitive advantage alone. To survive, the only rescue would be to adhere to a supply chain membership, and share information with their trading partners. Furthermore, the adoption of IT has increased the exchanges of information between firms, which is leading them to think about the pay-offs of implementing technologies and the extent of sharing information. However, even if the majority of the state of the art agreed on the positive impact of information sharing on supply chain performance, there still is a need of understanding the factors that reinforces such outcome. Hence, in order to disclose the drivers of supply chain performance, by sharing information, we conduct a systematic literature review. The findings reveal that supply chain collaboration is a technique “par excellence” that boosts the impact of information sharing on supply chain performance, and results in better improvements.},
	language = {en},
	number = {1},
	urldate = {2023-10-31},
	journal = {Information Systems Management and Innovation},
	author = {Gouiferda, Fatima and Mounir, Younes},
	month = sep,
