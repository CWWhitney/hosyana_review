@article{gilbert_effects_1978,
	series = {Electric {Power} {Research} {Institute}},
	title = {Effects of risk on prices and quantities of energy supplies},
	volume = {2},
	url = {https://www.osti.gov/servlets/purl/7097204},
	abstract = {The second volume of the report "The Effects of Risk on Prices and Quantities of Energy Supplies" presents a synthesis of developments in the economic theory of uncertainty and a discussion of the implications of the theory for energy supply. The first chapter is an overview of the economics of uncertainty with precise defi­ nitions of basic concepts such as the meaning of risk, risk aversion, and insurance. Several propositions concerning the efficient spreading of risk and the possible mechanisms for risk-bearing are described. There is also a discussion of the effi­ ciency with which the market provides insurance and other mechanisms for absorbing risks. Detailed applications of the economics of uncertainty to particular areas of energy supply are described in volume III, but several general applications are suggested in this volume. The second chapter examines the effects of uncertainty on the decisions of firms and industrial market structure. The chapter surveys many results that are widely scattered in the literature and presents several new findings. The results of this analysis cast doubt on several propositions of classical microeconomics. For example, firms may not choose the production technique with minimum cost in the presence of risk. There are many problems which require a wider analysis than a study of an industry in isolation. The desirability of an action taken in one sector of the economy may depend on the response of the rest of the economy. The study of these economic repercussions is the subject of general equilibrium analysis. The third chapter surveys the economic analysis of uncertainty within a general equilibrium framework. The fourth and final chapter of this volume is concerned with analyzing what is meant by information and its economic value. The determinants of the value of information are discussed and a careful distinction is drawn between the value of information for private use and its value to society. The economics of uncertainty is a relatively new field, and this volume represents a current synthesis of the main results. The level of presentation assumes a know­ ledge of the economic theory of production and consumption under conditions of cer­ tainty and an elementary familiarity with mathematical and statistical techniques.},
	language = {en},
	number = {Research Project 869-1},
	urldate = {2024-05-03},
	journal = {Ea-700 - Microeconomic Associates},
	author = {Gilbert, Richard and Stiglitz, Joseph},
	year = {1978},
	pages = {0--131},
	annote = {“a synthesis of developments in the economic theory of uncertainty and a discussion of the implications of the theory for energy supply.” (Gilbert and Stiglitz, 1978, p. 5)
“the economics of uncertainty with precise defi­ nitions of basic concepts such as the meaning of risk, risk aversion, and insurance.” (Gilbert and Stiglitz, 1978, p. 5)
“If the consequences of uncertainty are costlessly available ex post, and if the un­ certainty is systematic and agents rational, then given time their decisions will converge to a rational expectations choice. If the consequences are costly to ob­ serve then producers will stop short of collecting full information and they may systematically make mistaken choices.” (Gilbert and Stiglitz, 1978, p. 50)

},
	annote = {“An enormous amount of resources are allocated to obtaining and disseminating infor­ mation.” (Gilbert and Stiglitz, 1978, p. 95)
“There is, of course, some cost associated with obtaining information, and as a con­ sequence firms (or other units in our society) have to make judgments about the value of information as well as the cost of obtaining it. They have to decide what kind of information to obtain and how to get it.” (Gilbert and Stiglitz, 1978, p. 96)
“"Information" has been defined in a number of different ways; for our purposes the most useful way of thinking about it is the following: "information" is anything which, in some situations at least, changes our judgments concerning the probability distribution of various events.” (Gilbert and Stiglitz, 1978, p. 96)

“Information is valuable because what is an appropriate action in one set of circumstances, would not be an appropriate action in another.” (Gilbert and Stiglitz, 1978, p. 98)

},
	file = {7097204.pdf:/Users/corywhitney/Zotero/storage/9QJFLN6Z/7097204.pdf:application/pdf},
}

