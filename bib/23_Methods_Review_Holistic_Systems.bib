	author = {Kumar, Mukesh and Garg, Dixit and Agarwal, Ashish},
	month = jan,
	year = {2019},
	note = {Publisher: Inderscience Publishers},
	keywords = {SCIC, SCTPs, supply chain inventory coordination, supply chain trading partners, vendor managed inventory, VMI},
	pages = {407--454},
