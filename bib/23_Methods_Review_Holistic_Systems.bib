	keywords = {low- and middle-income countries, value per statistical life (VSL), willingness to pay},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/9XSFGQIT/Robinson et al. - 2019 - Reference Case Guidelines for Benefit-Cost Analysi.pdf:application/pdf},
