@article{tang_remanufacturing_2020,
	title = {Remanufacturing in a competitive market: a closed-loop supply chain in a stackelberg game framework},
	volume = {161},
	issn = {0957-4174},
	shorttitle = {Remanufacturing in a competitive market},
	url = {https://www.sciencedirect.com/science/article/pii/S0957417420304796},
	doi = {10.1016/j.eswa.2020.113655},
	abstract = {In this work, we study a closed-loop supply chain with remanufacturing in a competitive market, where the supply chain is a price taker. A Stackelberg game framework is considered, where a manufacturer (leader) has sufficient channel power over a retailer (follower). We develop analytical models to show that a closed-loop supply chain with remanufacturing in a competitive market can achieve the same return rate as that in the centrally coordinated channel by employing a contract between the manufacturer and the retailer. The contract consists of a wholesale price, and a progressive transfer price scheme with additional allowances (or charges) for the returned products. Our models also take into account the effect of green initiatives on consumers’ purchase intention by relating the green achievement from remanufacturing to consumer demand. In practice, our models can be directly applied to a closed-loop supply chain with remanufacturing in a competitive market.},
	language = {en},
	urldate = {2023-10-25},
	journal = {Expert Systems with Applications},
	author = {Tang, Shaolong and Wang, Wenjie and Zhou, Gaoguang},
	month = dec,
	year = {2020},
	keywords = {Progressive transfer prices, Remanufacturing, Stackelberg game},
	pages = {113655},
	file = {ScienceDirect Full Text PDF:/Users/corywhitney/Zotero/storage/WY7PEY7X/Tang et al. - 2020 - Remanufacturing in a competitive market A closed-.pdf:application/pdf;ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/YBZJ2ZPZ/S0957417420304796.html:text/html},
}

@misc{heilig_digitalization_2019,
	title = {From digitalization to data-driven decision making in container terminals},
	url = {http://arxiv.org/abs/1904.13251},
	abstract = {With the new opportunities emerging from the current wave of digitalization, terminal planning and management need to be revisited by taking a data-driven perspective. Business analytics, as a practice of extracting insights from operational data, assists in reducing uncertainties using predictions and helps to identify and understand causes of inefficiencies, disruptions, and anomalies in intra- and inter-organizational terminal operations. Despite the growing complexity of data within and around container terminals, a lack of data-driven approaches in the context of container terminals can be identified. In this chapter, the concept of business analytics for supporting terminal planning and management is introduced. The chapter specifically focuses on data mining approaches and provides a comprehensive overview on applications in container terminals and related research. As such, we aim to establish a data-driven perspective on terminal planning and management, complementing the traditional optimization perspective.},
	language = {en},
	urldate = {2023-10-25},
	publisher = {arXiv},
	author = {Heilig, Leonard and Stahlbock, Robert and Voß, Stefan},
	month = apr,
