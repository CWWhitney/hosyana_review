	month = jan,
	year = {2017},
	note = {Publisher: Inderscience Publishers},
	keywords = {information section, intelligence, interview, Japanese companies, questionnaire, research and development, scenario analysis, scenario building, scenario planning},
	pages = {75--89},
}

