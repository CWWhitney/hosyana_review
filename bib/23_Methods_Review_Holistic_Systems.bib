}

@article{pourshahabi_handling_2020,
	title = {Handling uncertainty in optimal design of reservoir water quality monitoring systems},
	volume = {266},
	issn = {0269-7491},
	url = {https://www.sciencedirect.com/science/article/pii/S026974912033462X},
	doi = {10.1016/j.envpol.2020.115211},
	abstract = {In the present paper, a scenario-based many-objective optimization model is developed for the spatio-temporal optimal design of reservoir water quality monitoring systems considering uncertainties. The proposed methodology is based on the concept of nonlinear interval number programming and information theory, while handling uncertainties of temperature, reservoir inflow, and inflow constituent concentration. A reference-point-based non-dominated sorting genetic algorithm (NSGA-III) is used to deal with the many-objective optimization problem. The proposed model is developed for the Karkheh reservoir system in Iran as a real-world problem. The results show excellent performance of the optimized water quality sampling locations instead of all potential ones in providing adequate information about the reservoir water quality status. The presented uncertainty-based model leads to a 55.73\% reduction in the radius of the uncertain interval caused by different scenarios. Handling uncertainties in a spatio-temporal many-objective optimization problem is the main contribution of this study, yielding a reliable and robust design of a reservoir monitoring system that is less sensitive to various scenarios.},
	language = {en},
	urldate = {2023-10-25},
	journal = {Environmental Pollution},
	author = {Pourshahabi, Shokoufeh and Rakhshandehroo, Gholamreza and Talebbeydokhti, Nasser and Nikoo, Mohammad Reza and Masoumi, Fariborz},
	month = nov,
	year = {2020},
	keywords = {Many-objective optimization model, Nonlinear interval number programming, Reservoir monitoring system},
	pages = {115211},
}

