	pages = {951},
	file = {Kravchenko et al. - 2020 - A Procedure to Support Systematic Selection of Lea.pdf:/Users/corywhitney/Zotero/storage/JF3ESCDF/Kravchenko et al. - 2020 - A Procedure to Support Systematic Selection of Lea.pdf:application/pdf},
}

