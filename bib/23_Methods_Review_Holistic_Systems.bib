	doi = {10.13140/RG.2.2.36349.36327},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/JEGCEMAH/Debray et al. - 2017 - Methodological guidance, recommendations and illus.pdf:application/pdf},
}

