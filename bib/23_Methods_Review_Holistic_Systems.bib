	school = {The University of Texas at Austin},
	author = {Moras-Sanchez, Rafael G erardo},
	year = {1982},
	annote = {“The concept of the Expected Value of Perfect Information is applied along with the modeling approach” (Moras-Sanchez, 1982, p. 9)

},
