@article{coibion_what_2012,
	title = {What can survey forecasts tell us about information rigidities? {\textbar} journal of political economy: vol 120, {No} 1},
	volume = {120},
	shorttitle = {What can survey forecasts tell us about information rigidities? {\textbar} journal of political economy},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/665662},
	doi = {10.1086/665662},
	abstract = {Olivier Coibion and Yuriy Gorodnichenko We derive common and conflicting predictions from models in which agents face information constraints and then assess their validity using surveys of consumers, firms, central bankers, and professional forecasters. We document that mean forecasts fail to completely adjust on impact to shocks, leading to statistically and economically significant deviations from the null of full information. The dynamics of forecast errors after shocks are consistent with the predictions of models with information rigidities. The conditional responses of forecast errors and disagreement among agents can also be used to differentiate between some of the most prominent models of information rigidities.},
	language = {en},
	number = {1},
	urldate = {2024-02-05},
	journal = {Journal of Political Economy},
	author = {Coibion, O and Gorodnichenko, Y},
	year = {2012},
	annote = { derive common and conflicting predictions from models in which agents face information constraints and then assess their validity using surveys of consumers, firms, central bankers, and professional forecasters. 
document that mean forecasts fail to completely adjust on impact to shocks, leading to statistically and economically significant deviations from the null of full information. The dynamics of forecast errors after shocks are consistent with the predictions of models with information rigidities. The conditional responses of forecast errors and disagreement among agents can also be used to differentiate between some of the most prominent models of information rigidities.

