	shorttitle = {Food consumer information behavior},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84897406251&doi=10.1080%2f10496505.2014.880655&partnerID=40&md5=40554633f808895910fb9f9468ba12fc},
