@misc{birnberg_three_1989,
	title = {Three decades of behavioral accounting research: a search for order. {\textbar} behavioral research in accounting {\textbar} {EBSCOhost}},
	shorttitle = {Three decades of behavioral accounting research},
	url = {https://openurl.ebsco.com/EPDB%3Agcd%3A14%3A27912766/detailv2?sid=ebsco%3Aplink%3Ascholar&id=ebsco%3Agcd%3A5328406&crl=c},
	abstract = {Title
Three Decades of Behavioral Accounting Research: A Search For Order.
Authors
Birnberg, Jacob G.; Shields, Jeffrey F.
Abstract
The intent of this paper is to cluster the Behavioral Accounting Research (BAR) since the work of Argyris [1952] into meaningful groupings based on the underlying research issue which the studies pursue. For convenience, these clusters are referred to as "schools within BAR." Five schools are identified and discussed. These schools are: Managerial Control, Accounting Information Processing, Accounting Information System Design, Auditing Research, and Organizational Sociology. Several other clusters were considered and rejected as possible schools of BAR for a variety of reasons. \&lt;BR\&gt; The Managerial Control and Accounting Information Processing schools are the earliest examples of BAR. The former draws directly on the seminal work of Argyris [1952]. The latter is an outgrowth of problems present in financial accounting during the 1950s and 1960s. Over the past 30 years, both the questions researched by these two schools and the methods used to research them have changed. The other three schools are more recent in their origins. The first two date from the mid-1970s and the Organizational Sociology school in BAR began in the 1980s. Special note is taken in the discussion of the Organizational Sociology's unique orientation among BAR schools both intellectually and methodologically. It is conjectured that in the future this could be a significant factor in organizing and understanding BAR.
Publication
Behavioral Research in Accounting, 1989, Vol 1, p23},
	language = {en},
	urldate = {2024-05-03},
	author = {Birnberg},
	year = {1989},
	file = {Three Decades of Behavioral Accounting Research\: A Search For Order. | Behavioral Research in Accounting | EBSCOhost:/Users/corywhitney/Zotero/storage/9MK48ZZD/detailv2.html:text/html},
}

