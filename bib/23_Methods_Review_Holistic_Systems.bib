	language = {en},
	journal = {Agroforestry Systems},
	author = {Dembele, Amadou and Cisse, Youssouf and Bocary, Kaya and Ibrahima, N’Diaye and Harouna, Yossi and Abdoulaye, Diarra and Souleymane, Keita and Amadou, Dembele and Daouda, Maiga and Graciela, M. Rusch and Madsen, Anders L.},
