	year = {2019},
	note = {Accepted: 2019-09-30T13:51:34Z},
	pages = {0--65},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/QD4YVGPK/López Segovia - 2019 - El impacto de la cultura en el gobierno de las TI.pdf:application/pdf},
}

