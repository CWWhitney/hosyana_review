@article{khuntia_benefits_2019,
	title = {Benefits of {IT}-enabled flexibilities for foreign versus local firms in emerging economies},
	volume = {36},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85070327628&doi=10.1080%2f07421222.2019.1628906&partnerID=40&md5=83062c096a6d44d35241894b2095835a},
	doi = {10.1080/07421222.2019.1628906},
	language = {en},
	number = {3},
	journal = {Journal of Management Information Systems},
	author = {Khuntia, J. and Kathuria, A. and Saldanha, T.J.V. and Konsynski, B.R.},
	year = {2019},
	pages = {855--892},
	annote = {Emerging economies present opportunities and challenges for foreign firms to achieve business success. As Information Technology (IT) is a critical lever for firms to compete globally, an important question is whether foreign firms are at a comparative disadvantage or advantage relative to local firms in leveraging IT. We explore this question by examining how foreign firms and local firms compare in leveraging synergies between IT-enabled flexibilities and firm capabilities. We focus on two kinds of IT-enabled flexibility: IT-enabled flexibility in customer services (ITCS), and IT-enabled flexibility in partner services (ITPS). We first develop hypotheses for complementary effects of ITCS with Marketing Capability, and of ITPS with Relational Capability to positively influence firm performance. We then draw on the theoretical foundation of firm-specific advantages (FSA) framework and its characterization of FSAs as location-bound versus nonlocation-bound. Specifically, we argue that because of the location-bound nature of ITCS and Marketing Capability, foreign firms face a comparative disadvantage relative to local firms in leveraging the synergy between ITCS and Marketing Capability. In contrast, we argue that because of the nonlocation-bound nature of ITPS and Relational Capability, foreign firms enjoy a comparative advantage relative to local firms in leveraging the synergy between ITPS and Relational Capability. Our empirical analysis using matched-pair survey and secondary data of 182 foreign and local firms in India supports our hypotheses. Our findings highlight important differences in how foreign and local firms benefit from IT, thus contributing towards a better understanding of IT implications in emerging economies.
},
	annote = {Export Date: 05 May 2024; Cited By: 34},
}

