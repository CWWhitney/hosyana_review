	shorttitle = {Whooping cranes},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081339049&doi=10.1016%2fC2014-0-02126-0&partnerID=40&md5=fcda71d8005375a67a87c4301126a398},
