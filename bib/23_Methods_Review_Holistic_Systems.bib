@article{weltonAreHeadtoheadTrials2011a,
	title = {Are head-to-head trials of biologics needed? {The} role of value of information methods in arthritis research},
	volume = {50},
	issn = {1462-0324, 1462-0332},
	shorttitle = {Are head-to-head trials of biologics needed?},
	url = {https://academic.oup.com/rheumatology/article-lookup/doi/10.1093/rheumatology/ker242},
	doi = {10.1093/rheumatology/ker242},
	abstract = {Reimbursement decisions are typically based on cost-effectiveness analyses. While a cost-effectiveness analysis can identify the optimum strategy, there is usually some degree of uncertainty around this decision. Sources of uncertainty include statistical sampling error in treatment efficacy measures, underlying baseline risk, utility measures and costs, as well as uncertainty in the structure of the model. The optimal strategy is therefore only optimal on average, and a decision to adopt this strategy might still be the wrong decision if all uncertainty could be eliminated. This means that there is a quantifiable expected (average) loss attaching to decisions made under uncertainty, and hence a value in collecting information to reduce that uncertainty. Value of information (VOI) analyses can be used to provide guidance on whether more research would be cost-effective, which particular model inputs (parameters) have the most bearing on decision uncertainty, and can also help with the design and sample size of further research. Here, we introduce the key concepts in VOI analyses, and highlight the inputs required to calculate it. The adoption of the new biologic treatments for RA and PsA tends to be based on placebo-controlled trials. We discuss the possible role of VOI analyses in deciding whether head-to-head comparisons of the biologic therapies should be carried out, illustrating with examples from other fields. We emphasize the need for a model of the natural history of RA and PsA, which reflects a consensus view.},
	language = {en},
	number = {suppl 4},
	urldate = {2023-06-21},
	journal = {Rheumatology},
	author = {Welton, N. J. and Madan, J. and Ades, A. E.},
	month = sep,
	year = {2011},
	pages = {NaN--NaN},
	annote = {Export Date: 05 May 2024; Cited By: 13},
	file = {Full Text:/Users/corywhitney/Zotero/storage/3U5AW8QS/Welton et al. - 2011 - Are head-to-head trials of biologics needed The r.pdf:application/pdf;Welton et al. - 2011 - Are head-to-head trials of biologics needed The r:/Users/corywhitney/Zotero/storage/R85QABAS/Welton et al. - 2011 - Are head-to-head trials of biologics needed The r.pdf:application/pdf},
