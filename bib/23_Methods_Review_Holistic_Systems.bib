@article{burbano-figueroa_active_2022,
	title = {An active search for solutions in agricultural systems: a decision analysis perspective},
	volume = {13},
	shorttitle = {An active search for solutions in agricultural systems},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179415129&doi=10.14349%2fsumneg%2f2022.V13.N28.A8&partnerID=40&md5=67683a078acdcfb76cb5be9b61525abd},
