	doi = {10.1016/B978-0-12-811714-9.00019-X},
	keywords = {S2S forecast, S2S research},
	pages = {399--419},
	file = {ScienceDirect Snapshot:/Users/corywhitney/Zotero/storage/EM3AQYU3/B978012811714900019X.html:text/html},
