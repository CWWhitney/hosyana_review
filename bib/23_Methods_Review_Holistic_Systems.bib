	pages = {1077--1086},
	file = {Rutter et al. - 2011 - Computer Disease Simulation Models:/Users/corywhitney/Zotero/storage/RZGUHBCT/Rutter et al. - 2011 - Computer Disease Simulation Models.pdf:application/pdf},
