	file = {Cavalli et al. - 2019 - Managing evidence in food safety and nutrition.pdf:/Users/corywhitney/Zotero/storage/ICETEHWG/Cavalli et al. - 2019 - Managing evidence in food safety and nutrition.pdf:application/pdf},
