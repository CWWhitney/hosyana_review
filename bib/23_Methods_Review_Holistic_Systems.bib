	pages = {9145--9158},
	file = {ACS Full Text Snapshot:/Users/corywhitney/Zotero/storage/K7BB7DET/acs.est.html:text/html;Full Text:/Users/corywhitney/Zotero/storage/T7IYEGP3/Mao et al. - 2020 - Moving beyond the Technology A Socio-technical Ro.pdf:application/pdf},
}

