	journal = {Sensors},
	author = {Kandala, Rajesh N. V. P. S. and Dhuli, Ravindra and Pławiak, Paweł and Naik, Ganesh R. and Moeinzadeh, Hossein and Gargiulo, Gaetano D. and Gunnam, Suryanarayana},
	month = jan,
	year = {2019},
	note = {Number: 23
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {inter-patient scheme, nonlinear features, voting},
	pages = {5079--5106},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/J7DTLXVS/Kandala et al. - 2019 - Towards Real-Time Heartbeat Classification Evalua.pdf:application/pdf},
