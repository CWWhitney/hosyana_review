@incollection{baio_economic_2020,
	title = {Economic evaluation and cost-effectiveness of health care interventions},
	isbn = {978-1-315-18021-2},
	abstract = {This chapter provides a background and modeling approaches used in health technology assessment, particularly using a Bayesian approach. In cost-effectiveness analysis, d usually represents a treatment option within some set of competing alternatives in. Deterministic models therefore can give biased estimates, and often over-estimate cost-effectiveness technically this is generally due to the fact that the net benefit function tends to be a concave function in many of the model parameters. The chapter presents the two main types of models for economic evaluation, one based on individual level data and trial-based evaluations and the other based on evidence synthesis and decision-analytic modeling. Economic evaluation in healthcare comprises a set of analytical tools to combine all relevant evidence on costs and consequences of intervention(s) compared to a control or status quo. The decision options and identification of relevant evidence will depend on the country or setting under consideration.},
