	note = {Publisher: Emerald Publishing Limited},
	keywords = {Logistics facility, Rating system, Warehouse},
	pages = {1239--1260},
	annote = {Export Date: 05 May 2024; Cited By: 19},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/VBESV8NR/Baglio et al. - 2020 - Benchmarking logistics facilities a rating model .pdf:application/pdf;Submitted Version:/Users/corywhitney/Zotero/storage/EXKP6678/Baglio et al. - 2020 - Benchmarking logistics facilities a rating model .pdf:application/pdf},
