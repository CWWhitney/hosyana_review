@article{jin_dynamic_2022,
	title = {A dynamic hybrid decision model of cross-border natural gas investment},
	volume = {42},
	shorttitle = {天然气跨境投资动态混合决策模型},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147584555&doi=10.3787%2fj.issn.1000-0976.2022.12.014&partnerID=40&md5=6dabbcdc4626c059ccf6198d5825c044},
	doi = {10.3787/j.issn.1000-0976.2022.12.014},
	language = {en},
	number = {12},
	journal = {Natural Gas Industry},
	author = {Jin, F. and Zhou, J. and Xiang, W. and Zhang, T. and Li, H.},
	year = {2022},
	pages = {133--144},
	annote = {Abstract
The existing risk assessment methods for cross-border natural gas investment cooperation fail to distinguish risk factors and the uncertainty of parameters, and it is difficult for the enterprise to make accurate prevention and control measures. In addition, they fail to realize multi-stage dynamic investment decisions, and the characteristics of single static decision and irreversible are obvious so that the investment risk is high. In order to overcome the above deficiencies and scientifically quantify extreme risks, the risk-driven principle is introduced, namely, risk factors are mapped to corresponding parameters and described by probability distribution. Based on the binary tree option model, a dynamic hybrid decision model integrating risk assessment, real options and Monte Carlo methods is proposed. Afterward, the NPV probability distribution, sensitivity analysis, stress test of extreme risks and multi-stage dynamic investment, that is wait or give up decision series, are obtained by simulation. Eventually, the scientific nature and validity of the proposed model are verified by a real case. The results show that: (1) The uncertainty of risk factors and uncertain parameters can be effectively separated, which is convenient for enterprises to accurately formulate coping strategies; (2) The extreme risks with low probability but great influence are quantified to measure the profit/loss of project valuation that is used to guide the enterprises to implement scientific decision for investment; (3) Through the integration of Monte Carlo and real option method, a multi-stage dynamic decision series process is obtained, which is different from the "one-shot" single decision, to realize multi-stage dynamic diversification and resolution of investment risk. (4) From the perspective of flexible management and strategic investment, the project valuation is re-evaluated to provide an effective supplement for the conventional DCF model. © 2022 Natural Gas Industry Journal Agency. All rights reserved.
},
	annote = {Export Date: 05 May 2024; Cited By: 0},
}

