	pages = {211--232},
	file = {Cabantous et al. - 2011 - Is imprecise knowledge better than conflicting exp:/Users/corywhitney/Zotero/storage/KC6E233Z/Cabantous et al. - 2011 - Is imprecise knowledge better than conflicting exp.pdf:application/pdf},
}

