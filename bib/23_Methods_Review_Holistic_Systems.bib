@article{agrawal_outsourcing_2020,
	title = {Outsourcing and reverse supply chain performance: a triple bottom line approach},
	volume = {28},
	shorttitle = {Outsourcing and reverse supply chain performance},
	url = {https://www.emerald.com/insight/content/doi/10.1108/BIJ-09-2020-0498/full/%20https://www.futuremarketinsights.com/press-release/consumer-electronics-market},
	doi = {10.1108/BIJ-09-2020-0498},
	abstract = {Purpose – Outsourcing has become a strategic decision for most of the organizations in the present context of globalization and circular economy. The objective of proposed study is to empirically investigate the relationship between the outsourcing benefits and triple bottom line (TBL)-based performance of reverse supply chain (RSC) comprising of economic, environmental and social factors. Design/methodology/approach – In the present study, the partial least square path approach of structural equation modeling has been applied for testing hypotheses. A questionnaire was developed for collecting the information and responses from the experts of electronics industry, India. Measurement models were tested for ensuring the fitness of data for further applying partial least square path approach of SEM. Findings – The results provide insightful information on outsourcing and RSC performance. It reveals that outsourcing decisions are important and have great influence on the economic, environmental and social performance of RSC. Research limitations/implications – The study will provide useful guidance to the organizations for outsourcing decisions. One of the limitations of the study is that it has considered data collected from the Indian electronics industry. Therefore, results may not be generalized. Originality/value – The third-party service providers have core competencies, and they are the experts of providing RSC services. It is also apparent from the exploration of past research and theoretical background that there are limited number of studies focusing on the impact of outsourcing decisions in RSC performance specifically from the TBL perspective. Hence, the proposed study is an effort to explore the impact of outsourcing RSC activities on the performance of RSC from a sustainability perspective. Keywords Reverse supply chain, Reverse logistics, Outsourcing, PLSPM, Structural equation modeling, Indian electronics industry Paper type Research paper},
	language = {en},
	number = {4},
	urldate = {2023-11-02},
	journal = {Benchmarking: An International Journal},
	author = {Agrawal, Saurabh and Singh, Rajesh Kumar},
	year = {2020},
	note = {Publisher: Emerald Publishing Limited},
	keywords = {read CW},
	pages = {NaN--NaN},
	annote = {Annotations(6/13/2024, 11:38:47 AM)
“partial least square path approach of structural equation modeling has been applied for testing hypotheses. A questionnaire was developed for collecting the information and responses from the experts of electronics industry, India. Measurement models were tested for ensuring the fitness of data for further applying partial least square path approach of SEM.” (Agrawal and Singh, 2020, p. 1)“The study will provide useful guidance to the organizations for outsourcing decisions.” (Agrawal and Singh, 2020, p. 1)“involves development of hypotheses related to outsourcing RSC activities and TBL performance. Hypotheses are tested using the information and responses gathered from the experts in electronics industry. The study intends to investigate the relation between outsourcing and TBL performance of RSC in the Indian electronics industry. The main construct outlines the benefits of outsourcing in electronics industry. Its association with the other constructs outlining the economic, environmental and social performance of RSC is tested. The latent variables of all constructs have reflective type of observed variables. The intent is to understand the association of benefits of outsourcing with TBL performance of RSC. The measurements models of the constructs developed were tested for fitness of data for further modeling using the partial least square path modeling (PLSPM) approach. PLSPM was selected because it requires smaller sample size; more importantly, it does not need normally distributed data, and it is nonparametric (Hair et al., 2017). Recently, PLSPM has been applied by Feng et al. (2018), Ardakani et al. (2019) and Chandak et al. (2019) in the area of supply chain management.” (Agrawal and Singh, 2020, p. 3)“The intent of the research is to analyze the relation between outsourcing and TBL performance of the RSC.” (Agrawal and Singh, 2020, p. 6)“The constructs were developed and their observed indicators were identified with the help of past literature review. The questionnaire is attached in the Appendix. The data were collected through survey of Indian electronics industry by using Google Form and also by visiting personally to the various firms. According to Ryan and Garland (1999), all scales such as five-point, seven-point or ten-point are comparable for the analytical tools such as structural equation modeling (SEM).” (Agrawal and Singh, 2020, p. 6)“the five-point scale was utilized for the convenience of respondents, and it was used by many researchers in the past.” (Agrawal and Singh, 2020, p. 6)“The five-point Likert scale was utilized, and responders were asked to opt for the appropriate option based on their opinion. The data were transferred into the MS excel sheet for all the indicators. XLSTAT software was used for further statistical analysis.” (Agrawal and Singh, 2020, p. 6)
},
	annote = {Export Date: 05 May 2024; Cited By: 17},
	file = {Agrawal and Singh - 2020 - Outsourcing and reverse supply chain performance .pdf:/Users/corywhitney/Zotero/storage/IQID8Z5Q/Agrawal and Singh - 2020 - Outsourcing and reverse supply chain performance .pdf:application/pdf},
}

