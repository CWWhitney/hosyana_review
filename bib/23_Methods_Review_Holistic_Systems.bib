@article{camison-haba_information_2020,
	title = {Information assets: a typology of disclosed and non-disclosed information},
	volume = {160},
	issn = {0040-1625},
	shorttitle = {Information assets},
	url = {https://www.sciencedirect.com/science/article/pii/S0040162520310684},
