	keywords = {bin, read CW},
	pages = {NaN--NaN},
	annote = {Annotations(6/18/2025, 10:31:47 AM)
“evaluate the IS literature’s core contributions to theoretical and managerial knowledge, and make some predictions about the road that lies ahead for IS researchers.” (Banker and Kauffman, 2004, p. 281)
},
	annote = {Export Date: 05 May 2024; Cited By: 195},
	file = {Banker and Kauffman - 2004 - 50th Anniversary Article The Evolution of Researc.pdf:/Users/corywhitney/Zotero/storage/SECQLAVK/Banker and Kauffman - 2004 - 50th Anniversary Article The Evolution of Researc.pdf:application/pdf},
