}

@article{wang_analysis_2020,
	title = {The analysis of electronic circuit fault diagnosis based on neural network data fusion algorithm},
	volume = {12},
	issn = {2073-8994},
	url = {https://www.mdpi.com/2073-8994/12/3/458},
	doi = {10.3390/sym12030458},
	abstract = {Symmetries play very important roles in the dynamics of electrical systems. The relevant electronic circuits with fault diagnostics, including the optimized neural network algorithm model, are designed on the basis of symmetry principles. In order to improve the eﬃciency of the circuit pressure test, a circuit pressure function equivalent compression test method based on the parallel neural network algorithm is proposed. For the implementation stage of the circuit pressure test, the improved modiﬁed node algorithm (MNA) is used to build an optimization model, and the circuit network is converted into an ordinary diﬀerential equation for the circuit pressure function equivalent compression test. The test aims to minimize ﬂux. Then, backpropagation (BP) neural network algorithm data fusion is introduced to optimize the minimum ﬂux model of the cyclic pressure functional equivalent compression test. Finally, a simulation experiment is carried out to verify the eﬀectiveness of the algorithm in the accuracy and eﬃciency of the pressure test. The results show that the improved BP neural network improves the data fusion accuracy and shortens the sample training time; compared with the uncompressed algorithm, the running time of the proposed algorithm is greatly reduced and the execution eﬃciency is high; compared with the vascular pressure test method, there is no signiﬁcant diﬀerence in the convergence accuracy and it is at a level of 10−5. Since the parallel computing problem is not considered in either of the two-pulse tube pressure test methods, the convergence time of the algorithm increases exponentially with the increase in the number of parallel threads. However, the algorithm in this research considers the problem of parallel execution and uses a quad-core processor, with no signiﬁcant change in computing time and high computing eﬃciency. Therefore, BP neural network data fusion can be used for the fault diagnosis of electronic circuits, with a high operating eﬃciency and good development prospects.},
	language = {en},
	number = {3},
	urldate = {2023-10-31},
	journal = {Symmetry},
	author = {Wang, Nana},
	month = mar,
	year = {2020},
	pages = {458},
	file = {Wang - 2020 - The Analysis of Electronic Circuit Fault Diagnosis.pdf:/Users/corywhitney/Zotero/storage/YPYW98ZN/Wang - 2020 - The Analysis of Electronic Circuit Fault Diagnosis.pdf:application/pdf},
}

@article{vieira_de_castro_holistic_2020,
	title = {Holistic approach to the sustainable commercial property business: analysis of the main existing sustainability certifications},
	volume = {24},
	issn = {1648-715X, 1648-9179},
	shorttitle = {Holistic approach to the sustainable commercial property business},
	url = {https://journals.vilniustech.lt/index.php/IJSPM/article/view/12174},
	doi = {10.3846/ijspm.2020.12174},
	abstract = {Sustainability is no longer a new concept. However, applying, measuring and reporting on the sustainability initiative is still a somewhat confused and subjective issue. There is a huge variety of sustainability guidelines and green building schemes of differing natures, meanings and wordings. Despite this, there is no one guideline providing a crossreference between corporate social responsibility and green building performance to help the commercial property market completely incorporate sustainability into their activities. Therefore, this paper intends to link sustainability, real estate environmental, social, and governance (ESG) and sustainable building in order to help companies internalise this concept in all areas of their operations aligning it with their strategic planning. From desk-based research, this proposal examines and compares key aspects of the main schemes in existence, which are currently evolving in the definition, assessment and report of sustainability at the corporate and built environment level. This approach provides key information to help professionals get a better understanding of the specific changes which sustainability brings about in their corporate process, strategies, investment decisions, daily business operations as well as their property management. The insights presented here can support real estate companies to develop comprehensive communication flows and tools for the measurement and disclosure of sustainability data.},
	language = {en},
	number = {4},
	urldate = {2023-10-31},
	journal = {International Journal of Strategic Property Management},
	author = {Vieira De Castro, Aliane and Ramírez Pacheco, Gema and Neila González, Fco. Javier},
