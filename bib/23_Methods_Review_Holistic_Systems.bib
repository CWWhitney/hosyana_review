@book{becker_sustainability_2023,
	series = {Sustainability {Science}: {Managing} {Risk} and {Resilience} for {Sustainable} {Development}},
	title = {Sustainability science: managing risk and resilience for sustainable development},
	shorttitle = {Sustainability science},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184112462&doi=10.1016%2fC2021-0-03020-0&partnerID=40&md5=119ca015519085f1061cce3619c37a88},
