@article{papageorgiou_saaa_nodate,
	title = {Saaa executive scientific committee},
	abstract = {Supply chains are currently struggling with the classic symptoms of a mismatch between supply and demand, low sales forecast accuracy, high and aging inventory, as well as low customer service. Variability is one of the costliest problems in supply chains, particularly when it amplifies as it flows up the chain. This phenomenon is known as the Bullwhip Effect (BWE) and has drawn much attention in the study of Supply Chain Management (SCM). Anything that is done to stabilise the flow of demand across a supply chain will improve the performance and will result in substantial advantage over supply chains that must cope with higher levels of variability. The focus of this research was the management of demand variability through information sharing. The study focused on a single South African logistical company and as this was an exploratory case study a variety of sources was used to gather information, including contractual agreements, operational procedures and policies, historical sales and inventory data. As part of the study the impact of the BWE across a three-stage supply chain consisting of a single manufacturer, a single distributor and a single retailer was quantified. In addition, semi structured interviews were conducted. The results of the study demonstrate the improvement that information sharing has on service levels resulting in improved financial results to all members in the study. The study proposes several information sharing mechanisms that can be applied across supply chains.},
	language = {en},
	author = {Papageorgiou, Elmarie and de Villiers, Rikus and Hanner-Weldon, Lana and Thompson, Tanya and President, Saaa and Secretary, Saaa and Communications, Saaa and Treasurer, Saaa and Research, Saaa},
	keywords = {bin, linter/error, read CW},
	pages = {0--487},
	file = {Papageorgiou et al. - SAAA EXECUTIVE SCIENTIFIC COMMITTEE.pdf:/Users/corywhitney/Zotero/storage/7EUD55WU/Papageorgiou et al. - SAAA EXECUTIVE SCIENTIFIC COMMITTEE.pdf:application/pdf},
