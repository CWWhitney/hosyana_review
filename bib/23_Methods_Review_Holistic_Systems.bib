	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/08920753.2017.1327345},
	keywords = {mariculture, marine tourism, seafood},
	pages = {310--329},
}

@article{martin_suppliers_2017,
	title = {Suppliers' participation in supply chain finance practices: predictors and outcomes},
	volume = {11},
	issn = {1477-5360},
	shorttitle = {Suppliers' participation in supply chain finance practices},
	url = {https://www.inderscienceonline.com/doi/abs/10.1504/IJISM.2017.086242},
