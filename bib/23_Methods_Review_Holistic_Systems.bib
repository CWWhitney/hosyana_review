	keywords = {Multi-criteria decision-making, Product–service systems, Supply network risks},
	pages = {NaN--NaN},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/8QQ7QJWQ/Wang et al. - 2020 - Manage risk of sustainable product–service systems.pdf:application/pdf},
}

