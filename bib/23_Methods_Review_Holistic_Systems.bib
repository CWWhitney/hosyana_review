@incollection{rudolph_implementing_2012,
	title = {Implementing a security-awareness program},
	copyright = {Copyright © 2014 by John Wiley \& Sons, Inc.},
	isbn = {978-1-118-82065-0},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118820650.ch49},
	abstract = {This chapter outlines methods for ensuring that all employees are aware of security requirements and policies. The purpose of an information-security awareness program is to prevent loss and to ensure compliance with laws and regulations. The chapter also highlights that a security awareness program must appeal to the audience and must be tailored to the workforce and technology of the organization. Participation in the awareness program is required for everyone, including senior management, part-time and full-time staff, new hires, contractors, and other outsiders who have access to the organization's information systems. New hires might be required to receive a security-awareness orientation briefing within a specific time or before being allowed system access. Individuals attempting to infuse security awareness into the business processes should be knowledgeable of those business processes. This ensures that awareness messages support the business and are delivered using terminology and content that are accurate and aligned with other organizational initiatives and activities.},
