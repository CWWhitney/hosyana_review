	month = jun,
	year = {2014},
	pages = {NaN--NaN},
	file = {Full Text:/Users/corywhitney/Zotero/storage/WC3X8ZIS/Miller et al. - 2014 - Carbon Capture Simulation Initiative A Case Study.pdf:application/pdf},
