	pages = {NaN--NaN},
	file = {Full Text PDF:/Users/corywhitney/Zotero/storage/Z4VWMFZ7/Hodbod et al. - 2019 - Social-ecological change in the Omo-Turkana basin.pdf:application/pdf},
