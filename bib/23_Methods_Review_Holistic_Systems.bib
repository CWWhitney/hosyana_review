@article{antonelli_role_1989,
	title = {The role of technological expectations in a mixed model of international diffusion of process innovations: the case of open-end spinning rotors},
	volume = {18},
	issn = {0048-7333},
	shorttitle = {The role of technological expectations in a mixed model of international diffusion of process innovations},
	url = {https://www.sciencedirect.com/science/article/pii/0048733389900541},
	doi = {10.1016/0048-7333(89)90054-1},
	abstract = {In the years following the introduction of open-end rotors a major innovation in cotton spinning —technological change in spinning has been characterized by fast rates of introduction of incremental innovations. This has made possible considerable improvements in the quality of products as well as reductions in the cost of spinning. This case seems especially appropriate for analysing the effects of incremental innovations on the rate of diffusion. One the one hand, expectations of continuing incremental change may have actually slowed the diffusion of open-end rotors. Contrarily, increased profitability from their adoption may have reinforced the rate of diffusion. A mixed model of diffusion —one that is able to evaluate the role of supply forces, such as the introduction of incremental innovations, and at the same time the role of bounded rationality and learning by imitating —has been developed. It draws on the behavioural literature and upon the epidemic approach due to Mansfield. Results of an econometric test on international data (available for 26 countries) confirm that the rate of introduction of incremental innovations has reduced the rate of diffusion. This is especially the case in countries where the technological change in spinning was originated and consequently technological expectations were higher.},
	language = {en},
	number = {5},
	urldate = {2024-05-03},
	journal = {Research Policy},
	author = {Antonelli, Cristiano},
	month = oct,
	year = {1989},
	pages = {273--288},
}

